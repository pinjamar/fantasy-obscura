    "pipeline": "npm run discover && npm run classify",
    "classify:metadata": "node scripts/classify-metadata.mjs",
    "classify:vibes": "node scripts/classify-vibes.mjs",
    "classify:tropes": "node scripts/classify-tropes.mjs",
    "classify:creatures": "node scripts/classify-creatures.mjs",
    "classify:warnings": "node scripts/classify-content-warnings.mjs",
