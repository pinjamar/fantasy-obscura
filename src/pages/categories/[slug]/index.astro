if (!slug || !(slug in CATEGORIES)) {
  return Astro.redirect('/books/all/');
}

const cat = CATEGORIES[slug as keyof typeof CATEGORIES];
---

<Layout
  title={`${cat.name} Books | Fantasy Obscura`}
  description={`${cat.description}. The best ${cat.name} books — curated reading lists, hidden gems, and where to start.`}
>
  <!-- Breadcrumb -->
  <nav class="text-sm text-zinc-400 mb-8 flex items-center gap-2">
    <a href="/books/" class="hover:text-zinc-700 transition-colors">Start Here</a>
    <span>›</span>
    <span class="text-zinc-700 font-medium">{cat.name}</span>
  </nav>

  <!-- Hero -->
  <div class={`rounded-2xl bg-linear-to-br ${cat.gradient} border ${cat.border} px-6 py-6 mb-10`}>
    <div class="flex items-center gap-2.5 mb-2">
      <span class="text-2xl">{cat.icon}</span>
      <h1 class={`text-2xl font-bold tracking-tight ${cat.accent}`}>{cat.name}</h1>
      <a
        href="/books/all/"
        class="ml-auto text-xs text-zinc-400 hover:text-zinc-600 transition-colors whitespace-nowrap"
      >
        ← Browse all books
      </a>
    </div>
    <p class="text-zinc-600 text-sm max-w-2xl">{cat.longDesc}</p>
  </div>

  <!-- Curated lists -->
  <div class="mb-6">
    <CategoryLists
      best={cat.best}
      starter={cat.starter}
      hidden={cat.hidden}
      richBest={cat.richBooks?.best}
      richStarter={cat.richBooks?.starter}
      richHidden={cat.richBooks?.hidden}
      gradient={cat.gradient}
      border={cat.border}
      accent={cat.accent}
      client:load
    />
  </div>

  <!-- DB books for this genre -->
  <div>
    <h2 class="text-xl font-semibold mb-6">
      {cat.name} in our collection
    </h2>
    <BookDisplay genre={cat.genre} client:load />
  </div>
</Layout>
