---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="Mythology & Folklore" description="Myths, legends, and fairy-tale inspired stories">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Mythology & Folklore</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Stories inspired by ancient myths, legends, and fairy tales.
    </p>
  </div>

  <div class="mt-8">
    <BookDisplay client:load genre="Mythology" />
  </div>
</Layout>
