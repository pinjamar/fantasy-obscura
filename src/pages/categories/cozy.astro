---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="Cozy Fantasy" description="Low conflict, heartwarming vibes">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Cozy Fantasy</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Comfort reads with gentle stakes, warm communities, and uplifting tone.
    </p>
  </div>

  <div class="mt-8">
    <BookDisplay client:load genre="Cozy Fantasy" />
  </div>
</Layout>
