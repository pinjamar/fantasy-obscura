---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="Sci-Fi" description="Space operas, cyberpunk, and futuristic worlds">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Sci-Fi</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Futures, technologies, and speculative worlds that stretch the imagination.
    </p>
  </div>

  <div class="mt-8">
    <BookDisplay client:load genre="Sci-Fi" />
  </div>
</Layout>
