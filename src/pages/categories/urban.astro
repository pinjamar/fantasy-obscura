---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="Urban / Contemporary Fantasy" description="Magic hidden in the modern world">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Urban / Contemporary Fantasy</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Fantasy set in modern cities where magic exists hidden in plain sight. Our world, but with extraordinary secrets.
    </p>
  </div>

  <div class="mt-8">
    <BookDisplay client:load genre="Urban Fantasy" />
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-3 p-6 bg-gradient-to-br from-indigo-50 to-violet-50 rounded-lg">
    <div>
      <div class="font-semibold text-indigo-900">Characteristics</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Modern setting</li>
        <li>• Hidden magic</li>
        <li>• Relatable locations</li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-indigo-900">Themes</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Secret world</li>
        <li>• Integration of magic</li>
        <li>• Double life</li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-indigo-900">Best For</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Contemporary readers</li>
        <li>• Mystery elements</li>
        <li>• Faster pace</li>
      </ul>
    </div>
  </div>
</Layout>
