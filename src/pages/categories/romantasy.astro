---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="Romantasy" description="Fantasy with love stories and relationships">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Romantasy</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Fantasy worlds where romance is central to the plot. These stories blend epic adventure with emotional, intimate relationships.
    </p>
  </div>

  <div class="mt-8">
    <BookDisplay client:load genre="Romantic Fantasy" />
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-3 p-6 bg-linear-to-br from-rose-50 to-pink-50 rounded-lg">
    <div>
      <div class="font-semibold text-rose-900">Characteristics</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Central love plot</li>
        <li>• Emotional depth</li>
        <li>• Tension & chemistry</li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-rose-900">Themes</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Love vs Duty</li>
        <li>• Sacrifice</li>
        <li>• Connection & Trust</li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-rose-900">Best For</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Emotional readers</li>
        <li>• Character-driven plots</li>
        <li>• Relationship focus</li>
      </ul>
    </div>
  </div>
</Layout>
