---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="Historical Fantasy" description="Alternative history with magic">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Historical Fantasy</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Familiar history reimagined with magic, myth, and secret powers.
    </p>
  </div>

  <div class="mt-8">
    <BookDisplay client:load genre="Historical Fantasy" />
  </div>
</Layout>
