---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="YA Fantasy" description="Young adult and coming of age stories">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">YA Fantasy</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Coming-of-age fantasy stories with teenage protagonists discovering their powers and finding their place in the world.
    </p>
  </div>

  <div class="mt-8">
    <h2 class="text-2xl font-semibold mb-6">Featured Books</h2>
    <BookDisplay client:load genre="YA Fantasy" />
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-3 p-6 bg-gradient-to-br from-cyan-50 to-teal-50 rounded-lg">
    <div>
      <div class="font-semibold text-cyan-900">Characteristics</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Teen protagonists</li>
        <li>• Coming of age</li>
        <li>• Discovery & growth</li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-cyan-900">Themes</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Identity</li>
        <li>• Friendship & Belonging</li>
        <li>• First Love</li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-cyan-900">Best For</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Teen readers</li>
        <li>• Fast-paced stories</li>
        <li>• Relatable characters</li>
      </ul>
    </div>
  </div>
</Layout>
