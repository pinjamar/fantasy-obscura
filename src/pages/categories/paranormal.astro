---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="Paranormal Fantasy" description="Vampires, werewolves, witches & more">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Paranormal Fantasy</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Supernatural beings, hidden worlds, and otherworldly powers.
    </p>
  </div>

  <div class="mt-8">
    <h2 class="text-2xl font-semibold mb-6">Featured Books</h2>
    <BookDisplay client:load genre="Paranormal Fantasy" />
  </div>
</Layout>
