---
import Layout from "../../components/Layout.astro";
import BookDisplay from "../../components/BookDisplay";
---

<Layout title="Dark Fantasy" description="Fantasy blended with horror and brutality">
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Dark Fantasy</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Fantasy that embraces darker themes, moral ambiguity, and gritty realism. These worlds are dangerous and unforgiving.
    </p>
  </div>

  <div class="mt-8">
    <h2 class="text-2xl font-semibold mb-6">Featured Books</h2>
    <BookDisplay client:load genre="Dark Fantasy" />
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-3 p-6 bg-gradient-to-br from-slate-100 to-zinc-100 rounded-lg">
    <div>
      <div class="font-semibold text-slate-900">Characteristics</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Morally grey characters</li>
        <li>• Gritty violence</li>
        <li>• Dark themes</li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-slate-900">Themes</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Corruption & Power</li>
        <li>• Survival</li>
        <li>• Moral Ambiguity</li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-slate-900">Best For</div>
      <ul class="text-sm text-zinc-700 mt-2 space-y-1">
        <li>• Adult readers</li>
        <li>• Complex morality</li>
        <li>• Dark themes</li>
      </ul>
    </div>
  </div>
</Layout>
