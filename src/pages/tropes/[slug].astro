---
import Layout from '../../components/Layout.astro';
import { PUBLIC_TROPES } from '../../data/tropes';
import { supabaseClient } from '../../lib/supabaseClient';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/tropes');

const trope = PUBLIC_TROPES.find((t) => t.slug === slug);
if (!trope) return new Response(null, { status: 404, statusText: 'Not Found' });

const { data: books } = await supabaseClient
  .from('books')
  .select('id, title, slug, authors, cover_url, synopsis, avg_rating, subgenres, darkness_level, series, series_number')
  .contains('tropes', [trope.name])
  .order('avg_rating', { ascending: false, nullsFirst: false })
  .limit(500);

const CATEGORY_EMOJI: Record<string, string> = {
  character: '🧙',
  relationship: '🤝',
  plot: '⚔️',
  'world-magic': '✨',
};

const emoji = CATEGORY_EMOJI[trope.category] ?? '📖';

// Related tropes: same category first, then other categories, exclude self, take 4
const related = [
  ...PUBLIC_TROPES.filter((t) => t.slug !== slug && t.category === trope.category),
  ...PUBLIC_TROPES.filter((t) => t.slug !== slug && t.category !== trope.category),
].slice(0, 4);

// Varied emojis for related trope cards (one per slot, always distinct)
const SLOT_EMOJIS = ['🗡️', '🌙', '🔮', '🐉'];

// Generate trope-specific FAQ
// Darkness range — data-driven from actual books for this trope
// Count books per darkness level, pick top 3 most common levels
const darknessCounts = new Map<number, number>();
for (const b of books ?? []) {
  if (b.darkness_level != null && b.darkness_level >= 1 && b.darkness_level <= 5) {
    darknessCounts.set(b.darkness_level, (darknessCounts.get(b.darkness_level) ?? 0) + 1);
  }
}
const DARKNESS_LABELS_FULL = ['', 'Lighthearted', 'Mild', 'Serious', 'Dark', 'Brutal'];
type DarknessEntry = { candles: number; label: string; count: number };
const darknessRange: DarknessEntry[] = [...darknessCounts.entries()]
  .sort((a, b) => b[1] - a[1])   // sort by count desc (most common first)
  .slice(0, 3)                    // top 3 levels
  .map(([level, count]) => ({
    candles: level,
    label: DARKNESS_LABELS_FULL[level],
    count,
  }));

// ── Top authors (by book count for this trope) ───────────────────────────────
const authorCountMap = new Map<string, number>();
for (const b of books ?? []) {
  for (const a of (b.authors ?? [])) {
    authorCountMap.set(a, (authorCountMap.get(a) ?? 0) + 1);
  }
}
const topAuthors = [...authorCountMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([name, count]) => ({ name, count, slug: name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') }));

// ── Subgenre distribution ────────────────────────────────────────────────────
const subgenreCountMap = new Map<string, number>();
for (const b of books ?? []) {
  for (const s of (b.subgenres ?? [])) {
    subgenreCountMap.set(s, (subgenreCountMap.get(s) ?? 0) + 1);
  }
}
const topSubgenres = [...subgenreCountMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);

// ── FAQ data (for schema + visible section) ──────────────────────────────────
const top3Books = (books ?? []).slice(0, 3).map(b => b.title).join(', ');
const topSubgenreNames = topSubgenres.slice(0, 3).map(([s]) => s).join(', ');
const faqItems = [
  {
    q: `What is the ${trope.name} trope in fantasy?`,
    a: trope.intro ?? trope.description,
  },
  {
    q: `How many fantasy books feature the ${trope.name} trope?`,
    a: `Our catalogue currently includes ${(books ?? []).length} fantasy books featuring the ${trope.name} trope${topSubgenreNames ? `, spanning subgenres like ${topSubgenreNames}` : ''}. The list is sorted by reader rating.`,
  },
  ...(top3Books ? [{
    q: `What are the best ${trope.name} fantasy books?`,
    a: `Some of the highest-rated ${trope.name} fantasy books include ${top3Books}. You can filter the full list by subgenre or search by title and author above.`,
  }] : []),
  ...(topSubgenreNames ? [{
    q: `What subgenres feature the ${trope.name} trope most?`,
    a: `The ${trope.name} trope appears most frequently in ${topSubgenreNames}${topAuthors.length > 0 ? `. Authors like ${topAuthors.slice(0, 3).map(a => a.name).join(', ')} are particularly associated with this trope` : ''}.`,
  }] : []),
];

// JSON-LD structured data for SEO (ItemList)
const topBooks = (books ?? []).slice(0, 10);
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Best ${trope.name} Fantasy Books`,
  description: trope.description,
  numberOfItems: topBooks.length,
  itemListElement: topBooks.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Book',
      name: b.title,
      author: (b.authors ?? []).map((a: string) => ({ '@type': 'Person', name: a })),
      url: `https://thegrimoire.co/books/${b.slug}/`,
    },
  })),
});

const booksJson = JSON.stringify(
  (books ?? []).map((b) => ({
    title: b.title,
    slug: b.slug,
    authors: b.authors,
    cover_url: b.cover_url,
    synopsis: b.synopsis,
    avg_rating: b.avg_rating,
    darkness_level: b.darkness_level,
    subgenres: b.subgenres,
    series: b.series,
    series_number: b.series_number,
  }))
);
const tropeFaqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
});
const tropeBreadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Tropes', item: 'https://thegrimoire.co/tropes/' },
    { '@type': 'ListItem', position: 2, name: trope.name, item: `https://thegrimoire.co/tropes/${slug}/` },
  ],
});
---

<Layout
  title={`Best ${trope.name} Fantasy Books — The Grimoire`}
  description={`${books?.length ? `${books.length} fantasy books featuring the ${trope.name} trope. ` : ''}${trope.description}`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline type="application/ld+json" set:html={tropeFaqJsonLd} />
    <script is:inline type="application/ld+json" set:html={tropeBreadcrumbJsonLd} />
  </Fragment>
  <div class="max-w-2xl mx-auto">

    <!-- Breadcrumb -->
    <nav class="text-sm text-zinc-400 mb-6">
      <a href="/tropes/" class="hover:text-zinc-700">Tropes</a>
      <span class="mx-2">›</span>
      <span class="text-zinc-700">{trope.name}</span>
    </nav>

    <h1 class="text-3xl font-bold mb-1">Best {trope.name} Fantasy Books</h1>
    <p class="text-purple-600 font-medium text-sm mb-4">{emoji} {trope.name} — Fantasy Trope Guide</p>

    <!-- Hidden SEO paragraph -->
    <p class="hidden">
      Looking for the best {trope.name} fantasy books? This list covers every fantasy novel featuring the {trope.name} trope in our catalogue, sorted by reader rating. Whether you prefer epic fantasy, grimdark, romantasy, or YA, you'll find {trope.name} books across every subgenre here.
    </p>

    <!-- Intro -->
    <section class="prose prose-zinc max-w-none mb-10">
      {trope.intro ? (
        <p>{trope.intro}</p>
      ) : (
        <>
          <p>{trope.description}</p>
          <p>
            This trope appears across many sub-genres of fantasy — from epic multi-volume series to
            tightly-paced standalone novels. Whether you prefer dark and gritty reads or lighter,
            character-driven stories, books featuring {trope.name} deliver a distinctive reading experience.
          </p>
        </>
      )}
    </section>

    <!-- Book list -->
    <section class="mb-12">
      <div class="flex items-center justify-between gap-4 mb-3 flex-wrap">
        <h2 class="text-xl font-bold">Best {trope.name} Books</h2>
        <div class="flex items-center gap-3 ml-auto">
          {books && books.length > 0 && (
            <span id="book-count" class="text-sm text-zinc-400 shrink-0">
              {books.length} {books.length === 1 ? 'book' : 'books'}
            </span>
          )}
          {books && books.length > 0 && (
            <select
              id="genre-filter"
              class="rounded-xl border border-zinc-300 bg-white px-3 py-1 text-xs shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200 transition text-zinc-600 shrink-0"
            >
              <option value="">All subgenres</option>
            </select>
          )}
        </div>
      </div>

      {books && books.length > 0 ? (
        <>
          <!-- Search + darkness filter -->
          <div class="flex items-center gap-3 mb-5">
            <div class="relative flex-1">
              <input
                id="trope-search"
                type="text"
                placeholder="Search by title or author…"
                autocomplete="off"
                class="w-full rounded-xl border border-zinc-300 bg-white px-4 py-2.5 pl-9 text-sm shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200 transition"
              />
              <svg class="absolute left-3 top-3 h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
              </svg>
            </div>
            <div id="darkness-btns" class="flex items-center gap-1 shrink-0"></div>
          </div>

          <!-- Rendered book list (SSR, hidden via JS after mount) -->
          <div id="book-list" class="flex flex-col gap-3"></div>

          <!-- Pagination -->
          <div id="pagination" class="mt-6 flex items-center justify-between gap-3" style="display:none">
            <button id="prev-btn" class="px-4 py-2 rounded-lg border border-zinc-300 text-sm font-medium text-zinc-600 hover:border-purple-400 hover:text-purple-700 disabled:opacity-30 disabled:cursor-not-allowed transition-colors">
              ← Prev
            </button>
            <span id="page-info" class="text-sm text-zinc-500"></span>
            <button id="next-btn" class="px-4 py-2 rounded-lg border border-zinc-300 text-sm font-medium text-zinc-600 hover:border-purple-400 hover:text-purple-700 disabled:opacity-30 disabled:cursor-not-allowed transition-colors">
              Next →
            </button>
          </div>

          <p id="no-results" class="hidden text-sm text-zinc-500 mt-4">No books match your search.</p>
        </>
      ) : (
        <p class="text-zinc-500 text-sm">No books catalogued yet for this trope.</p>
      )}
    </section>

    <!-- Darkness / Intensity Range -->
    {darknessRange.length > 0 && (
      <section class="mb-10">
        <h2 class="text-lg font-semibold mb-1 text-zinc-800">Darkness / Intensity Range</h2>
        <p class="text-xs text-zinc-400 mb-4">Based on {(books ?? []).filter(b => b.darkness_level != null).length} classified books in this trope</p>
        <div class="grid gap-3 sm:grid-cols-3">
          {darknessRange.map((d) => (
            <div class="rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-4">
              <p class="text-base leading-none">{'🕯️'.repeat(d.candles)}</p>
              <p class="text-sm font-semibold text-zinc-800 mt-2">{d.label}</p>
              <p class="text-xs text-zinc-400 mt-1">{d.count} {d.count === 1 ? 'book' : 'books'}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related tropes -->
    {related.length > 0 && (
      <section class="mb-10">
        <h2 class="text-lg font-semibold mb-3 text-zinc-800">Related Tropes</h2>
        <div class="grid grid-cols-2 gap-3">
          {related.map((t, i) => (
            <a
              href={`/tropes/${t.slug}/`}
              class="flex items-start gap-2.5 rounded-xl border border-zinc-200 px-4 py-3 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group"
            >
              <span class="text-lg leading-none mt-0.5">{SLOT_EMOJIS[i]}</span>
              <div class="min-w-0">
                <p class="text-sm font-medium text-zinc-800 group-hover:text-purple-700 transition-colors leading-snug">{t.name}</p>
                <p class="text-xs text-zinc-400 mt-0.5 line-clamp-1">{t.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Subgenre distribution -->
    {topSubgenres.length > 0 && (
      <section class="mb-10">
        <h2 class="text-lg font-semibold mb-3 text-zinc-800">Where This Trope Appears Most</h2>
        <div class="flex flex-wrap gap-2">
          {topSubgenres.map(([name, count]) => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-purple-50 border border-purple-200 text-sm text-purple-800">
              {name}
              <span class="text-purple-400 text-xs">{count}</span>
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Top authors -->
    {topAuthors.length > 0 && (
      <section class="mb-10">
        <h2 class="text-lg font-semibold mb-3 text-zinc-800">Top Authors for {trope.name}</h2>
        <div class="flex flex-wrap gap-2">
          {topAuthors.map(({ name, count, slug: aSlug }) => (
            <a
              href={`/authors/${aSlug}/`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-zinc-50 border border-zinc-200 text-sm text-zinc-700 hover:border-purple-300 hover:bg-purple-50/50 hover:text-purple-800 transition-colors"
            >
              {name}
              <span class="text-zinc-400 text-xs">{count} {count === 1 ? 'book' : 'books'}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back to tropes -->
    <div class="border-t border-zinc-100 pt-6">
      <a href="/tropes/" class="text-sm text-purple-600 hover:text-purple-800 transition-colors">
        ← Browse all fantasy tropes
      </a>
    </div>

  </div>
</Layout>

<script is:inline define:vars={{ booksJson }}>
  const DARKNESS_LABEL = ['', 'Lighthearted', 'Mild', 'Serious', 'Dark', 'Brutal'];
  const PAGE_SIZE = 15;

  const allBooks = JSON.parse(booksJson);
  let filtered = allBooks;
  let currentPage = 0;

  const listEl      = document.getElementById('book-list');
  const pagEl       = document.getElementById('pagination');
  const prevBtn     = document.getElementById('prev-btn');
  const nextBtn     = document.getElementById('next-btn');
  const pageInfo    = document.getElementById('page-info');
  const noResults   = document.getElementById('no-results');
  const countEl     = document.getElementById('book-count');
  const searchEl    = document.getElementById('trope-search');
  const genreEl     = document.getElementById('genre-filter');
  const darknessBtns = document.getElementById('darkness-btns');

  let selectedDarkness = null;
  let darknessHover = null;


  function updateCandles() {
    const active = darknessHover ?? selectedDarkness ?? 0;
    darknessBtns.querySelectorAll('.candle-btn').forEach((btn, i) => {
      btn.style.opacity = (i + 1) <= active ? '1' : '0.2';
    });
    const clearBtn = document.getElementById('darkness-clear');
    if (clearBtn) clearBtn.style.display = selectedDarkness !== null ? 'flex' : 'none';
  }

  for (let level = 1; level <= 5; level++) {
    const btn = document.createElement('button');
    btn.textContent = '🕯️';
    btn.title = DARKNESS_LABEL[level];
    btn.className = 'text-base transition-opacity leading-none candle-btn';
    btn.style.opacity = '0.2';
    btn.addEventListener('mouseenter', () => { darknessHover = level; updateCandles(); });
    btn.addEventListener('mouseleave', () => { darknessHover = null; updateCandles(); });
    btn.addEventListener('click', () => {
      selectedDarkness = selectedDarkness === level ? null : level;
      applyFilters();
      updateCandles();
    });
    darknessBtns.appendChild(btn);
  }

  const darknessClr = document.createElement('button');
  darknessClr.id = 'darkness-clear';
  darknessClr.className = 'w-6 h-6 items-center justify-center text-xs text-zinc-400 hover:text-zinc-600 ml-1';
  darknessClr.style.display = 'none';
  darknessClr.textContent = '✕';
  darknessClr.addEventListener('click', () => { selectedDarkness = null; applyFilters(); updateCandles(); });
  darknessBtns.appendChild(darknessClr);

  const GENRE_OPTIONS = [
    { value: 'epic',            label: '⚔️ Epic & High Fantasy',  subgenres: ['Epic Fantasy', 'High Fantasy'] },
    { value: 'romantasy',       label: '🌹 Romantasy',             subgenres: ['Romantic Fantasy'] },
    { value: 'swords',          label: '🗡️ Sword & Sorcery',      subgenres: ['Sword & Sorcery'] },
    { value: 'dark',            label: '🌑 Dark Fantasy',          subgenres: ['Dark Fantasy', 'Horror Fantasy'] },
    { value: 'urban',           label: '🌆 Urban / Contemporary',  subgenres: ['Urban Fantasy', 'Contemporary Fantasy'] },
    { value: 'grimdark',        label: '💀 Grimdark',              subgenres: ['Grimdark', 'War Fantasy'] },
    { value: 'historical',      label: '📜 Historical Fantasy',    subgenres: ['Historical Fantasy'] },
    { value: 'academy',         label: '🎓 Academy Fantasy',       subgenres: ['Academy Fantasy'] },
    { value: 'mythology',       label: '🏺 Mythic / Folklore',     subgenres: ['Mythic Fantasy', 'Folklore Fantasy'] },
    { value: 'cozy',            label: '☕ Cozy Fantasy',          subgenres: ['Cozy Fantasy', 'Humorous Fantasy'] },
    { value: 'litrpg',          label: '🎮 LitRPG / Progression',  subgenres: ['LitRPG', 'Progression Fantasy'] },
    { value: 'science-fantasy', label: '🔭 Science Fantasy',       subgenres: ['Science Fantasy', 'Steampunk Fantasy'] },
  ];

  // Only show genres that have at least one matching book
  const bookSubgenres = new Set(allBooks.flatMap((b) => b.subgenres ?? []));
  GENRE_OPTIONS.forEach(({ value, label, subgenres }) => {
    if (!subgenres.some((s) => bookSubgenres.has(s))) return;
    const opt = document.createElement('option');
    opt.value = value;
    opt.textContent = label;
    genreEl.appendChild(opt);
  });
  if (genreEl.options.length <= 1) genreEl.style.display = 'none';

  function renderStars(r) {
    const pct = ((r / 5) * 100).toFixed(2) + '%';
    return `<span style="position:relative;display:inline-block;letter-spacing:0.05em;line-height:1;vertical-align:middle"><span style="color:#d4d4d8">★★★★★</span><span style="position:absolute;top:0;left:0;overflow:hidden;width:${pct};color:#f59e0b;white-space:nowrap">★★★★★</span></span>`;
  }

  function renderBook(b) {
    const darkness = b.darkness_level >= 1
      ? `<span class="text-xs text-zinc-400"> · ${'🕯️'.repeat(b.darkness_level)} ${DARKNESS_LABEL[b.darkness_level]}</span>`
      : '';
    const rating = b.avg_rating
      ? `<span class="text-xs text-zinc-600 inline-flex items-center gap-1">${renderStars(b.avg_rating)} ${b.avg_rating.toFixed(2)}</span>`
      : '';
    const synopsis = b.synopsis
      ? `<p class="text-xs text-zinc-500 leading-relaxed line-clamp-2 mt-1">${b.synopsis}</p>`
      : '';
    const cover = b.cover_url
      ? `<img src="${b.cover_url}" alt="${b.title}" class="h-28 w-20 object-cover rounded-md shrink-0 shadow-sm" loading="lazy" />`
      : `<img src="/grimplaceholder.png" alt="${b.title}" class="h-28 w-20 object-cover rounded-md shrink-0 shadow-sm" loading="lazy" />`;
    const series = b.series
      ? `<div class="text-xs text-indigo-500 mb-0.5">${b.series}${b.series_number != null ? ` #${b.series_number}` : ''}</div>`
      : '';
    const authors = b.authors?.length
      ? `<div class="text-xs text-zinc-500 mb-1">${b.authors.join(', ')}</div>`
      : '';

    return `<a href="/books/${b.slug}/" class="flex items-center gap-4 px-4 py-4 rounded-xl border border-zinc-200 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group">
      ${cover}
      <div class="min-w-0">
        <div class="font-semibold text-zinc-800 group-hover:text-purple-700 transition-colors leading-tight mb-0.5">${b.title}</div>
        ${series}${authors}
        <div class="flex flex-wrap items-center gap-1">${rating}${darkness}</div>
        ${synopsis}
      </div>
    </a>`;
  }

  function render() {
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    const start = currentPage * PAGE_SIZE;
    const page = filtered.slice(start, start + PAGE_SIZE);

    listEl.innerHTML = page.map(renderBook).join('');

    noResults.classList.toggle('hidden', filtered.length > 0);

    if (filtered.length > PAGE_SIZE) {
      pagEl.style.display = 'flex';
      pageInfo.textContent = `Page ${currentPage + 1} of ${totalPages}`;
      prevBtn.disabled = currentPage === 0;
      nextBtn.disabled = currentPage >= totalPages - 1;
    } else {
      pagEl.style.display = 'none';
    }

    if (countEl) {
      countEl.textContent = `${filtered.length} ${filtered.length === 1 ? 'book' : 'books'}`;
    }
  }

  function applyFilters() {
    const q = searchEl.value.toLowerCase().trim();
    const genreVal = genreEl.value;
    const genreSubgenres = genreVal
      ? (GENRE_OPTIONS.find((g) => g.value === genreVal)?.subgenres ?? [])
      : [];
    filtered = allBooks.filter((b) => {
      const matchQ = !q || b.title.toLowerCase().includes(q) ||
        (b.authors ?? []).some((a) => a.toLowerCase().includes(q)) ||
        (b.series ?? '').toLowerCase().includes(q);
      const matchGenre = !genreVal || (b.subgenres ?? []).some((s) => genreSubgenres.includes(s));
      const matchDarkness = selectedDarkness === null || b.darkness_level === selectedDarkness;
      return matchQ && matchGenre && matchDarkness;
    });
    currentPage = 0;
    render();
  }

  searchEl.addEventListener('input', applyFilters);
  genreEl.addEventListener('change', applyFilters);

  prevBtn.addEventListener('click', () => { if (currentPage > 0) { currentPage--; render(); window.scrollTo({ top: listEl.offsetTop - 80, behavior: 'smooth' }); } });
  nextBtn.addEventListener('click', () => { if (currentPage < Math.ceil(filtered.length / PAGE_SIZE) - 1) { currentPage++; render(); window.scrollTo({ top: listEl.offsetTop - 80, behavior: 'smooth' }); } });

  render();
</script>
