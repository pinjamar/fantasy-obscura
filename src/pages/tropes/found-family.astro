---
import Layout from '../../components/Layout.astro';

const BOOKS = [
  {
    title: 'Mistborn: The Final Empire',
    slug: 'mistborn-the-final-empire',
    desc: 'A criminal crew united by rebellion gradually forms deep bonds built on trust and sacrifice — one of the most emotionally satisfying ensemble casts in epic fantasy.',
  },
  {
    title: 'The Lies of Locke Lamora',
    slug: 'the-lies-of-locke-lamora',
    desc: "A band of thieves whose loyalty feels more powerful than blood ties. The Gentleman Bastards don't just pull cons together — they'd die for each other without hesitation.",
  },
  {
    title: 'Six of Crows',
    slug: 'six-of-crows',
    desc: 'Six outcasts hired for an impossible heist discover that trust and loyalty bind them far tighter than any contract. Possibly the genre\'s purest found family in a single duology.',
  },
  {
    title: 'The Way of Kings',
    slug: 'the-way-of-kings',
    desc: 'Across three intertwined storylines, warriors, scholars, and slaves find in each other something deeper than survival — a sense of purpose that becomes the spine of an epic series.',
  },
  {
    title: 'Kings of the Wyld',
    slug: 'kings-of-the-wyld',
    desc: 'Retired adventurers reassemble for one last mission and rediscover what made them a family in the first place. Funny, heartfelt, and surprisingly moving.',
  },
  {
    title: 'Legends & Lattes',
    slug: 'legends-and-lattes',
    desc: 'A retired orc warrior hangs up her sword, opens a coffee shop, and builds the warmest, most unlikely community in fantasy — a quiet masterclass in chosen belonging.',
  },
];

const RELATED = [
  { slug: 'ensemble-cast',      label: 'Ensemble Cast',  emoji: '🎭' },
  { slug: 'heist',              label: 'Heist',          emoji: '🃏' },
  { slug: 'mentor-and-student', label: 'Mentor & Student', emoji: '📜' },
  { slug: 'academy',            label: 'Academy',        emoji: '🏫' },
  { slug: 'rebellion',          label: 'Rebellion',      emoji: '⚔️' },
];
---

<Layout
  title="Found Family Fantasy Books — Fantasy Obscura"
  description="The best fantasy books featuring the found family trope — chosen bonds, loyal crews, and characters who become each other's family."
>
  <div class="max-w-2xl mx-auto">

    <!-- Breadcrumb -->
    <nav class="text-sm text-zinc-400 mb-6">
      <a href="/tropes/" class="hover:text-zinc-700">Tropes</a>
      <span class="mx-2">›</span>
      <span class="text-zinc-700">Found Family</span>
    </nav>

    <h1 class="text-3xl font-bold mb-1">Found Family in Fantasy Books</h1>
    <p class="text-purple-600 font-medium text-sm mb-8">🫂 Trope Guide</p>

    <!-- Intro -->
    <section class="prose prose-zinc max-w-none mb-10">
      <p>
        Found Family is one of the most beloved tropes in fantasy. Instead of relying on blood ties,
        characters form deep emotional bonds with friends, comrades, or unlikely allies who become
        their chosen family. These stories often highlight loyalty, healing, sacrifice, and the
        power of belonging.
      </p>
      <p>
        In fantasy, found family frequently develops within adventuring parties, criminal crews,
        magical academies, or war-torn worlds where survival depends on trust. The trope resonates
        strongly with readers because it emphasises emotional connection over destiny, and
        relationships over prophecy.
      </p>
      <p>
        If you're looking for fantasy books where friendships feel as important as battles, and
        where characters protect each other like siblings despite having no shared past, this trope
        delivers exactly that experience.
      </p>
      <p>
        Many readers specifically search for found family fantasy books because the trope offers
        emotional payoff that goes beyond plot twists or large-scale battles. Whether set in
        sprawling secondary worlds or tight-knit urban settings, stories built around chosen bonds
        often feel deeply personal and character-driven.
      </p>
    </section>

    <!-- Why readers love it -->
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-4">Why Readers Love Found Family</h2>
      <ul class="space-y-2 text-zinc-700">
        {[
          'Deep emotional bonds between characters',
          'Group dynamics and team growth',
          'Loyalty tested under pressure',
          'Healing from trauma through connection',
          'Strong character-driven storytelling',
        ].map((item) => (
          <li class="flex gap-2 items-start">
            <span class="text-purple-500 mt-0.5">▸</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="text-sm text-zinc-500 mt-4">
        This trope works especially well in epic fantasy, urban fantasy, and heist-driven narratives.
      </p>
    </section>

    <!-- Common variations -->
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-4">Common Variations</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {[
          'Adventuring party becomes family',
          'Criminal crew bonds over shared mission',
          'Academy classmates grow into lifelong allies',
          'War companions turned siblings',
          'Mentor figure as parental substitute',
        ].map((v) => (
          <div class="text-sm bg-zinc-50 border border-zinc-200 rounded-lg px-3 py-2 text-zinc-700">{v}</div>
        ))}
      </div>
    </section>

    <!-- Best books -->
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-2">Best Found Family Fantasy Books</h2>
      <p class="text-sm text-zinc-500 mb-5">Hand-picked for the strength of their ensemble bonds — not just the presence of a group.</p>
      <div class="flex flex-col gap-4">
        {BOOKS.map((b) => (
          <a
            href={`/books/${b.slug}/`}
            class="block px-4 py-4 rounded-xl border border-zinc-200 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group"
          >
            <div class="flex items-center gap-2 mb-1">
              <span class="text-purple-400 group-hover:text-purple-600 transition-colors">📖</span>
              <span class="font-semibold text-zinc-800 group-hover:text-purple-700 transition-colors">{b.title}</span>
            </div>
            <p class="text-sm text-zinc-500 leading-relaxed pl-6">{b.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Tone range -->
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-4">Tone & Intensity Range</h2>
      <div class="space-y-2">
        {[
          { candle: '🕯️', label: 'Lighthearted', desc: 'Cosy group dynamics, warm bonds' },
          { candle: '🕯️🕯️🕯️', label: 'Serious', desc: 'Emotionally heavy but hopeful' },
          { candle: '🕯️🕯️🕯️🕯️', label: 'Dark', desc: 'Loyalty tested under brutal conditions' },
        ].map((r) => (
          <div class="flex items-center gap-4 px-4 py-3 rounded-xl bg-zinc-50 border border-zinc-200">
            <span class="text-sm shrink-0">{r.candle}</span>
            <span class="font-medium text-sm text-zinc-800 w-28 shrink-0">{r.label}</span>
            <span class="text-sm text-zinc-500">{r.desc}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-5">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {[
          {
            q: 'What is found family in fantasy?',
            a: 'Found family is a trope where unrelated characters form deep emotional bonds that function like familial relationships — built on loyalty, shared struggle, and chosen commitment rather than blood.',
          },
          {
            q: 'Is found family common in epic fantasy?',
            a: 'Yes. It appears frequently in epic fantasy, heist stories, and academy settings where characters must rely on each other for survival. The longer the series, the deeper the bonds tend to run.',
          },
          {
            q: 'Are found family books usually dark?',
            a: 'Not necessarily. The trope appears across all tones — from lighthearted cozy fantasy to brutal grimdark. What defines it is the emotional weight placed on group bonds, not the darkness level.',
          },
          {
            q: 'What makes found family different from just having a group of characters?',
            a: "The difference is intentionality — found family stories frame the relationships themselves as the emotional core. The group's bond is the point, not just a vehicle for plot.",
          },
        ].map(({ q, a }) => (
          <div class="border border-zinc-200 rounded-xl px-5 py-4">
            <p class="font-semibold text-zinc-800 mb-1">{q}</p>
            <p class="text-sm text-zinc-600 leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related tropes -->
    <section class="mb-6">
      <h2 class="text-xl font-bold mb-4">Related Tropes</h2>
      <div class="flex flex-wrap gap-2">
        {RELATED.map((r) => (
          <a
            href={`/tropes/${r.slug}/`}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-zinc-200 text-sm text-zinc-700 hover:border-purple-300 hover:bg-purple-50 transition-colors"
          >
            <span>{r.emoji}</span>
            <span>{r.label}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Explore more -->
    <section class="mb-6 border-t border-zinc-100 pt-8">
      <p class="text-sm font-semibold text-zinc-500 uppercase tracking-wide mb-3">You might also enjoy</p>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        {[
          { slug: 'assassin-protagonist', label: 'Assassin Protagonist', emoji: '🗡️' },
          { slug: 'rebellion',            label: 'Rebellion Fantasy',    emoji: '⚔️' },
          { slug: 'academy',              label: 'Academy Fantasy',      emoji: '🏫' },
          { slug: 'heist',               label: 'Heist Fantasy',         emoji: '🃏' },
        ].map((r) => (
          <a
            href={`/tropes/${r.slug}/`}
            class="flex flex-col items-center gap-1 px-3 py-3 rounded-xl border border-zinc-200 text-center text-sm text-zinc-700 hover:border-purple-300 hover:bg-purple-50 transition-colors"
          >
            <span class="text-xl">{r.emoji}</span>
            <span class="font-medium leading-tight">{r.label}</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>
