---
import Layout from '../../components/Layout.astro';
import { TROPES_BY_CATEGORY } from '../../data/tropes';

const CATEGORY_META = {
  character:    { label: 'Character Tropes',    emoji: '🧙', desc: 'Who the protagonist is and what defines them.' },
  relationship: { label: 'Relationship Tropes', emoji: '🤝', desc: 'How characters connect, clash, and grow together.' },
  plot:         { label: 'Plot Tropes',         emoji: '⚔️',  desc: 'The narrative engines that drive the story forward.' },
  'world-magic':{ label: 'World & Magic Tropes',emoji: '✨', desc: 'The worlds, locations, and magic systems that define the story\'s rules and atmosphere.' },
} as const;

---

<Layout
  title="Fantasy Tropes — The Grimoire"
  description="Browse fantasy tropes by category — character, relationship, plot, and world &amp; magic. Find books by the story structures you love most."
>
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-2">Fantasy Tropes</h1>
    <p class="text-zinc-500 mb-6 text-base">
      Browse books by the narrative patterns and character dynamics that define your favourite reads.
    </p>

    <div class="prose prose-zinc max-w-none mb-10 text-sm leading-relaxed">
      <p>
        Tropes aren't clichés — they're the structural grammar of storytelling. A <strong>Chosen One</strong>
        narrative isn't tired because of the premise; it's tired when the author doesn't interrogate it.
        The same pattern that produced forgettable YA also produced <em>The Stormlight Archive</em> and
        <em>The Name of the Wind</em>. What matters is what the author does with the material.
      </p>
      <p>
        This index covers 70 canonical fantasy tropes across four categories: character archetypes, relationship
        dynamics, plot structures, and world &amp; magic systems. Each trope page lists every book in our
        database that uses it, rated and searchable — so you can find the best version of the story you're
        in the mood for.
      </p>
    </div>

    <!-- Search bar -->
    <div class="relative max-w-lg mb-10">
      <input
        id="trope-search"
        type="text"
        placeholder="Search tropes…"
        class="w-full rounded-xl border border-zinc-300 bg-white px-4 py-3 pl-10 text-sm shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200 transition"
        autocomplete="off"
      />
      <svg class="absolute left-3 top-3.5 h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
      </svg>
    </div>

    <p id="trope-no-results" class="hidden text-center text-zinc-500 mb-10">No tropes found for that search.</p>

    {(Object.entries(TROPES_BY_CATEGORY) as [keyof typeof CATEGORY_META, typeof TROPES_BY_CATEGORY[keyof typeof TROPES_BY_CATEGORY]][]).map(([cat, tropes]) => {
      const meta = CATEGORY_META[cat];
      return (
        <section class="mb-12 trope-section" data-category={meta.label.toLowerCase()}>
          <div class="flex items-center gap-3 mb-1">
            <span class="text-2xl">{meta.emoji}</span>
            <h2 class="text-xl font-bold text-zinc-900">{meta.label}</h2>
          </div>
          <p class="text-sm text-zinc-500 mb-5 ml-10">{meta.desc}</p>

          <div class="grid gap-2 sm:grid-cols-2">
            {tropes.map((t) => (
              <a
                href={`/tropes/${t.slug}/`}
                data-search={`${t.name.toLowerCase()} ${t.description.toLowerCase()}`}
                class="trope-card group flex gap-3 items-start px-4 py-3 rounded-xl border border-zinc-200 hover:border-purple-300 hover:bg-purple-50/40 transition-colors"
              >
                <div class="min-w-0">
                  <div class="font-medium text-zinc-900 group-hover:text-purple-700 transition-colors text-sm">{t.name}</div>
                  <div class="text-xs text-zinc-400 mt-0.5 truncate">{t.description}</div>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<script>
  const input = document.getElementById('trope-search') as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>('.trope-card');
  const sections = document.querySelectorAll<HTMLElement>('.trope-section');
  const noResults = document.getElementById('trope-no-results')!;

  input.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    let totalVisible = 0;

    sections.forEach((section) => {
      const sectionCards = section.querySelectorAll<HTMLElement>('.trope-card');
      let visibleInSection = 0;

      sectionCards.forEach((card) => {
        const matches = !q || (card.dataset.search ?? '').includes(q);
        card.classList.toggle('hidden', !matches);
        if (matches) visibleInSection++;
      });

      section.classList.toggle('hidden', visibleInSection === 0);
      totalVisible += visibleInSection;
    });

    noResults.classList.toggle('hidden', totalVisible > 0 || !q);
  });
</script>
