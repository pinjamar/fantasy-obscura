---
import Layout from '../../../components/Layout.astro';
import { CATEGORIES_META } from '../../../data/categories-meta';
import { supabaseClient } from '../../../lib/supabaseClient';
import { dedupeBooks } from '../../../lib/category-dedup';
import { renderEditorial } from '../../../lib/render-editorial';
import { normalizeCoverUrl } from '../../../lib/covers';

const { slug } = Astro.params;
if (!slug || !(slug in CATEGORIES_META)) return Astro.redirect('/books/');

const cat = CATEGORIES_META[slug as keyof typeof CATEGORIES_META];
const curatedTitles = cat.lists.allTimeGreats;

const { data: allMatches } = await (supabaseClient as any)
  .from('books')
  .select('id, title, slug, authors, cover_url, avg_rating, darkness_level, heat_level, series, series_number, synopsis, best_for')
  .in('title', curatedTitles);

const titleIndex = new Map(curatedTitles.map((t: string, i: number) => [t, i]));
const sorted: any[] = ((allMatches as any[]) ?? [])
  .sort((a: any, b: any) => {
    const diff = (titleIndex.get(a.title) ?? 999) - (titleIndex.get(b.title) ?? 999);
    if (diff !== 0) return diff;
    return (a.series_number ?? 999) - (b.series_number ?? 999);
  });

// allTimeGreats has no higher-priority list to exclude — just dedupe within
const books: any[] = dedupeBooks(sorted, new Set(), 20);

const editorial = cat.editorial?.allTimeGreats;

const DARKNESS_LABELS = ['', 'Lighthearted', 'Mild', 'Serious', 'Dark', 'Brutal'];
const HEAT: Record<string, { flames: string; label: string }> = {
  'Sweet Romance': { flames: '🔥',         label: 'Sweet Romance' },
  'Closed Door':   { flames: '🔥🔥',       label: 'Closed Door' },
  'Open Door':     { flames: '🔥🔥🔥',     label: 'Open Door' },
  'Explicit':      { flames: '🔥🔥🔥🔥',   label: 'Explicit' },
  'Fiery':         { flames: '🔥🔥🔥🔥🔥', label: 'Fiery' },
};
const typedBooks = books as any[];

function starPct(r: number) { return ((r / 5) * 100).toFixed(2) + '%'; }

const SITE = 'https://thegrimoire.co';
const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Books', item: `${SITE}/books/` },
    { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE}/fantasy/${slug}/` },
    { '@type': 'ListItem', position: 3, name: 'All-Time Greats', item: `${SITE}/fantasy/${slug}/all-time-greats/` },
  ],
});
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${cat.name} All-Time Greats`,
  description: editorial?.intro ?? `The 20 greatest ${cat.name} books of all time — essential reads that defined the genre.`,
  numberOfItems: books.length,
  itemListElement: books.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Book',
      name: b.title,
      author: (b.authors ?? []).map((a: string) => ({ '@type': 'Person', name: a })),
      url: `${SITE}/books/${b.slug}/`,
    },
  })),
});
---

<Layout
  title={`${cat.name} All-Time Greats — Top 20 Books | The Grimoire`}
  description={editorial?.intro ?? `The 20 greatest ${cat.name} books of all time — essential reads that defined the genre.`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <div class="max-w-2xl mx-auto">
    <nav class="text-sm text-zinc-400 mb-6 flex items-center gap-2">
      <a href="/books/" class="hover:text-zinc-700 transition-colors">Start Here</a>
      <span>›</span>
      <a href={`/fantasy/${slug}/`} class="hover:text-zinc-700 transition-colors">{cat.name}</a>
      <span>›</span>
      <span class="text-zinc-700 font-medium">All-Time Greats</span>
    </nav>

    <div class="flex items-center gap-2.5 mb-3">
      <span class="text-2xl">{cat.icon}</span>
      <h1 class="text-2xl font-bold tracking-tight">{cat.name} All-Time Greats</h1>
    </div>

    {editorial ? (
      <div class="mb-6 space-y-3">
        <p class="text-zinc-600 text-sm leading-relaxed" set:html={renderEditorial(editorial.intro)} />
        <div class="bg-zinc-50 border border-zinc-200 rounded-xl px-4 py-3">
          <div class="flex items-center gap-1.5 mb-1.5">
            <span class="text-sm">🧭</span>
            <p class="text-xs font-semibold text-zinc-500 uppercase tracking-wide">How to use this list</p>
          </div>
          <p class="text-zinc-600 text-sm leading-relaxed" set:html={renderEditorial(editorial.howToUse)} />
        </div>
      </div>
    ) : (
      <p class="text-zinc-500 text-sm mb-6">The 20 greatest {cat.name} books — essential reads that defined the genre.</p>
    )}

    <div class="grid grid-cols-2 gap-3 mb-8">
      <a href={`/fantasy/${slug}/start-with/`} class="flex items-center gap-2.5 rounded-xl border border-zinc-200 px-4 py-3 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group">
        <span class="text-xl">🚀</span>
        <div>
          <p class="text-sm font-medium text-zinc-800 group-hover:text-purple-700">Best to Start With</p>
          <p class="text-xs text-zinc-400">Accessible entry points</p>
        </div>
      </a>
      <a href={`/fantasy/${slug}/hidden-gems/`} class="flex items-center gap-2.5 rounded-xl border border-zinc-200 px-4 py-3 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group">
        <span class="text-xl">💎</span>
        <div>
          <p class="text-sm font-medium text-zinc-800 group-hover:text-purple-700">Hidden Gems</p>
          <p class="text-xs text-zinc-400">Underrated picks</p>
        </div>
      </a>
    </div>

    {typedBooks && typedBooks.length > 0 ? (
      <ol class="flex flex-col gap-3">
        {typedBooks.map((book, i) => (
          <li>
            <a
              href={`/books/${book.slug}/`}
              class="flex items-center gap-4 px-4 py-4 rounded-xl border border-zinc-200 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group"
            >
              <span class="text-zinc-400 font-semibold text-sm w-6 shrink-0">{i + 1}</span>
              {book.cover_url ? (
                <img src={normalizeCoverUrl(book.cover_url) ?? '/grimplaceholder.png'} alt={book.title} class="h-28 w-20 object-cover rounded-md shrink-0 shadow-sm" loading="lazy" onerror="this.onerror=null;this.src='/grimplaceholder.png';" />
              ) : (
                <div class="h-28 w-20 rounded-md bg-purple-100 shrink-0" />
              )}
              <div class="min-w-0 flex-1">
                <div class="font-semibold text-zinc-800 group-hover:text-purple-700 transition-colors leading-tight mb-0.5">{book.title}</div>
                {book.series && (
                  <div class="text-xs text-indigo-500 mb-0.5">{book.series}{book.series_number != null ? ` #${book.series_number}` : ''}</div>
                )}
                {book.authors?.length > 0 && (
                  <div class="text-xs text-zinc-500 mb-1">{book.authors.join(', ')}</div>
                )}
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  {book.avg_rating && (
                    <span class="text-xs text-zinc-600 inline-flex items-center gap-1">
                      <span class="relative inline-block" style="letter-spacing:0.05em;line-height:1;vertical-align:middle">
                        <span style="color:#d4d4d8">★★★★★</span>
                        <span class="absolute top-0 left-0 overflow-hidden whitespace-nowrap" style={`width:${starPct(book.avg_rating)};color:#f59e0b`}>★★★★★</span>
                      </span>
                      {book.avg_rating.toFixed(2)}
                    </span>
                  )}
                  {book.darkness_level >= 1 && book.darkness_level <= 5 && (
                    <span class="text-xs text-zinc-400">{'🕯️'.repeat(book.darkness_level)} {DARKNESS_LABELS[book.darkness_level]}</span>
                  )}
                  {book.heat_level && HEAT[book.heat_level] && (
                    <span class="text-xs text-zinc-400">{HEAT[book.heat_level].flames} {HEAT[book.heat_level].label}</span>
                  )}
                </div>
                {book.best_for ? (
                  <p class="text-xs text-zinc-500 leading-relaxed italic">{book.best_for}</p>
                ) : book.synopsis ? (
                  <p class="text-xs text-zinc-500 leading-relaxed line-clamp-2">{book.synopsis}</p>
                ) : null}
              </div>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="text-zinc-500 text-sm">No books found for this category yet.</p>
    )}


    <div class="border-t border-zinc-100 pt-6 mt-8">
      <a href={`/fantasy/${slug}/`} class="text-sm text-purple-600 hover:text-purple-800 transition-colors">
        ← Back to {cat.name}
      </a>
    </div>
  </div>
</Layout>
