---
import Layout from '../../../components/Layout.astro';
import { CATEGORIES_META } from '../../../data/categories-meta';
import { supabaseClient } from '../../../lib/supabaseClient';

const { slug } = Astro.params;
if (!slug || !(slug in CATEGORIES_META)) return Astro.redirect('/books/');

const cat = CATEGORIES_META[slug as keyof typeof CATEGORIES_META];
const curatedTitles = cat.lists.hiddenGems;

const { data: allMatches } = await supabaseClient
  .from('books')
  .select('id, title, slug, authors, cover_url, avg_rating, darkness_level, series, series_number, synopsis, tropes')
  .in('title', curatedTitles);

const titleIndex = new Map(curatedTitles.map((t, i) => [t, i]));
const books = (allMatches ?? [])
  .sort((a, b) => (titleIndex.get(a.title) ?? 999) - (titleIndex.get(b.title) ?? 999))
  .slice(0, 20);

const DARKNESS_LABELS = ['', 'Lighthearted', 'Mild', 'Serious', 'Dark', 'Brutal'];

function starPct(r: number) { return ((r / 5) * 100).toFixed(2) + '%'; }

const SITE = 'https://thegrimoire.co';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${cat.name} Hidden Gems`,
  description: `20 underrated ${cat.name} books that deserve more attention — great reads with less hype.`,
  numberOfItems: books.length,
  itemListElement: books.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Book',
      name: b.title,
      author: (b.authors ?? []).map((a: string) => ({ '@type': 'Person', name: a })),
      url: `${SITE}/books/${b.slug}/`,
    },
  })),
});
---

<Layout
  title={`${cat.name} Hidden Gems — 20 Underrated Books | The Grimoire`}
  description={`Discover 20 underrated ${cat.name} books that deserve more attention — great ratings, less hype.`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <div class="max-w-2xl mx-auto">
    <nav class="text-sm text-zinc-400 mb-6 flex items-center gap-2">
      <a href="/books/" class="hover:text-zinc-700 transition-colors">Start Here</a>
      <span>›</span>
      <a href={`/fantasy/${slug}/`} class="hover:text-zinc-700 transition-colors">{cat.name}</a>
      <span>›</span>
      <span class="text-zinc-700 font-medium">Hidden Gems</span>
    </nav>

    <div class="flex items-center gap-2.5 mb-1">
      <span class="text-2xl">{cat.icon}</span>
      <h1 class="text-2xl font-bold tracking-tight">{cat.name} Hidden Gems</h1>
    </div>
    <div class="grid grid-cols-2 gap-3 mt-3 mb-6">
      <a href={`/fantasy/${slug}/all-time-greats/`} class="flex items-center gap-2.5 rounded-xl border border-zinc-200 px-4 py-3 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group">
        <span class="text-xl">⭐</span>
        <div>
          <p class="text-sm font-medium text-zinc-800 group-hover:text-purple-700">All-Time Greats</p>
          <p class="text-xs text-zinc-400">The defining books</p>
        </div>
      </a>
      <a href={`/fantasy/${slug}/start-with/`} class="flex items-center gap-2.5 rounded-xl border border-zinc-200 px-4 py-3 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group">
        <span class="text-xl">🚀</span>
        <div>
          <p class="text-sm font-medium text-zinc-800 group-hover:text-purple-700">Best to Start With</p>
          <p class="text-xs text-zinc-400">Accessible entry points</p>
        </div>
      </a>
    </div>

    <p class="text-zinc-500 text-sm mb-8">Solid, well-rated {cat.name} books that fly under the radar — less hype, more discovery.</p>

    {books && books.length > 0 ? (
      <ol class="flex flex-col gap-3">
        {books.map((book, i) => (
          <li>
            <a
              href={`/books/${book.slug}/`}
              class="flex items-center gap-4 px-4 py-4 rounded-xl border border-zinc-200 hover:border-purple-300 hover:bg-purple-50/40 transition-colors group"
            >
              <span class="text-zinc-400 font-semibold text-sm w-6 shrink-0">{i + 1}</span>
              {book.cover_url ? (
                <img src={book.cover_url} alt={book.title} class="h-28 w-20 object-cover rounded-md shrink-0 shadow-sm" loading="lazy" />
              ) : (
                <div class="h-28 w-20 rounded-md bg-purple-100 shrink-0" />
              )}
              <div class="min-w-0 flex-1">
                <div class="font-semibold text-zinc-800 group-hover:text-purple-700 transition-colors leading-tight mb-0.5">{book.title}</div>
                {book.series && (
                  <div class="text-xs text-indigo-500 mb-0.5">{book.series}{book.series_number != null ? ` #${book.series_number}` : ''}</div>
                )}
                {book.authors?.length > 0 && (
                  <div class="text-xs text-zinc-500 mb-1">{book.authors.join(', ')}</div>
                )}
                <div class="flex flex-wrap items-center gap-1 mb-1">
                  {book.avg_rating && (
                    <span class="text-xs text-zinc-600 inline-flex items-center gap-1">
                      <span class="relative inline-block" style="letter-spacing:0.05em;line-height:1;vertical-align:middle">
                        <span style="color:#d4d4d8">★★★★★</span>
                        <span class="absolute top-0 left-0 overflow-hidden whitespace-nowrap" style={`width:${starPct(book.avg_rating)};color:#f59e0b`}>★★★★★</span>
                      </span>
                      {book.avg_rating.toFixed(2)}
                    </span>
                  )}
                  {book.darkness_level >= 1 && book.darkness_level <= 5 && (
                    <span class="text-xs text-zinc-400"> · {'🕯️'.repeat(book.darkness_level)} {DARKNESS_LABELS[book.darkness_level]}</span>
                  )}
                </div>
                {book.synopsis && (
                  <p class="text-xs text-zinc-500 leading-relaxed line-clamp-2 mt-1">{book.synopsis}</p>
                )}
                {(book as any).tropes?.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-2">
                    {((book as any).tropes as string[]).slice(0, 3).map((t: string) => (
                      <span class="text-xs bg-purple-50 text-purple-600 rounded-full px-2 py-0.5 border border-purple-100">{t}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="text-zinc-500 text-sm">No books found for this category yet.</p>
    )}

    <div class="border-t border-zinc-100 pt-6 mt-8">
      <a href={`/fantasy/${slug}/`} class="text-sm text-purple-600 hover:text-purple-800 transition-colors">
        ← Back to {cat.name}
      </a>
    </div>
  </div>
</Layout>
