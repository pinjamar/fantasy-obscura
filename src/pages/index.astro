---
import Layout from "../components/Layout.astro";
import CategoryGrid from "../components/CategoryGrid";
import BookSearch from "../components/BookSearch";
import { supabaseClient } from '../lib/supabaseClient';
import { READING_ORDERS } from '../data/reading-orders';

// Fetch covers only for the curated slugs used in CategoryGrid — avoids serializing 8000+ books
const CURATED_SLUGS = ["the-way-of-kings","the-name-of-the-wind","the-final-empire","the-lies-of-locke-lamora","a-court-of-thorns-and-roses","six-of-crows","the-blade-itself","red-rising","the-poppy-war","gardens-of-the-moon","piranesi","dungeon-crawler-carl","the-eye-of-the-world","the-fifth-season","the-priory-of-the-orange-tree","the-rage-of-dragons","a-memory-called-empire","words-of-radiance","a-court-of-mist-and-fury","fourth-wing","from-blood-and-ash","the-cruel-prince","kingdom-of-the-wicked","divine-rivals","serpent-dove","kingdom-of-ash","shadow-and-bone","heir-of-fire","best-served-cold","prince-of-thorns","the-black-company","the-gutter-prayer","king-of-thorns","the-heroes","a-little-hatred","red-country","crooked-kingdom","nevernight","ninth-house","storm-front","american-gods","rivers-of-london","neverwhere","good-omens","house-of-earth-and-blood","changes","battle-ground","the-eye-of-the-bedlam-bride","jonathan-strange-and-mr-norrell","circe","the-bear-and-the-nightingale","spinning-silver","uprooted","the-song-of-achilles","the-invisible-life-of-addie-larue","daughter-of-the-moon-goddess","babel","mexican-gothic","the-once-and-future-witches","a-deadly-education","an-ember-in-the-ashes","the-magicians","mark-of-the-fool","iron-flame","ariadne","the-witchs-heart","legends-and-lattes","the-house-in-the-cerulean-sea","somewhere-beyond-the-sea","the-goblin-emperor","bookshops-bonedust","emily-wildes-encyclopaedia-of-faeries","tress-of-the-emerald-sea","waybound","wintersteel","underlord","dreadgod","uncrowned","ghostwater","he-who-fights-with-monsters","unsouled","soulsmith","blackflame","kings-of-the-wyld","the-riyria-revelations","elric-of-melnibone","the-tainted-cup","conan-the-victorious","dune","gideon-the-ninth","morning-star","a-wizard-of-earthsea","the-shadow-of-the-torturer","golden-son","defiant","wind-and-truth","onyx-storm","the-strength-of-the-few","house-of-flame-and-shadow","the-fury-of-the-gods","the-warm-hands-of-ghosts","empire-of-the-damned","the-trials-of-empire","witch-queen-of-redwinter","the-book-that-broke-the-world","the-doors-of-midnight","the-ashes-and-the-star-cursed-king","forsaken-relic","ravaged-souls","advent","he-who-fights-with-monsters-11","mark-of-the-fool-7","shadowborn-sorceress","burn-for-me","the-black-bird-oracle","an-inheritance-of-magic","skandar-and-the-chaos-trials","emily-wildes-compendium-of-lost-tales","butter-cookies-and-demon-claws","breaking-hel","a-sword-of-gold-and-ruin","a-day-of-fallen-night","immortalis","born-of-blood-and-ash","faebound","the-ragpicker-king","the-primal-of-blood-and-bone","gore","the-dark-feather","the-scour","days-of-shattered-faith","sanctuary-of-the-shadow","soul-of-a-witch","her-soul-to-take","archangels-lineage","cast-in-atonement","an-instruction-in-shadow","rift-in-the-soul","sundered-soul","installment-immortality","faery-moon","the-familiar","the-adventures-of-amina-al-sirafi","the-kingston-cycle","all-the-dead-shall-weep","disturbing-the-dead","broken-wishes","written-on-the-dark","the-atlas-complex","the-incident-at-serebro-academy","avalon-tower","sweet-nightmare","alumni","feathers-of-ash-and-hope","crave","elementals","the-city-in-glass","hera","tales-of-the-celestial-kingdom","a-touch-of-chaos","katabasis","the-last-song-of-penelope","emily-wildes-map-of-the-otherlands","beasts-and-baking","a-pub-in-the-underworld","campaigns-and-curses","the-baker-and-the-bard","the-bartender-between-worlds","boy-of-chaotic-making","shadow-play","distilled-magic","beware-of-chicken-2","beware-of-chicken-3","die-respawn-repeat","he-who-fights-with-monsters-12","mark-of-the-fool-8","chain-of-feathers","a-farm-in-the-afterlife","quicksilver","crossroads-of-ravens","andrzej-sapkowskis-the-witcher-the-witcher","a-knight-of-the-seven-kingdoms","lords-of-uncreation","alien-clay","the-book-of-elsewhere","navigational-entanglements","death-of-the-author","evolution","outlaw-planet","the-regicide-report"];

const coverMap: Record<string, string> = {};
{
  const { data } = await supabaseClient
    .from('books')
    .select('slug, cover_url, avg_rating')
    .in('slug', CURATED_SLUGS)
    .not('cover_url', 'is', null);
  for (const b of (data ?? [])) {
    if (b.slug && b.cover_url) coverMap[b.slug] = b.cover_url;
  }
}

// Keep initialBooks for top-rated section (needs avg_rating across all books)
const initialBooks: { title: string; slug: string | null; cover_url: string | null; avg_rating: number | null }[] = [];
{
  const PAGE = 1000;
  let from = 0;
  while (true) {
    const { data } = await supabaseClient
      .from('books')
      .select('title, slug, cover_url, avg_rating')
      .not('avg_rating', 'is', null)
      .order('avg_rating', { ascending: false, nullsFirst: false })
      .range(from, from + PAGE - 1);
    if (!data?.length) break;
    initialBooks.push(...data as typeof initialBooks);
    if (data.length < PAGE) break;
    from += PAGE;
  }
}

const readingOrderCounts: Record<string, number> = {};
for (const e of READING_ORDERS) {
  readingOrderCounts[e.slug] = e.groups
    ? e.groups.reduce((sum, g) => sum + g.books.length, 0)
    : (e.books?.length ?? 0);
}
---

<Layout title="The Grimoire - Fantasy Book Guides & Reading Orders" description="Fantasy book guides that help you find your next read. Detailed filtering, darkness ratings, trope tags, book likes and reading orders.">
  <!-- Homepage hero -->
  <div class="relative rounded-2xl overflow-hidden mb-8 border border-zinc-200">
    <picture>
      <source type="image/avif" srcset="/images/banners/homepage-hero-400.avif 400w, /images/banners/homepage-hero-800.avif 800w" sizes="(min-width: 1024px) 800px, 100vw" />
      <source type="image/webp" srcset="/images/banners/homepage-hero-400.webp 400w, /images/banners/homepage-hero-800.webp 800w" sizes="(min-width: 1024px) 800px, 100vw" />
      <img src="/images/banners/homepage-hero-800.webp" alt="" width="800" height="400" loading="eager" decoding="async" class="w-full aspect-3/1 object-cover" />
    </picture>
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/50 to-black/10" />
    <div class="absolute inset-0 px-6 py-6 flex flex-col justify-end">
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white">Find Your Next Fantasy Book</h1>
      <p class="hidden sm:block mt-2 max-w-2xl text-white/80 text-sm leading-relaxed">
        Fantasy is a vast library. You need a guide. The Grimoire doesn't just list books, we map them by every possible filter. From the complex reading orders to the nuanced darkness ratings and custom book recommendations, we got you covered. Spend less time searching and more time actually reading.
      </p>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap justify-center sm:justify-start items-center gap-2">
    {[
      { candles: '🕯️',             label: 'Lighthearted', color: 'bg-sky-50 text-sky-700 border-sky-200' },
      { candles: '🕯️🕯️',          label: 'Mild',         color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
      { candles: '🕯️🕯️🕯️',       label: 'Serious',      color: 'bg-yellow-50 text-yellow-700 border-yellow-200' },
      { candles: '🕯️🕯️🕯️🕯️',    label: 'Dark',         color: 'bg-orange-50 text-orange-700 border-orange-200' },
      { candles: '🕯️🕯️🕯️🕯️🕯️', label: 'Brutal',       color: 'bg-red-50 text-red-700 border-red-200' },
    ].map(({ candles, label, color }) => (
      <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-medium ${color}`}>
        {candles} {label}
      </span>
    ))}
  </div>

  <BookSearch client:load />

  <CategoryGrid client:load initialBooks={initialBooks} coverMap={coverMap} readingOrderCounts={readingOrderCounts} />

  <!-- Static prose: SEO content, word count, h2 bridge -->
  <section class="hidden sm:grid mt-16 border-t pt-10 grid-cols-2 gap-6 text-sm text-zinc-600 leading-relaxed">
    <div class="rounded-2xl bg-linear-to-br from-violet-50 via-white to-indigo-50 border border-violet-100 p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-zinc-900 mb-3">What is The Grimoire?</h2>
      <p class="mb-3">
        The Grimoire is a fantasy book database built for readers who want to know exactly what they're getting into before they start a new series. Every book comes with a <strong>darkness rating</strong> on a five-point candle scale - from lighthearted cozy fantasy all the way up to brutal grimdark - so you can match the book to your mood rather than being blindsided by content you weren't ready for.
      </p>
      <p class="mb-3">
        We cover thousands of fantasy books across every subgenre: epic fantasy, romantasy, grimdark, urban fantasy, LitRPG, historical fantasy, cozy fantasy and more. Each entry includes trope tags, pacing notes, heat level, magic system type, point-of-view style and content warnings - the details that actually matter when you're deciding what to read next.
      </p>
      <p>
        Use the <a href="/book-finder/" class="text-purple-700 hover:underline">Book Finder</a> to filter by any combination of these tags, or browse <a href="/tropes/" class="text-purple-700 hover:underline">by trope</a> if you know exactly what kind of story you're in the mood for.
      </p>
    </div>
    <div class="rounded-2xl bg-linear-to-br from-amber-50 via-white to-orange-50 border border-amber-100 p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-zinc-900 mb-3">Reading Orders & Series Guides</h2>
      <p class="mb-3">
        Long fantasy series can be intimidating. The Grimoire has step-by-step <a href="/reading-orders/" class="text-purple-700 hover:underline">reading orders</a> for all the major series - from Brandon Sanderson's sprawling Cosmere to the Wheel of Time, the First Law, Malazan, and dozens more. Each guide tells you which books are essential, which are standalone side stories and the best entry point if you're new to the series.
      </p>
      <p class="mb-3">
        Not sure where to start? The <a href="/books-like/" class="text-purple-700 hover:underline">Books Like...</a> section recommends what to read next based on books you already love. If you loved Mistborn, the Name of the Wind or the Way of Kings, we have handpicked lists that explain exactly why each recommendation fits - not just a generic "readers also liked" list.
      </p>
      <p>
        Browse our <a href="/authors/" class="text-purple-700 hover:underline">author pages</a> for full bibliographies, writing style breakdowns and the best place to start with each author's work. Whether you're new to an author or trying to fill gaps in a backlist, every page is built to give you the full picture without spoilers.
      </p>
    </div>
  </section>
</Layout>
