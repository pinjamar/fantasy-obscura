---
import Layout from '../../components/Layout.astro';

const creatures = [
  { name: 'Dragons', description: 'Powerful winged reptiles, often intelligent and magical', category: 'Creature' },
  { name: 'Elves', description: 'Graceful, long-lived humanoids with magical affinity', category: 'Race' },
  { name: 'Dwarves', description: 'Stout, hardy folk skilled in craftsmanship and mining', category: 'Race' },
  { name: 'Humans', description: 'Versatile and ambitious, the most adaptable race', category: 'Race' },
  { name: 'Vampires', description: 'Undead creatures sustained by blood, often immortal', category: 'Creature' },
  { name: 'Werewolves', description: 'Shapeshifters that transform between human and wolf forms', category: 'Creature' },
  { name: 'Fae / Fairies', description: 'Magical beings from another realm, often mischievous', category: 'Race' },
  { name: 'Orcs', description: 'Strong-willed warriors with tusks and green/grey skin', category: 'Race' },
  { name: 'Goblins', description: 'Small, clever creatures often found in mountains and caves', category: 'Race' },
  { name: 'Merfolk', description: 'Half-human, half-fish aquatic beings', category: 'Race' },
  { name: 'Phoenixes', description: 'Immortal birds that are reborn from their ashes', category: 'Creature' },
  { name: 'Griffins', description: 'Majestic creatures with eagle heads and lion bodies', category: 'Creature' },
  { name: 'Centaurs', description: 'Half-human, half-horse beings, often wise and skilled', category: 'Race' },
  { name: 'Minotaurs', description: 'Part human, part bull, known for strength and labyrinth dwellings', category: 'Race' },
  { name: 'Trolls', description: 'Large, strong creatures often associated with caves and bridges', category: 'Race' },
  { name: 'Giants', description: 'Massive humanoids of incredible size and strength', category: 'Race' },
  { name: 'Demons', description: 'Evil or mischievous supernatural beings from other realms', category: 'Creature' },
  { name: 'Angels', description: 'Divine or celestial beings of good, often winged', category: 'Creature' },
  { name: 'Witches & Warlocks', description: 'Humans with magical powers, often outcast from society', category: 'Race' },
  { name: 'Liches', description: 'Undead sorcerers who achieved immortality through dark magic', category: 'Creature' },
  { name: 'Golems', description: 'Magical constructs brought to life by enchantment', category: 'Creature' },
  { name: 'Gargoyles', description: 'Stone creatures that come to life, often protectors', category: 'Creature' },
  { name: 'Krakens', description: 'Massive tentacled sea creatures of legendary power', category: 'Creature' },
  { name: 'Sylphs', description: 'Ethereal air spirits, often beautiful and aloof', category: 'Race' },
  { name: 'Nymphs', description: 'Nature spirits tied to forests, water, or mountains', category: 'Race' },
  { name: 'Satyrs', description: 'Half-human, half-goat beings known for celebration and music', category: 'Race' },
  { name: 'Banshees', description: 'Female spirits whose wails herald death', category: 'Creature' },
  { name: 'Ghouls', description: 'Grave-dwelling creatures that feed on corpses', category: 'Creature' },
  { name: 'Shape-shifters', description: 'Beings able to change their form at will', category: 'Creature' },
  { name: 'Dragonborn', description: 'Dragon-descended humanoids with draconic traits', category: 'Race' },
];

const races = creatures.filter(c => c.category === 'Race');
const creaturesList = creatures.filter(c => c.category === 'Creature');
---

<Layout
  title="Creatures & Races | Fantasy Obscura"
  description="Popular fantasy creatures and races from epic fantasy literature."
>
  <div>
    <h1 class="text-4xl font-bold tracking-tight">Creatures & Races</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">
      Explore the diverse beings that populate fantasy worlds. From noble races to fearsome creatures, each plays a vital role in epic narratives.
    </p>
  </div>

  <!-- Races Section -->
  <section class="mt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold">🏰 Mythical Races ({races.length})</h2>
      <p class="text-sm text-zinc-600 mt-2">Intelligent civilizations with their own cultures and societies</p>
    </div>
    
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {races.map(race => (
        <div class="border rounded-lg p-4 hover:shadow-md transition-shadow bg-gradient-to-br from-blue-50 to-purple-50">
          <h3 class="font-semibold text-lg text-blue-900">{race.name}</h3>
          <p class="text-sm text-zinc-700 mt-2">{race.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Creatures Section -->
  <section class="mt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold">🐉 Legendary Creatures ({creaturesList.length})</h2>
      <p class="text-sm text-zinc-600 mt-2">Powerful beings, monsters, and magical entities</p>
    </div>
    
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {creaturesList.map(creature => (
        <div class="border rounded-lg p-4 hover:shadow-md transition-shadow bg-gradient-to-br from-orange-50 to-red-50">
          <h3 class="font-semibold text-lg text-orange-900">{creature.name}</h3>
          <p class="text-sm text-zinc-700 mt-2">{creature.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Stats -->
  <div class="mt-12 grid gap-4 sm:grid-cols-3 p-6 bg-zinc-50 rounded-lg">
    <div class="text-center">
      <div class="text-3xl font-bold text-purple-600">{races.length}</div>
      <div class="text-sm text-zinc-600 mt-1">Mythical Races</div>
    </div>
    <div class="text-center">
      <div class="text-3xl font-bold text-orange-600">{creaturesList.length}</div>
      <div class="text-sm text-zinc-600 mt-1">Creatures</div>
    </div>
    <div class="text-center">
      <div class="text-3xl font-bold text-blue-600">{creatures.length}</div>
      <div class="text-sm text-zinc-600 mt-1">Total</div>
    </div>
  </div>
</Layout>
