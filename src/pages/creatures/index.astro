---
import Layout from '../../components/Layout.astro';
---

<Layout
  title="Creatures & Races | Fantasy Obscura"
  description="Quick reference to common fantasy creatures."
>
  <h1 class="text-3xl font-semibold tracking-tight">Creatures & Races</h1>
  <p class="mt-4 max-w-2xl text-zinc-700">
    A simple placeholder list you can expand later.
  </p>

  <ul class="mt-6 list-disc pl-5 space-y-2 text-zinc-700">
    <li>Dragons</li>
    <li>Fae / Elves</li>
    <li>Dwarves</li>
    <li>Vampires</li>
    <li>Werewolves</li>
  </ul>
</Layout>
