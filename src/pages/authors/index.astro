---
import Layout from '../../components/Layout.astro';
import { getAllAuthors } from '../../lib/db/books';
import { supabaseClient } from '../../lib/supabaseClient';

const [authors, profilesRes] = await Promise.all([
  getAllAuthors(),
  supabaseClient.from('authors').select('slug, photo_url'),
]);

// Build slug → photo_url map
type ProfileRow = { slug: string; photo_url: string | null };
const photoMap = new Map<string, string | null>();
for (const p of (profilesRes.data ?? []) as ProfileRow[]) {
  photoMap.set(p.slug, p.photo_url);
}

// Group by first letter of last name for the A–Z jump nav
const lastName = (n: string) => n.trim().split(/\s+/).at(-1) ?? n;
const letters = [...new Set(authors.map((a) => lastName(a.name)[0].toUpperCase()))].sort();

const grouped = letters.map((letter) => ({
  letter,
  authors: authors.filter((a) => lastName(a.name)[0].toUpperCase() === letter),
}));

// Avatar colour — deterministic from name
function authorColor(name: string): string {
  const palette = [
    'bg-purple-500', 'bg-blue-500', 'bg-emerald-500', 'bg-amber-500',
    'bg-rose-500',   'bg-indigo-500', 'bg-teal-500',   'bg-orange-500',
    'bg-cyan-500',   'bg-fuchsia-500',
  ];
  let h = 0;
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) & 0xff;
  return palette[h % palette.length];
}
---

<Layout title="Authors | Fantasy Obscura" description="Browse all fantasy and sci-fi authors in our database.">
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight">Authors</h1>
    <p class="mt-2 text-zinc-600">{authors.length} authors in our database</p>
  </div>

  <!-- A–Z jump nav -->
  <div class="flex flex-wrap gap-1 mb-10">
    {letters.map((l) => (
      <a
        href={`#letter-${l}`}
        class="w-8 h-8 flex items-center justify-center rounded-md text-sm font-medium bg-zinc-100 hover:bg-zinc-200 text-zinc-700 transition-colors"
      >
        {l}
      </a>
    ))}
  </div>

  <!-- Author groups -->
  <div class="space-y-12">
    {grouped.map(({ letter, authors: group }) => (
      <section id={`letter-${letter}`}>
        <h2 class="text-lg font-semibold text-zinc-400 border-b pb-2 mb-5">{letter}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {group.map((author) => (
            <a
              href={`/authors/${author.slug}/`}
              class="flex items-center gap-4 rounded-xl border p-4 hover:shadow-md hover:border-zinc-300 transition-all group"
            >
              <!-- Avatar / Photo -->
              {photoMap.get(author.slug) ? (
                <img
                  src={photoMap.get(author.slug)!}
                  alt={author.name}
                  class="shrink-0 w-12 h-12 rounded-full object-cover shadow-sm"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                />
                <div class={`shrink-0 w-12 h-12 rounded-full ${authorColor(author.name)} items-center justify-center text-white font-bold text-lg hidden`}>
                  {author.name[0].toUpperCase()}
                </div>
              ) : (
                <div class={`shrink-0 w-12 h-12 rounded-full ${authorColor(author.name)} flex items-center justify-center text-white font-bold text-lg`}>
                  {author.name[0].toUpperCase()}
                </div>
              )}

              <!-- Info -->
              <div class="min-w-0">
                <p class="font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors truncate">
                  {author.name}
                </p>
                <p class="text-xs text-zinc-500 mt-0.5">
                  {author.bookCount} {author.bookCount === 1 ? 'book' : 'books'}
                  {author.avgRating != null && (
                    <span class="ml-2">· ★ {author.avgRating}</span>
                  )}
                </p>
                {author.topGenres.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-1.5">
                    {author.topGenres.map((g) => (
                      <span class="text-xs bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded">
                        {g}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
