---
import Layout from '../../components/Layout.astro';
import { supabaseClient } from '../../lib/supabaseClient';

type AuthorRow = {
  name: string;
  slug: string;
  photo_url: string | null;
  book_count: number | null;
  top_genres: string[] | null;
  avg_rating: number | null;
};

// ── helpers ───────────────────────────────────────────────────────────────────
const SUFFIXES = /^(jr\.?|sr\.?|ii|iii|iv|v|esq\.?)$/i;
const stripParens = (n: string) => {
  const cleaned = n.replace(/\([^)]*\)/g, '').replace(/[()]/g, '').replace(/\s+/g, ' ').trim();
  if (cleaned) return cleaned;
  return n.replace(/[()]/g, '').replace(/\s+/g, ' ').trim() || n;
};
const lastName = (n: string) => {
  const parts = stripParens(n).split(/\s+/).filter(Boolean);
  while (parts.length > 1 && SUFFIXES.test(parts[parts.length - 1])) parts.pop();
  return parts.at(-1) ?? n;
};
const authorInitial = (n: string) => stripParens(n)[0]?.toUpperCase() ?? '?';
const normalizeInitial = (ch: string) =>
  ch.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase();

// ── 1. Fetch all names (lightweight) to build letter nav ──────────────────────
const PAGE = 1000;
const allNameData: { name: string; slug: string }[] = [];
let off = 0;
while (true) {
  const { data } = await supabaseClient
    .from('authors')
    .select('name, slug')
    .gt('book_count', 1)
    .order('name')
    .range(off, off + PAGE - 1);
  if (!data?.length) break;
  allNameData.push(...(data as { name: string; slug: string }[]));
  if (data.length < PAGE) break;
  off += PAGE;
}

const letters = [...new Set(allNameData.map((a) => normalizeInitial(lastName(a.name)[0])))].sort();
const selectedLetter = (Astro.url.searchParams.get('letter') ?? letters[0] ?? 'A').toUpperCase();

// ── 2. Fetch full data only for the active letter ─────────────────────────────
const activeSlugs = allNameData
  .filter((a) => normalizeInitial(lastName(a.name)[0]) === selectedLetter)
  .map((a) => a.slug);

let activeAuthors: AuthorRow[] = [];
if (activeSlugs.length) {
  const { data } = await supabaseClient
    .from('authors')
    .select('name, slug, photo_url, book_count, top_genres, avg_rating')
    .in('slug', activeSlugs)
    .order('name');
  activeAuthors = ((data ?? []) as unknown as AuthorRow[]).sort((a, b) =>
    lastName(a.name).localeCompare(lastName(b.name)),
  );
}

// Avatar colour — deterministic from name
function authorColor(name: string): string {
  const palette = [
    'bg-purple-500', 'bg-blue-500', 'bg-emerald-500', 'bg-amber-500',
    'bg-rose-500',   'bg-indigo-500', 'bg-teal-500',   'bg-orange-500',
    'bg-cyan-500',   'bg-fuchsia-500',
  ];
  let h = 0;
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) & 0xff;
  return palette[h % palette.length];
}
---

<Layout title="Fantasy Authors | The Grimoire" description="Browse fantasy authors — bios, full book lists, series guides, writing style, and the best place to start for every author.">
  <div class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">Authors</h1>
    <p class="mt-2 text-zinc-600">{allNameData.length} authors in our database</p>
  </div>

  <!-- Search bar -->
  <div class="relative max-w-sm mb-6">
    <input
      id="author-search"
      type="text"
      placeholder="Search authors…"
      autocomplete="off"
      class="w-full rounded-xl border border-zinc-300 bg-white px-4 py-2.5 pl-9 text-sm shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200 transition"
    />
    <svg class="absolute left-3 top-3 h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
    </svg>
  </div>
  <p id="author-no-results" class="hidden text-sm text-zinc-400 mb-6">No authors match your search.</p>

  <!-- A–Z letter nav -->
  <div id="az-nav" class="flex flex-wrap gap-1 mb-8">
    {letters.map((l) => (
      <a
        href={`/authors/?letter=${l}`}
        class={`w-8 h-8 flex items-center justify-center rounded-md text-sm font-medium transition-colors no-underline ${l === selectedLetter ? 'bg-purple-600 text-white' : 'bg-zinc-100 hover:bg-zinc-200 text-zinc-700'}`}
      >
        {l}
      </a>
    ))}
  </div>

  <!-- Find Similar Authors widget -->
  <div id="similar-widget" class="relative mb-10 rounded-2xl border-2 border-purple-300 bg-linear-to-br from-purple-50 via-indigo-50 to-purple-50 p-6 shadow-md shadow-purple-100 text-center">
    <button id="similar-reset" class="hidden absolute top-4 right-4 items-center gap-1 text-xs text-zinc-400 hover:text-purple-600 transition-colors">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h5M20 20v-5h-5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 9a9 9 0 0 1 15-3.5M20 15a9 9 0 0 1-15 3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Reset
    </button>
    <h2 class="text-xs font-semibold text-purple-500 uppercase tracking-widest mb-1">Find Similar Authors</h2>
    <p class="text-sm text-zinc-500 leading-relaxed mb-5">Enter your favourite author and discover writers in a similar style.</p>
    <div class="flex gap-2 max-w-md mx-auto relative">
      <div class="relative flex-1">
        <input
          id="similar-input"
          type="text"
          placeholder="Author name…"
          autocomplete="off"
          class="w-full rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200 transition"
        />
        <ul id="similar-suggestions" class="hidden absolute z-20 mt-1 w-full rounded-xl border border-zinc-200 bg-white shadow-lg overflow-hidden text-sm text-left"></ul>
      </div>
      <button
        id="similar-btn"
        class="shrink-0 px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
      >Find similar</button>
    </div>
    <div id="similar-results" class="hidden mt-6 text-left">
      <p id="similar-heading" class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3"></p>
      <div id="similar-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    </div>
    <p id="similar-empty" class="hidden mt-4 text-sm text-zinc-400">No similar authors found.</p>
  </div>

  <!-- Search results (hidden until search is active) -->
  <div id="search-results" class="hidden">
    <div id="search-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
  </div>

  <!-- Letter content (SSR — only active letter) -->
  <div id="letter-content">
    <section>
      <h2 class="text-lg font-semibold text-zinc-400 border-b pb-2 mb-5">{selectedLetter}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {activeAuthors.map((author, j) => (
          <a
            href={`/authors/${author.slug}/`}
            data-index={j}
            class={`author-card flex items-center gap-4 rounded-xl border p-4 hover:shadow-md hover:border-zinc-300 transition-all group${j >= 24 ? ' hidden' : ''}`}
          >
            {author.photo_url ? (
              <>
                <img
                  src={author.photo_url}
                  alt={author.name}
                  class="shrink-0 w-20 h-20 rounded-xl object-cover shadow-sm"
                  loading="lazy"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                />
                <div class={`shrink-0 w-20 h-20 rounded-xl ${authorColor(author.name)} items-center justify-center text-white font-bold text-xl hidden`}>
                  {authorInitial(author.name)}
                </div>
              </>
            ) : (
              <div class={`shrink-0 w-20 h-20 rounded-xl ${authorColor(author.name)} flex items-center justify-center text-white font-bold text-xl`}>
                {authorInitial(author.name)}
              </div>
            )}
            <div class="min-w-0">
              <p class="font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors truncate">
                {author.name}
              </p>
              <p class="text-xs text-zinc-500 mt-0.5">
                {author.book_count ?? 0} {(author.book_count ?? 0) === 1 ? 'book' : 'books'}
                {author.avg_rating != null && (
                  <span class="ml-2">· ★ {author.avg_rating}</span>
                )}
              </p>
              {(author.top_genres ?? []).length > 0 && (
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {(author.top_genres ?? []).map((g) => (
                    <span class="text-xs bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded">{g}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      {activeAuthors.length > 24 && (
        <div class="letter-pagination mt-6 flex items-center justify-center gap-3" data-total={activeAuthors.length} data-page="0" data-per-page="24">
          <button class="prev-btn px-4 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-700 text-sm font-medium transition-colors disabled:opacity-30 disabled:cursor-not-allowed" disabled>← Prev</button>
          <span class="page-label text-sm text-zinc-500">Page 1 of {Math.ceil(activeAuthors.length / 24)}</span>
          <button class="next-btn px-4 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-700 text-sm font-medium transition-colors">Next →</button>
        </div>
      )}
    </section>
  </div>
</Layout>

<script>
  const input = document.getElementById('author-search') as HTMLInputElement;
  const noResults = document.getElementById('author-no-results')!;
  const azNav = document.getElementById('az-nav')!;
  const letterContent = document.getElementById('letter-content')!;
  const searchResults = document.getElementById('search-results')!;
  const searchGrid = document.getElementById('search-grid')!;

  // Mirror of server-side authorColor
  function authorColor(name: string): string {
    const palette = [
      'bg-purple-500', 'bg-blue-500', 'bg-emerald-500', 'bg-amber-500',
      'bg-rose-500',   'bg-indigo-500', 'bg-teal-500',   'bg-orange-500',
      'bg-cyan-500',   'bg-fuchsia-500',
    ];
    let h = 0;
    for (const c of name) h = (h * 31 + c.charCodeAt(0)) & 0xff;
    return palette[h % palette.length];
  }

  function esc(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderCard(a: any): string {
    const initial = (a.name.replace(/\([^)]*\)/g, '').trim()[0] ?? '?').toUpperCase();
    const color = authorColor(a.name);
    const photo = a.photo_url
      ? `<img src="${esc(a.photo_url)}" alt="${esc(a.name)}" class="shrink-0 w-20 h-20 rounded-xl object-cover shadow-sm" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" /><div class="${color} shrink-0 w-20 h-20 rounded-xl items-center justify-center text-white font-bold text-xl" style="display:none">${initial}</div>`
      : `<div class="${color} shrink-0 w-20 h-20 rounded-xl flex items-center justify-center text-white font-bold text-xl">${initial}</div>`;
    const genres = (a.top_genres ?? []).slice(0, 3)
      .map((g: string) => `<span class="text-xs bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded">${esc(g)}</span>`)
      .join('');
    const rating = a.avg_rating != null ? `<span class="ml-2">· ★ ${a.avg_rating}</span>` : '';
    return `<a href="/authors/${esc(a.slug)}/" class="flex items-center gap-4 rounded-xl border p-4 hover:shadow-md hover:border-zinc-300 transition-all group">
      ${photo}
      <div class="min-w-0">
        <p class="font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors truncate">${esc(a.name)}</p>
        <p class="text-xs text-zinc-500 mt-0.5">${a.book_count ?? 0} ${a.book_count === 1 ? 'book' : 'books'}${rating}</p>
        ${genres ? `<div class="flex flex-wrap gap-1 mt-1.5">${genres}</div>` : ''}
      </div>
    </a>`;
  }

  // Letter pagination (for letters with >24 authors)
  document.querySelectorAll<HTMLElement>('.letter-pagination').forEach((pagination) => {
    const section = pagination.closest<HTMLElement>('section')!;
    const total = parseInt(pagination.dataset.total!);
    const perPage = parseInt(pagination.dataset.perPage!);
    const totalPages = Math.ceil(total / perPage);
    const prevBtn = pagination.querySelector<HTMLButtonElement>('.prev-btn')!;
    const nextBtn = pagination.querySelector<HTMLButtonElement>('.next-btn')!;
    const label = pagination.querySelector<HTMLElement>('.page-label')!;

    function goToPage(page: number) {
      pagination.dataset.page = String(page);
      section.querySelectorAll<HTMLElement>('.author-card').forEach((card) => {
        const idx = parseInt(card.dataset.index!);
        card.classList.toggle('hidden', idx < page * perPage || idx >= (page + 1) * perPage);
      });
      label.textContent = `Page ${page + 1} of ${totalPages}`;
      prevBtn.disabled = page === 0;
      nextBtn.disabled = page === totalPages - 1;
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    prevBtn.addEventListener('click', () => goToPage(parseInt(pagination.dataset.page!) - 1));
    nextBtn.addEventListener('click', () => goToPage(parseInt(pagination.dataset.page!) + 1));
  });

  // ── Find Similar Authors widget ───────────────────────────────────────────────
  const similarInput = document.getElementById('similar-input') as HTMLInputElement;
  const similarBtn = document.getElementById('similar-btn') as HTMLButtonElement;
  const similarSuggestions = document.getElementById('similar-suggestions') as HTMLUListElement;
  const similarResults = document.getElementById('similar-results') as HTMLDivElement;
  const similarGrid = document.getElementById('similar-grid') as HTMLDivElement;
  const similarHeading = document.getElementById('similar-heading') as HTMLParagraphElement;
  const similarEmpty = document.getElementById('similar-empty') as HTMLParagraphElement;
  const similarReset = document.getElementById('similar-reset') as HTMLButtonElement;

  let selectedSlug: string | null = null;
  let suggestTimeout: ReturnType<typeof setTimeout>;

  similarInput.addEventListener('input', () => {
    const q = similarInput.value.trim();
    selectedSlug = null;
    clearTimeout(suggestTimeout);
    if (q.length < 2) { similarSuggestions.classList.add('hidden'); return; }
    suggestTimeout = setTimeout(async () => {
      const res = await fetch(`/api/authors?search=${encodeURIComponent(q)}`);
      const { items: raw } = await res.json();
      const items = (raw ?? []).slice(0, 6);
      if (!items.length) { similarSuggestions.classList.add('hidden'); return; }
      similarSuggestions.innerHTML = items.map((a: any) =>
        `<li class="flex items-center gap-3 px-4 py-2.5 hover:bg-purple-50 cursor-pointer transition-colors" data-slug="${esc(a.slug)}" data-name="${esc(a.name)}">
          <span class="font-medium text-zinc-900">${esc(a.name)}</span>
          <span class="ml-auto text-xs text-zinc-400 shrink-0">${a.book_count ?? 0} books</span>
        </li>`
      ).join('');
      similarSuggestions.classList.remove('hidden');
    }, 250);
  });

  similarSuggestions.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest('li[data-slug]') as HTMLLIElement | null;
    if (!li) return;
    selectedSlug = li.dataset.slug!;
    similarInput.value = li.dataset.name!;
    similarSuggestions.classList.add('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!similarInput.contains(e.target as Node) && !similarSuggestions.contains(e.target as Node)) {
      similarSuggestions.classList.add('hidden');
    }
  });

  async function runSimilar() {
    const slug = selectedSlug;
    if (!slug) return;
    similarBtn.disabled = true;
    similarBtn.textContent = 'Searching…';
    similarResults.classList.add('hidden');
    similarEmpty.classList.add('hidden');

    const res = await fetch(`/api/authors/similar?slug=${encodeURIComponent(slug)}`);
    const { items } = await res.json();

    similarBtn.disabled = false;
    similarBtn.textContent = 'Find similar';

    if (!items?.length) { similarEmpty.classList.remove('hidden'); return; }

    similarHeading.textContent = `${items.length} authors similar to ${similarInput.value}`;
    similarGrid.innerHTML = items.map(renderCard).join('');
    similarResults.classList.remove('hidden');
    similarReset.classList.remove('hidden');
    similarReset.classList.add('flex');
  }

  similarBtn.addEventListener('click', runSimilar);
  similarInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') runSimilar(); });

  similarReset.addEventListener('click', () => {
    similarInput.value = '';
    selectedSlug = null;
    similarResults.classList.add('hidden');
    similarEmpty.classList.add('hidden');
    similarGrid.innerHTML = '';
    similarReset.classList.add('hidden');
    similarReset.classList.remove('flex');
  });

  // ── Author search ─────────────────────────────────────────────────────────────
  let searchTimeout: ReturnType<typeof setTimeout>;

  input.addEventListener('input', () => {
    const q = input.value.trim();
    clearTimeout(searchTimeout);

    if (q.length < 2) {
      searchResults.classList.add('hidden');
      letterContent.classList.remove('hidden');
      azNav.classList.remove('hidden');
      noResults.classList.add('hidden');
      return;
    }

    azNav.classList.add('hidden');
    letterContent.classList.add('hidden');
    searchResults.classList.remove('hidden');

    searchTimeout = setTimeout(async () => {
      const res = await fetch(`/api/authors?search=${encodeURIComponent(q)}`);
      const { items } = await res.json();
      if (!items.length) {
        searchGrid.innerHTML = '';
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
        searchGrid.innerHTML = items.map(renderCard).join('');
      }
    }, 300);
  });
</script>
