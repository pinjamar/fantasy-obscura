---
import Layout from '../../components/Layout.astro';
import { getAllAuthors } from '../../lib/db/books';
import { supabaseClient } from '../../lib/supabaseClient';

const [authors, profilesRes] = await Promise.all([
  getAllAuthors(),
  supabaseClient.from('authors').select('slug, photo_url'),
]);

// Build slug → photo_url map
type ProfileRow = { slug: string; photo_url: string | null };
const photoMap = new Map<string, string | null>();
for (const p of (profilesRes.data ?? []) as ProfileRow[]) {
  photoMap.set(p.slug, p.photo_url);
}

// Group by first letter of last name for the A–Z jump nav
// Strips parenthetical pen names and trailing suffixes before picking last token
const SUFFIXES = /^(jr\.?|sr\.?|ii|iii|iv|v|esq\.?)$/i;
const stripParens = (n: string) => {
  // Remove balanced (...) groups, then strip any leftover ( ) chars
  const cleaned = n.replace(/\([^)]*\)/g, '').replace(/[()]/g, '').replace(/\s+/g, ' ').trim();
  if (cleaned) return cleaned;
  // Entire name was parenthetical — strip just the brackets, keep the text
  return n.replace(/[()]/g, '').replace(/\s+/g, ' ').trim() || n;
};
const lastName = (n: string) => {
  const parts = stripParens(n).split(/\s+/).filter(Boolean);
  while (parts.length > 1 && SUFFIXES.test(parts[parts.length - 1])) parts.pop();
  return parts.at(-1) ?? n;
};
const authorInitial = (n: string) => stripParens(n)[0]?.toUpperCase() ?? '?';

// Normalize diacritics so Á/Ă/Â/Ä etc. all map to their base letter (A, B, C…)
const normalizeInitial = (ch: string) =>
  ch.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase();

const letters = [...new Set(authors.map((a) => normalizeInitial(lastName(a.name)[0])))].sort();

const grouped = letters.map((letter) => ({
  letter,
  authors: authors.filter((a) => normalizeInitial(lastName(a.name)[0]) === letter),
}));

// Avatar colour — deterministic from name
function authorColor(name: string): string {
  const palette = [
    'bg-purple-500', 'bg-blue-500', 'bg-emerald-500', 'bg-amber-500',
    'bg-rose-500',   'bg-indigo-500', 'bg-teal-500',   'bg-orange-500',
    'bg-cyan-500',   'bg-fuchsia-500',
  ];
  let h = 0;
  for (const c of name) h = (h * 31 + c.charCodeAt(0)) & 0xff;
  return palette[h % palette.length];
}
---

<Layout title="Fantasy Authors | The Grimoire" description="Browse fantasy authors — bios, full book lists, series guides, writing style, and the best place to start for every author.">
  <div class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">Authors</h1>
    <p class="mt-2 text-zinc-600">{authors.length} authors in our database</p>
  </div>

  <!-- Search bar -->
  <div class="relative max-w-sm mb-6">
    <input
      id="author-search"
      type="text"
      placeholder="Search authors…"
      autocomplete="off"
      class="w-full rounded-xl border border-zinc-300 bg-white px-4 py-2.5 pl-9 text-sm shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200 transition"
    />
    <svg class="absolute left-3 top-3 h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
    </svg>
  </div>
  <p id="author-no-results" class="hidden text-sm text-zinc-400 mb-6">No authors match your search.</p>

  <!-- A–Z letter nav -->
  <div id="az-nav" class="flex flex-wrap gap-1 mb-8">
    {letters.map((l, i) => (
      <button
        data-letter={l}
        class={`letter-btn w-8 h-8 flex items-center justify-center rounded-md text-sm font-medium transition-colors ${i === 0 ? 'bg-purple-600 text-white' : 'bg-zinc-100 hover:bg-zinc-200 text-zinc-700'}`}
      >
        {l}
      </button>
    ))}
  </div>

  <!-- Author groups -->
  <div id="author-groups" class="space-y-12">
    {grouped.map(({ letter, authors: group }, i) => (
      <section id={`letter-${letter}`} class={`author-section${i !== 0 ? ' hidden' : ''}`}>
        <h2 class="text-lg font-semibold text-zinc-400 border-b pb-2 mb-5">{letter}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {group.map((author) => (
            <a
              href={`/authors/${author.slug}/`}
              data-name={author.name.toLowerCase()}
              data-bookcount={author.bookCount}
              class={`author-card flex items-center gap-4 rounded-xl border p-4 hover:shadow-md hover:border-zinc-300 transition-all group${author.bookCount <= 1 ? ' default-hidden' : ''}`}
            >
              <!-- Avatar / Photo -->
              {photoMap.get(author.slug) ? (
                <img
                  src={photoMap.get(author.slug)!}
                  alt={author.name}
                  class="shrink-0 w-20 h-20 rounded-xl object-cover shadow-sm"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                />
                <div class={`shrink-0 w-20 h-20 rounded-xl ${authorColor(author.name)} items-center justify-center text-white font-bold text-xl hidden`}>
                  {authorInitial(author.name)}
                </div>
              ) : (
                <div class={`shrink-0 w-20 h-20 rounded-xl ${authorColor(author.name)} flex items-center justify-center text-white font-bold text-xl`}>
                  {authorInitial(author.name)}
                </div>
              )}

              <!-- Info -->
              <div class="min-w-0">
                <p class="font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors truncate">
                  {author.name}
                </p>
                <p class="text-xs text-zinc-500 mt-0.5">
                  {author.bookCount} {author.bookCount === 1 ? 'book' : 'books'}
                  {author.avgRating != null && (
                    <span class="ml-2">· ★ {author.avgRating}</span>
                  )}
                </p>
                {author.topGenres.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-1.5">
                    {author.topGenres.map((g) => (
                      <span class="text-xs bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded">
                        {g}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<script>
  const input = document.getElementById('author-search') as HTMLInputElement;
  const noResults = document.getElementById('author-no-results')!;
  const azNav = document.getElementById('az-nav')!;
  const sections = document.querySelectorAll<HTMLElement>('.author-section');
  const letterBtns = document.querySelectorAll<HTMLButtonElement>('.letter-btn');

  let activeLetter = letterBtns[0]?.dataset.letter ?? '';

  // Hide 1-book authors in the initially-visible section
  document.querySelectorAll<HTMLElement>('.default-hidden').forEach((c) => c.classList.add('hidden'));

  function showLetter(letter: string) {
    activeLetter = letter;
    sections.forEach((s) => {
      const show = s.id === `letter-${letter}`;
      s.classList.toggle('hidden', !show);
      if (show) {
        // Re-apply default-hidden for 1-book authors when not in search mode
        s.querySelectorAll<HTMLElement>('.author-card').forEach((c) => {
          c.classList.toggle('hidden', c.classList.contains('default-hidden'));
        });
      }
    });
    letterBtns.forEach((btn) => {
      const active = btn.dataset.letter === letter;
      btn.classList.toggle('bg-purple-600', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('bg-zinc-100', !active);
      btn.classList.toggle('text-zinc-700', !active);
    });
  }

  letterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      input.value = '';
      noResults.classList.add('hidden');
      azNav.classList.remove('hidden');
      showLetter(btn.dataset.letter!);
    });
  });

  input.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    if (!q) {
      noResults.classList.add('hidden');
      azNav.classList.remove('hidden');
      showLetter(activeLetter);
      return;
    }

    // Search mode: show all sections, filter cards (including 1-book authors)
    azNav.classList.add('hidden');
    let total = 0;
    sections.forEach((section) => {
      const cards = section.querySelectorAll<HTMLElement>('.author-card');
      let visible = 0;
      cards.forEach((card) => {
        const match = (card.dataset.name ?? '').includes(q);
        card.classList.toggle('hidden', !match);
        if (match) visible++;
      });
      section.classList.toggle('hidden', visible === 0);
      total += visible;
    });
    noResults.classList.toggle('hidden', total > 0);
  });
</script>
