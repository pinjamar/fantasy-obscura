const universeGuide = AUTHOR_UNIVERSE_MAP[slug ?? ''] ?? null;

const seriesMap = new Map<string, number>();
for (const book of books) {
  if (book.series) {
    seriesMap.set(book.series, (seriesMap.get(book.series) ?? 0) + 1);
  }
}

const seriesList: SeriesEntry[] = [...seriesMap.entries()]
  .sort((a, b) => b[1] - a[1]) // most books first
  .map(([name, bookCount]) => {
    const firstBook = books
      .filter(b => b.series === name && b.slug)
      .sort((a, b) => (a.series_number ?? 999) - (b.series_number ?? 999))[0] ?? null;
    return {
      name,
      bookCount,
      readingOrderSlug: READING_ORDER_MAP[name] ?? null,
      firstBookSlug: firstBook?.slug ?? null,
    };
  });

// Avatar colour — deterministic from name
const palette = [
  'from-purple-500 to-indigo-500', 'from-blue-500 to-cyan-500',
  'from-emerald-500 to-teal-500',  'from-amber-500 to-orange-500',
  'from-rose-500 to-pink-500',     'from-fuchsia-500 to-purple-500',
];
let h = 0;
for (const c of authorName) h = (h * 31 + c.charCodeAt(0)) & 0xff;
const avatarGradient = palette[h % palette.length];

const DARKNESS_CANDLES = ['', '🕯️', '🕯️🕯️', '🕯️🕯️🕯️', '🕯️🕯️🕯️🕯️', '🕯️🕯️🕯️🕯️🕯️'];

// Clean bio: strip "Note:" lines and bare markdown reference links
const cleanBio = profile?.bio
  ?.split('\n')
  .filter(line => !line.trim().startsWith('Note:') && !line.trim().match(/^\[\d+\]:/))
  .join('\n')
  .trim() || null;

// Similar authors: scored by genre (×3) + trope (×2) + tone (×1) overlap
// + darkness proximity penalty + popularity weight; min 8 books + avg_rating ≥ 3.8
type SimilarAuthorRow = { name: string; slug: string; photo_url: string | null; book_count: number | null };

function overlapCount(a: string[], b: string[]): number {
  const set = new Set(b);
  return a.filter((v) => set.has(v)).length;
}

const scores = new Map<string, number>();
const bump = (name: string, n: number) => scores.set(name, (scores.get(name) ?? 0) + n);

const { data: genrePoolData } = topGenres.length
  ? await supabaseClient.from('authors').select('name, top_genres, book_count').overlaps('top_genres', topGenres).neq('slug', slug).gte('book_count', 8).limit(100)
  : { data: [] };

const genrePoolNames = new Set<string>();
for (const a of (genrePoolData ?? []) as any[]) {
  const genreOverlap = overlapCount(a.top_genres ?? [], topGenres);
  if (genreOverlap < 2) continue;
  genrePoolNames.add(a.name);
  bump(a.name, genreOverlap * 3);
}

if (genrePoolNames.size > 0) {
  const [tropeBooks, toneBooks] = await Promise.all([
    topTropes.length
      ? supabaseClient.from('books').select('authors, tropes').overlaps('tropes', topTropes).limit(200)
      : { data: [] },
    topTones.length
      ? supabaseClient.from('books').select('authors, tone').overlaps('tone', topTones).limit(200)
      : { data: [] },
  ]);

  for (const b of (tropeBooks.data ?? []) as any[])
    for (const name of b.authors ?? [])
      if (genrePoolNames.has(name)) bump(name, overlapCount(b.tropes ?? [], topTropes) * 2);
  for (const b of (toneBooks.data ?? []) as any[])
    for (const name of b.authors ?? [])
      if (genrePoolNames.has(name)) bump(name, overlapCount(b.tone ?? [], topTones) * 1);
}

const topNames = [...scores.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([name]) => name);

const { data: simData } = topNames.length
  ? await supabaseClient.from('authors').select('name, slug, photo_url, book_count').in('name', topNames).gte('book_count', 8)
  : { data: [] };

// Apply popularity weight: multiply raw score by log(book_count) so prolific authors rank higher
const simMeta = new Map(((simData ?? []) as unknown as SimilarAuthorRow[]).map((a) => [a.name, a]));
const weightedTopNames = topNames
  .map((n) => {
    const meta = simMeta.get(n);
    if (!meta) return null;
    const rawScore = scores.get(n) ?? 0;
    const popularityBonus = Math.log(Math.max(meta.book_count ?? 1, 1)) * 0.5;
    return { meta, score: rawScore + popularityBonus };
  })
  .filter((x): x is { meta: SimilarAuthorRow; score: number } => !!x)
  .sort((a, b) => b.score - a.score);

const similarAuthors = weightedTopNames.map((x) => x.meta).slice(0, 5);

// Resolve *Book Title* patterns in best_starting_point to internal links
let bestStartingPointHtml: string | null = null;
if (profile?.best_starting_point) {
  const raw = profile.best_starting_point;
  const italicTitles = [...raw.matchAll(/\*([^*]+)\*/g)].map(m => m[1]);
  const uniqueTitles = [...new Set(italicTitles)];
  const slugMap = new Map<string, string>();
  if (uniqueTitles.length) {
    const { data: titleData } = await supabaseClient
      .from('books')
      .select('title, slug')
      .in('title', uniqueTitles);
    for (const b of titleData ?? []) if (b.slug) slugMap.set(b.title, b.slug);
  }
  bestStartingPointHtml = raw.replace(/\*([^*]+)\*/g, (_match, title) => {
    const bookSlug = slugMap.get(title);
    if (bookSlug) return `<a href="/books/${bookSlug}/" class="text-purple-700 hover:underline font-medium">${title}</a>`;
    const roSlug = READING_ORDER_MAP[title];
    if (roSlug) return `<a href="/reading-orders/${roSlug}/" class="text-purple-700 hover:underline font-medium">${title}</a>`;
    return `<em>${title}</em>`;
  });
}

const metaDescription = profile?.writing_style
  ? profile.writing_style.slice(0, 160)
  : cleanBio
  ? cleanBio.slice(0, 160)
  : `Explore all ${books.length} fantasy books by ${authorName} on The Grimoire - genres, tropes and darkness ratings.`;

// Fun stats
const topRatedBook = sortedBooks[0] ?? null;
const darkestBook = [...books]
  .filter(b => b.darkness_level != null)
  .sort((a, b) => (b.darkness_level ?? 0) - (a.darkness_level ?? 0) || (a.series_number ?? 999) - (b.series_number ?? 999))[0] ?? null;
const longestSeries = seriesList[0] ?? null;

// Hero reading order: first series that has a curated guide
const heroReadingOrder = seriesList.find(s => s.readingOrderSlug) ?? null;

const GENRE_SLUG_MAP: Record<string, string> = {
  'Epic Fantasy': 'epic', 'High Fantasy': 'epic',
  'Dark Fantasy': 'dark', 'Horror Fantasy': 'dark',
  'Urban Fantasy': 'urban', 'Contemporary Fantasy': 'urban',
  'Grimdark': 'grimdark', 'War Fantasy': 'grimdark',
  'Mythic Fantasy': 'mythology', 'Folklore Fantasy': 'mythology', 'Mythology': 'mythology',
  'Cozy Fantasy': 'cozy', 'Humorous Fantasy': 'cozy',
  'LitRPG': 'litrpg', 'Progression Fantasy': 'litrpg',
  'Science Fantasy': 'science-fantasy', 'Steampunk Fantasy': 'science-fantasy',
  'Romantasy': 'romantasy', 'Romantic Fantasy': 'romantasy',
  'Sword & Sorcery': 'swords', 'Swords & Sorcery': 'swords',
  'Historical Fantasy': 'historical',
  'Academy Fantasy': 'academy', 'School Fantasy': 'academy',
};

const TONE_SLUG_MAP: Record<string, string> = {
  'Grimdark': 'grimdark',
  'Humorous': 'cozy',
  'Humorous Fantasy': 'cozy',
};

const SITE = 'https://thegrimoire.co';
const authorJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: authorName,
  url: `${SITE}/authors/${slug}/`,
  ...((profile?.writing_style ?? cleanBio) ? { description: (profile?.writing_style ?? cleanBio)!.slice(0, 300) } : {}),
  ...(profile?.photo_url ? { image: profile.photo_url } : {}),
  sameAs: [
    profile?.website ?? null,
    profile?.twitter ? `https://twitter.com/${profile.twitter}` : null,
    profile?.goodreads ?? null,
  ].filter(Boolean),
});
const authorBreadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Authors', item: `${SITE}/authors/` },
    { '@type': 'ListItem', position: 2, name: authorName, item: `${SITE}/authors/${slug}/` },
  ],
});
---

<Layout title={`${authorName} | Fantasy Books & Series | The Grimoire`} description={metaDescription} image={profile?.photo_url || undefined} noindex={books.length < 3 || !profile?.writing_style}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={authorJsonLd} />
    <script is:inline type="application/ld+json" set:html={authorBreadcrumbJsonLd} />
  </Fragment>
  <!-- Breadcrumb -->
  <nav class="text-sm text-zinc-500 mb-6">
    <a href="/authors/" class="hover:underline">Authors</a>
    <span class="mx-2">›</span>
    <span class="text-zinc-700">{authorName}</span>
  </nav>

  <!-- Author hero -->
  <div class="flex flex-row gap-6 items-center mb-10 rounded-2xl bg-linear-to-br from-slate-50 via-white to-zinc-50 border border-zinc-100 p-6 shadow-sm">
    {profile?.photo_url ? (
      <img
        src={profile.photo_url}
        alt={authorName}
        class="shrink-0 w-16 h-16 sm:w-24 sm:h-24 rounded-2xl object-cover shadow-lg"
        onerror="this.style.display='none'"
      />
    ) : (
      <div class={`shrink-0 w-16 h-16 sm:w-24 sm:h-24 rounded-2xl bg-linear-to-br ${avatarGradient} flex items-center justify-center text-white font-bold text-3xl sm:text-4xl shadow-lg`}>
        {authorName[0].toUpperCase()}
      </div>
    )}

    <div class="flex-1">
      <h1 class="text-3xl font-bold tracking-tight leading-tight bg-linear-to-br from-zinc-900 via-zinc-800 to-zinc-600 bg-clip-text text-transparent">{authorName}</h1>

      <div class="mt-3 hidden sm:flex flex-wrap gap-4 text-sm text-zinc-600">
        <span>
          <span class="font-semibold text-zinc-900">{books.length}</span> {books.length === 1 ? 'book' : 'books'}
        </span>
        {overallRatingNum && (
          <span class="inline-flex items-center gap-1.5">
            <span class="relative inline-block font-semibold text-zinc-900" style={`letter-spacing:0.05em;line-height:1`}>
              <span style="color:#d4d4d8">★★★★★</span>
              <span class="absolute inset-0 overflow-hidden whitespace-nowrap" style={`width:${(overallRatingNum/5*100).toFixed(2)}%;color:#f59e0b`}>★★★★★</span>
            </span>
            <span class="font-semibold text-zinc-900">{overallRating}</span> avg rating
          </span>
        )}
        {seriesList.length > 0 && (
          <span>
            <span class="font-semibold text-zinc-900">{seriesList.length}</span> {seriesList.length === 1 ? 'series' : 'series'}
          </span>
        )}
      </div>

      <div class="mt-3 hidden sm:flex flex-wrap gap-3 text-sm">
        {(universeGuide || heroReadingOrder) && (
          <a href={`/reading-orders/${universeGuide ? universeGuide.slug : heroReadingOrder!.readingOrderSlug}/`} class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-600 text-white font-medium hover:bg-purple-700 transition-colors text-xs">
            📖 {universeGuide ? 'Universe Guide' : 'Reading Order'}
          </a>
        )}
        {profile?.website && (
          <a href={profile.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-zinc-500 hover:text-zinc-900 transition-colors">
            🌐 Website
          </a>
        )}
        {profile?.twitter && (
          <a href={`https://twitter.com/${profile.twitter}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-zinc-500 hover:text-zinc-900 transition-colors">
            𝕏 @{profile.twitter}
          </a>
        )}
        {profile?.goodreads && (
          <a href={profile.goodreads} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-zinc-500 hover:text-zinc-900 transition-colors">
            📚 Goodreads
          </a>
        )}
      </div>

    </div>
  </div>

  {(topGenres.length > 0 || topTropes.length > 0 || topTones.length > 0) && (
    <div class="mb-6 flex flex-wrap gap-2">
      {topGenres.map((g) => {
        const gSlug = GENRE_SLUG_MAP[g];
        return gSlug ? (
          <a href={`/fantasy/${gSlug}/`} class="px-2 py-0.5 sm:px-3 sm:py-1 bg-purple-100 text-purple-800 rounded-full text-xs sm:text-sm font-medium hover:bg-purple-200 transition-colors">{g}</a>
        ) : (
          <span class="px-2 py-0.5 sm:px-3 sm:py-1 bg-purple-100 text-purple-800 rounded-full text-xs sm:text-sm font-medium">{g}</span>
        );
      })}
      {topTropes.map((t) => {
        const tSlug = t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/, '');
        return (
          <a href={`/tropes/${tSlug}/`} class="px-2 py-0.5 sm:px-3 sm:py-1 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full text-xs sm:text-sm hover:bg-indigo-100 transition-colors">{t}</a>
        );
      })}
      {topTones.map((t) => {
        const toneSlug = TONE_SLUG_MAP[t];
        return toneSlug ? (
          <a href={`/fantasy/${toneSlug}/`} class="px-2 py-0.5 sm:px-3 sm:py-1 bg-zinc-100 text-zinc-700 rounded-full text-xs sm:text-sm hover:bg-zinc-200 transition-colors">{t}</a>
        ) : (
          <span class="px-2 py-0.5 sm:px-3 sm:py-1 bg-zinc-100 text-zinc-700 rounded-full text-xs sm:text-sm">{t}</span>
        );
      })}
    </div>
  )}

  {(darkestBook || longestSeries || topRatedBook) && (
    <div class="mb-6 flex flex-wrap gap-3">
      {topRatedBook?.avg_rating != null && topRatedBook.slug && (
        <a href={`/books/${topRatedBook.slug}/`} class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-amber-50 border border-amber-200 text-xs text-amber-800 hover:bg-amber-100 transition-colors">
          <span class="text-amber-500">★</span> Top rated: <span class="font-medium">{topRatedBook.title}</span> ({topRatedBook.avg_rating.toFixed(2)})
        </a>
      )}
      {darkestBook?.slug && (
        <a href={`/books/${darkestBook.slug}/`} class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-zinc-100 border border-zinc-300 text-xs text-zinc-700 hover:bg-zinc-200 transition-colors">
          {DARKNESS_CANDLES[darkestBook.darkness_level ?? 1]} Darkest: <span class="font-medium">{darkestBook.title}</span>
        </a>
      )}
      {longestSeries && longestSeries.bookCount > 2 && (
        longestSeries.readingOrderSlug ? (
          <a href={`/reading-orders/${longestSeries.readingOrderSlug}/`} class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-indigo-50 border border-indigo-200 text-xs text-indigo-800 hover:bg-indigo-100 transition-colors">
            📚 Longest series: <span class="font-medium">{longestSeries.name}</span> ({longestSeries.bookCount} books)
          </a>
        ) : longestSeries.firstBookSlug ? (
          <a href={`/books/${longestSeries.firstBookSlug}/`} class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-indigo-50 border border-indigo-200 text-xs text-indigo-800 hover:bg-indigo-100 transition-colors">
            📚 Longest series: <span class="font-medium">{longestSeries.name}</span> ({longestSeries.bookCount} books)
          </a>
        ) : (
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-indigo-50 border border-indigo-200 text-xs text-indigo-800">
            📚 Longest series: <span class="font-medium">{longestSeries.name}</span> ({longestSeries.bookCount} books)
          </span>
        )
      )}
    </div>
  )}

  {cleanBio && (
    <div class="mb-6 max-w-3xl">
      <p class="text-zinc-600 leading-relaxed" set:html={cleanBio} />
    </div>
  )}

  {profile?.writing_style && (
    <div class="mb-6 max-w-3xl">
      <h2 class="text-base font-semibold text-zinc-900 mb-2">Why Read {authorName}</h2>
      <p class="text-zinc-600 leading-relaxed">{profile.writing_style}</p>
    </div>
  )}

  {bestStartingPointHtml && (
    <div class="mb-10 max-w-3xl rounded-xl border border-purple-200 bg-purple-50/40 px-5 py-4">
      <p class="text-xs font-semibold text-purple-600 uppercase tracking-wide mb-1">Where to Start</p>
      <p class="text-sm text-zinc-700 leading-relaxed" set:html={bestStartingPointHtml} />
    </div>
  )}

  <!-- Series section -->
  {seriesList.length > 0 && (
    <div class="mb-12">
      <h2 class="text-xl font-semibold mb-4">Series by {authorName}</h2>
      <div class="flex flex-wrap gap-4">
        {seriesList.map((s) => {
          const seriesBooks = sortedBooks
            .filter((b) => b.series === s.name)
            .sort((a, b) => (a.series_number ?? 999) - (b.series_number ?? 999));

          const seriesRatings = seriesBooks.map((b) => b.avg_rating).filter((r): r is number => r != null);
          const seriesAvgRatingNum = seriesRatings.length
            ? seriesRatings.reduce((a, b) => a + b, 0) / seriesRatings.length
            : null;
          const seriesAvgRating = seriesAvgRatingNum?.toFixed(2) ?? null;

          return (
            <div class="rounded-xl border border-zinc-200 bg-white px-5 py-4 shadow-sm hover:border-purple-300 hover:shadow-[0_0_20px_rgba(147,51,234,0.1)] transition-all">
              <!-- Series header row -->
              <div class="flex items-center justify-between gap-4 mb-3">
                <div class="min-w-0">
                  <p class="font-semibold text-zinc-900">{s.name}</p>
                  <p class="text-xs text-zinc-400 mt-0.5">
                    {s.bookCount} {s.bookCount === 1 ? 'book' : 'books'}
                    {seriesAvgRatingNum && (
                      <span class="ml-2 inline-flex items-center gap-1">
                        ·
                        <span class="relative inline-block" style="letter-spacing:0.05em;line-height:1">
                          <span style="color:#d4d4d8">★★★★★</span>
                          <span class="absolute inset-0 overflow-hidden whitespace-nowrap" style={`width:${(seriesAvgRatingNum / 5 * 100).toFixed(2)}%;color:#f59e0b`}>★★★★★</span>
                        </span>
                        {seriesAvgRating}
                      </span>
                    )}
                  </p>
                </div>
                {s.readingOrderSlug ? (
                  <a
                    href={`/reading-orders/${s.readingOrderSlug}/`}
                    class="shrink-0 text-xs font-medium text-purple-600 bg-purple-50 border border-purple-200 px-2.5 py-1 rounded-full whitespace-nowrap hover:bg-purple-100 transition-colors"
                  >
                    Reading order →
                  </a>
                ) : seriesBooks.length > 1 ? (
                  <a href={`/reading-orders/${s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/, '')}/`} class="shrink-0 text-xs font-medium text-zinc-400 bg-zinc-50 border border-zinc-200 px-2.5 py-1 rounded-full whitespace-nowrap hover:bg-zinc-100 transition-colors">Explore</a>
                ) : null}
              </div>

              <!-- Book covers row -->
              <div class="flex flex-wrap gap-3">
                {seriesBooks.map((book) => (
                  book.slug ? (
                    <a href={`/books/${book.slug}/`} class="group flex flex-col items-center gap-1 w-14">
                      <div class="w-14 h-20 rounded-lg overflow-hidden border border-zinc-200 bg-zinc-100 shadow-sm group-hover:shadow-md group-hover:scale-[1.04] transition-all">
                        {book.cover_url ? (
                          <img src={normalizeCoverUrl(book.cover_url) ?? '/grimplaceholder.png'} alt={book.title} class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/grimplaceholder.png';" />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center text-zinc-300 text-lg">📖</div>
                        )}
                      </div>
                      <p class="text-[10px] text-zinc-500 text-center leading-tight line-clamp-2 group-hover:text-purple-700 transition-colors w-full">{book.title}</p>
                    </a>
                  ) : (
                    <div class="flex flex-col items-center gap-1 w-14">
                      <div class="w-14 h-20 rounded-lg overflow-hidden border border-zinc-200 bg-zinc-100">
                        {book.cover_url ? (
                          <img src={normalizeCoverUrl(book.cover_url) ?? '/grimplaceholder.png'} alt={book.title} class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/grimplaceholder.png';" />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center text-zinc-300 text-lg">📖</div>
                        )}
                      </div>
                      <p class="text-[10px] text-zinc-500 text-center leading-tight line-clamp-2 w-full">{book.title}</p>
                    </div>
                  )
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  <!-- Similar Authors -->
  {similarAuthors.length > 0 && (
    <div class="mb-10">
      <h2 class="text-xl font-semibold mb-4">Similar Authors</h2>
      <div class="grid gap-3 grid-cols-5">
        {similarAuthors.map((a) => {
          let ah = 0;
          for (const c of a.name) ah = (ah * 31 + c.charCodeAt(0)) & 0xff;
          const aGradient = palette[ah % palette.length];
          const photo = a.photo_url;
          return (
            <a
              href={`/authors/${a.slug}/`}
              class="flex flex-col sm:flex-row items-center gap-1 sm:gap-3 rounded-xl border border-zinc-200 bg-white p-2 sm:px-3 sm:py-2.5 hover:border-purple-300 hover:shadow-[0_0_16px_rgba(147,51,234,0.1)] hover:-translate-y-0.5 transition-all group"
            >
              {photo ? (
                <>
                  <img
                    src={photo}
                    alt={a.name}
                    class="shrink-0 w-10 h-10 rounded-full object-cover shadow-sm"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                  />
                  <div class={`shrink-0 w-10 h-10 rounded-full bg-linear-to-br ${aGradient} items-center justify-center text-white font-bold text-base hidden`}>
                    {a.name[0].toUpperCase()}
                  </div>
                </>
              ) : (
                <div class={`shrink-0 w-10 h-10 rounded-full bg-linear-to-br ${aGradient} flex items-center justify-center text-white font-bold text-base`}>
                  {a.name[0].toUpperCase()}
                </div>
              )}
              <div class="min-w-0 text-center sm:text-left">
                <p class="font-medium text-xs sm:text-sm text-zinc-900 group-hover:text-purple-700 transition-colors leading-snug line-clamp-2">{a.name}</p>
                <p class="hidden sm:block text-xs text-zinc-400 mt-0.5">{a.book_count ?? 0} {(a.book_count ?? 0) === 1 ? 'book' : 'books'}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}

  <!-- Books list -->
  <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
    <h2 class="text-xl font-semibold">Books by {authorName}</h2>
    <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
      <div class="relative flex-1 sm:flex-none">
        <input id="books-search" type="text" placeholder="Search titles…" autocomplete="off"
          class="w-full sm:w-64 rounded-lg border border-zinc-300 px-3 py-1 pr-7 text-sm focus:border-purple-400 focus:outline-none focus:ring-1 focus:ring-purple-200" />
        <span class="absolute right-2 top-1/2 -translate-y-1/2 text-zinc-400 text-xs pointer-events-none">🔍</span>
      </div>
      <span class="hidden sm:inline text-sm text-zinc-400">{books.length} total</span>
      <div class="flex gap-1">
        {[
          { key: 'rating', label: '★ Rating' },
          { key: 'newest', label: 'Newest' },
          { key: 'oldest', label: 'Oldest' },
        ].map(({ key, label }) => (
          <button
            data-sort={key}
            class={`sort-btn px-3 py-1 rounded-full text-xs font-medium border transition-colors ${key === 'rating' ? 'bg-purple-600 text-white border-purple-600' : 'border-zinc-300 text-zinc-600 hover:bg-zinc-50'}`}
          >
            {label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div id="books-grid" class="space-y-3">
    {sortedBooks.map((book, i) => {
      const href = book.slug ? `/books/${book.slug}/` : null;
      const dl   = (book.darkness_level != null && book.darkness_level >= 1) ? book.darkness_level : null;
      const synopsis = (book as any).synopsis as string | null ?? null;
      const shortSynopsis = synopsis ? synopsis.slice(0, 120).trimEnd() : null;
      const hasTruncated = synopsis && synopsis.length > 120;
      const cardId = `author-book-${i}`;

      const inner = (
        <div class="flex items-start gap-4 rounded-xl border border-zinc-200 bg-white px-4 py-3 hover:border-purple-300 hover:shadow-[0_0_16px_rgba(147,51,234,0.1)] hover:-translate-y-0.5 transition-all group">
          <!-- Cover -->
          <div class="shrink-0 w-10 h-14 rounded overflow-hidden bg-zinc-100 border border-zinc-200">
            {book.cover_url ? (
              <img src={normalizeCoverUrl(book.cover_url) ?? '/grimplaceholder.png'} alt={book.title} class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/grimplaceholder.png';" />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-zinc-300">📖</div>
            )}
          </div>

          <!-- Info -->
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors leading-snug">
                  {book.title}
                </p>
                {book.series && (
                  <p class="text-xs text-indigo-600 mt-0.5">
                    {book.series}{book.series_number != null ? ` #${book.series_number}` : ''}
                  </p>
                )}
              </div>
              {book.avg_rating != null && (
                <span class="shrink-0 text-sm font-semibold text-amber-500 whitespace-nowrap">★ {book.avg_rating.toFixed(2)}</span>
              )}
            </div>

            {shortSynopsis && (
              <p class="mt-1.5 text-xs text-zinc-500 leading-relaxed">
                <span data-short={cardId}>{shortSynopsis}{hasTruncated ? '…' : ''}</span>
                {hasTruncated && (
                  <>
                    <span data-full={cardId} class="hidden">{synopsis}</span>
                    <button data-toggle={cardId} class="ml-1 text-purple-600 hover:text-purple-800 font-medium text-xs underline-offset-2 hover:underline">read more</button>
                  </>
                )}
              </p>
            )}

            <div class="flex flex-wrap items-center gap-3 mt-1.5 text-xs text-zinc-400">
              {book.publication_year && <span>{book.publication_year}</span>}
              {book.page_count && <span>{book.page_count} pp.</span>}
              {dl && <span>{DARKNESS_CANDLES[dl]}</span>}
            </div>
          </div>
        </div>
      );

      return href ? (
        <a href={href} class="block book-card-wrap" data-index={i} data-rating={book.avg_rating ?? 0} data-year={book.publication_year ?? 0} data-title={book.title.toLowerCase()} style={i >= 10 ? 'display:none' : ''}>{inner}</a>
      ) : (
        <div class="book-card-wrap" data-index={i} data-rating={book.avg_rating ?? 0} data-year={book.publication_year ?? 0} data-title={book.title.toLowerCase()} style={i >= 10 ? 'display:none' : ''}>{inner}</div>
      );
    })}
  </div>

  <!-- Pagination -->
  {books.length > 10 && (
    <div id="books-pagination" class="mt-8 flex items-center justify-between gap-2">
      <button
        id="books-prev"
        class="px-4 py-2 rounded-lg border border-zinc-200 text-sm text-zinc-600 hover:bg-zinc-50 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
        disabled
      >← Previous</button>
      <span id="books-page-label" class="text-sm text-zinc-400"></span>
      <button
        id="books-next"
        class="px-4 py-2 rounded-lg border border-zinc-200 text-sm text-zinc-600 hover:bg-zinc-50 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
      >Next →</button>
    </div>
  )}

  <!-- CTA -->
  <div class="mt-12 border-t pt-8 text-center">
    <p class="text-zinc-600 mb-4">Looking for something similar?</p>
    <a
      href="/book-finder/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-linear-to-r from-amber-500 to-orange-500 text-white text-sm font-semibold shadow hover:shadow-md hover:scale-105 transition-all"
    >
      🔮 Find books like these
    </a>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const id = btn.dataset.toggle!;
      const shortEl = document.querySelector(`[data-short="${id}"]`)!;
      const fullEl = document.querySelector(`[data-full="${id}"]`)!;
      const nowHidden = fullEl.classList.toggle('hidden');
      shortEl.classList.toggle('hidden');
      btn.textContent = nowHidden ? 'read more' : 'read less';
    });
  });

  const PER_PAGE = 10;
  const grid = document.getElementById('books-grid')!;
  const searchInput = document.getElementById('books-search') as HTMLInputElement | null;
  const allWraps = Array.from(document.querySelectorAll<HTMLElement>('.book-card-wrap'));
  let wraps = allWraps.slice();
  const prevBtn = document.getElementById('books-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('books-next') as HTMLButtonElement | null;
  const pageLabel = document.getElementById('books-page-label');
  let page = 0;

  function render() {
    const totalPages = Math.ceil(wraps.length / PER_PAGE) || 1;
    const start = page * PER_PAGE;
    const end = start + PER_PAGE;
    allWraps.forEach((w) => { w.style.display = 'none'; });
    wraps.slice(start, end).forEach((w) => { w.style.display = ''; });
    if (pageLabel) pageLabel.textContent = `Page ${page + 1} of ${totalPages}`;
    if (prevBtn) prevBtn.disabled = page === 0;
    if (nextBtn) nextBtn.disabled = page >= totalPages - 1;
  }

  function sortAndRender(key: string) {
    const sorted = [...wraps].sort((a, b) => {
      if (key === 'newest') return Number(b.dataset.year) - Number(a.dataset.year);
      if (key === 'oldest') return Number(a.dataset.year) - Number(b.dataset.year);
      return Number(b.dataset.rating) - Number(a.dataset.rating);
    });
    sorted.forEach((el) => grid.appendChild(el));
    wraps = sorted;
    page = 0;
    render();
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      wraps = q ? allWraps.filter((w) => (w.dataset.title ?? '').includes(q)) : allWraps.slice();
      page = 0;
      render();
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((b) => {
        b.classList.remove('bg-purple-600', 'text-white', 'border-purple-600');
        b.classList.add('border-zinc-300', 'text-zinc-600');
      });
      btn.classList.add('bg-purple-600', 'text-white', 'border-purple-600');
      btn.classList.remove('border-zinc-300', 'text-zinc-600');
      sortAndRender(btn.dataset.sort!);
    });
  });

  if (prevBtn) prevBtn.addEventListener('click', () => { if (page > 0) { page--; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });
  if (nextBtn) nextBtn.addEventListener('click', () => { if (page < Math.ceil(wraps.length / PER_PAGE) - 1) { page++; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });

  render();
</script>
