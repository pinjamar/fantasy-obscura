import Layout from '../../components/Layout.astro';
import { getBooksByAuthor } from '../../lib/db/books';
import { getAuthorProfile } from '../../lib/db/authors';
import { supabaseClient } from '../../lib/supabaseClient';
import { normalizeCoverUrl } from '../../lib/covers';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/authors/');

const profile = await getAuthorProfile(slug);
if (!profile) return new Response(null, { status: 404, statusText: 'Not Found' });
const authorName = profile.name;

const books = await getBooksByAuthor(authorName);

// Sort books by avg_rating desc (nulls last)
const sortedBooks = [...books].sort((a, b) => {
  if (a.avg_rating == null && b.avg_rating == null) return 0;
  if (a.avg_rating == null) return 1;
  if (b.avg_rating == null) return -1;
  return b.avg_rating - a.avg_rating;
});

// Aggregate stats from books
const allSubgenres = books.flatMap((b) => b.subgenres ?? []);
const allTropes   = books.flatMap((b) => b.tropes ?? []);
const allTones    = books.flatMap((b) => b.tone ?? []);

function topN(arr: string[], n: number): string[] {
  const counts = new Map<string, number>();
  for (const item of arr) counts.set(item, (counts.get(item) ?? 0) + 1);
  return [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, n).map(([v]) => v);
}

const topGenres = topN(allSubgenres, 3);
const topTropes = topN(allTropes, 6);
const topTones  = topN(allTones, 4);

const ratingsArr = books.map((b) => b.avg_rating).filter((r): r is number => r != null);
const overallRatingNum = ratingsArr.length
  ? ratingsArr.reduce((a, b) => a + b, 0) / ratingsArr.length
  : null;
const overallRating = overallRatingNum?.toFixed(2) ?? null;

// Build series list from this author's books
type SeriesEntry = {
  name: string;
  bookCount: number;
  readingOrderSlug: string | null;
  firstBookSlug: string | null;
};

