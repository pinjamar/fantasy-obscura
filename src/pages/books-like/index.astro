---
import Layout from '../../components/Layout.astro'
import { BOOKS_LIKE, darknessCandles, getHeat } from '../../data/books-like'
import { supabaseClient } from '../../lib/supabaseClient'
import BooksLikeMe from '../../components/BooksLikeMe'

// Fetch DB tropes for all guide source books in one query
// Use title-based slugs (how books are stored in DB), not guide short-IDs like 'acotar'
const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const toDbSlug = (s: string) => toSlug(s.replace(/\s*\([^)]*\)/g, '').trim())
const getSourceSlug = (e: typeof BOOKS_LIKE[0]) => e.source.db_slug ?? toDbSlug(e.source.title)
const slugs = BOOKS_LIKE.map((e) => getSourceSlug(e))
const { data: dbBooks } = await supabaseClient
  .from('books')
  .select('slug, tropes, cover_url, darkness_level, heat_level')
  .in('slug', slugs)
const dbTropesMap = new Map<string, string[]>(
  (dbBooks ?? []).map((b) => [b.slug, b.tropes ?? []])
)
const dbCoverMap = new Map<string, string>(
  (dbBooks ?? []).filter((b) => b.cover_url && !b.cover_url.includes('archive.org') && !b.cover_url.includes('covers.openlibrary.org')).map((b) => [b.slug, b.cover_url])
)
const dbDarknessMap = new Map<string, number>(
  (dbBooks ?? []).filter((b: any) => b.darkness_level != null).map((b: any) => [b.slug, b.darkness_level])
)
const dbHeatMap = new Map<string, string>(
  (dbBooks ?? []).filter((b: any) => b.heat_level).map((b: any) => [b.slug, b.heat_level])
)
---

<Layout
  title="Books Like... Fantasy Recommendations | The Grimoire"
  description="Curated 'Books Like X' guides for fantasy readers. Darkness ratings, honest caveats, and 5–8 picks that actually match — not algorithm results."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">{JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Books Like... Fantasy Recommendations',
      description: "Curated 'Books Like X' guides for fantasy readers. Darkness ratings, honest caveats, and picks that actually match.",
      url: 'https://thegrimoire.co/books-like/',
    })}</script>
  </Fragment>
  <!-- Banner -->
  <div class="relative rounded-2xl overflow-hidden mb-8 border border-zinc-200">
    <picture>
      <source type="image/avif" srcset="/images/banners/books-like-banner-400.avif 400w, /images/banners/books-like-banner-800.avif 800w" sizes="(min-width: 1024px) 800px, 100vw" />
      <source type="image/webp" srcset="/images/banners/books-like-banner-400.webp 400w, /images/banners/books-like-banner-800.webp 800w" sizes="(min-width: 1024px) 800px, 100vw" />
      <img src="/images/banners/books-like-banner-800.webp" alt="" width="800" height="400" loading="eager" decoding="async" class="w-full aspect-3/1 object-cover" />
    </picture>
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/50 to-black/10" />
    <div class="absolute inset-0 px-6 py-6 flex flex-col justify-end">
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-white">Books Like...</h1>
      <p class="hidden sm:block mt-2 max-w-2xl text-white/80 text-sm leading-relaxed">
        Every guide works the same way: a <strong class="text-white">darkness rating</strong> on every recommendation, an honest note on what
        actually matches and what doesn't, and <strong class="text-white">5–8 books</strong> that genuinely capture what made the original work —
        not just books in the same genre. If the pacing is different, the tone is darker, or the magic system is nothing alike, <em>we say so</em>.
      </p>
    </div>
  </div>

  <div>

    <!-- AI recommendations -->
    <BooksLikeMe client:load />

    <!-- Available entries -->
    {BOOKS_LIKE.length > 0 && (
      <section class="mt-10">
        <h2 class="text-sm font-semibold text-zinc-400 uppercase tracking-widest mb-4">Available Guides for Book Likes</h2>

        <div class="relative mb-5">
          <input
            id="books-like-search"
            type="text"
            placeholder="Search by title, author or trope..."
            class="w-full rounded-xl border border-zinc-300 px-4 py-2.5 pr-10 text-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200"
            autocomplete="off"
          />
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400 pointer-events-none">🔍</span>
        </div>
        <p id="books-like-empty" class="hidden text-sm text-zinc-400 mb-4">No guides match your search.</p>

        <div id="books-like-list" class="grid gap-3 sm:grid-cols-2">
          {BOOKS_LIKE.map((entry, i) => {
            const titleSlug = toSlug(entry.source.title)
            const tropes = dbTropesMap.get(titleSlug)?.length
              ? dbTropesMap.get(titleSlug)!
              : entry.source.tropes
            return (
            <a
              href={`/books-like/${entry.slug}/`}
              data-search={`${entry.source.title} ${entry.source.author} ${entry.source.series ?? ''} ${tropes.join(' ')}`.toLowerCase()}
              data-index={i}
              class="flex items-center gap-4 p-4 rounded-2xl border border-zinc-200 bg-white hover:border-zinc-300 hover:bg-zinc-50 transition-colors group"
            >
              <div class="relative w-12 aspect-2/3 rounded-lg shadow overflow-hidden bg-linear-to-br from-purple-100 to-blue-100 shrink-0">
                <img
                  src={dbCoverMap.get(getSourceSlug(entry)) || entry.source.cover_url || '/grimplaceholder.png'}
                  alt={entry.source.title}
                  class="absolute inset-0 w-full h-full object-cover"
                  onerror="this.onerror=null;this.src='/grimplaceholder.png';"
                />
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors">
                  {entry.source.title}
                </p>
                {entry.source.series && entry.source.series_number != null && (
                  <p class="text-xs text-indigo-600 mt-0.5">{entry.source.series} #{entry.source.series_number}</p>
                )}
                <p class="text-sm text-zinc-500 mt-0.5">
                  {entry.source.author} · {darknessCandles(dbDarknessMap.get(getSourceSlug(entry)) ?? entry.source.darkness_level)}{(() => { const h = getHeat(dbHeatMap.get(getSourceSlug(entry)) ?? entry.source.heat_level); return h ? ` ${h.flames}` : '' })()}
                </p>
                <div class="hidden sm:flex mt-1.5 flex-wrap gap-1">
                  {tropes.slice(0, 3).map((t) => (
                    <span class="text-xs px-2 py-0.5 bg-indigo-50 text-indigo-600 border border-indigo-100 rounded-full">{t}</span>
                  ))}
                </div>
                <p class="text-xs text-zinc-400 mt-1.5">{entry.aspects.reduce((sum, a) => sum + a.recs.length, 0)} book recommendations</p>
              </div>
              <span class="text-zinc-400 group-hover:text-zinc-600 transition-colors shrink-0">›</span>
            </a>
            )
          })}
        </div>

        <!-- Pagination -->
        <div id="books-like-pagination" class="mt-6 flex items-center justify-between gap-2">
          <button
            id="bl-prev"
            class="px-4 py-2 rounded-lg border border-zinc-200 text-sm text-zinc-600 hover:bg-zinc-50 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
            disabled
          >← Previous</button>
          <span id="bl-page-label" class="text-sm text-zinc-400"></span>
          <button
            id="bl-next"
            class="px-4 py-2 rounded-lg border border-zinc-200 text-sm text-zinc-600 hover:bg-zinc-50 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
          >Next →</button>
        </div>
      </section>
    )}

    <!-- Suggest / coming soon -->
    <section class="mt-12">
      <h2 class="text-sm font-semibold text-zinc-400 uppercase tracking-widest mb-4">More coming soon</h2>
      <div class="flex flex-wrap gap-2">
        {[
          'The Witcher', 'The Night Circus', 'Good Omens',
          'The Lies of Locke Lamora', 'An Ember in the Ashes', 'The Cruel Prince',
          'The Bear and the Nightingale', 'The House in the Cerulean Sea',
          'Jonathan Strange & Mr Norrell', 'The Magicians',
        ].map((title) => (
          <span class="rounded-full border border-dashed border-zinc-300 px-4 py-1.5 text-sm text-zinc-400">
            Books like {title}
          </span>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div class="mt-12 rounded-2xl bg-violet-50 border border-violet-200 p-6">
      <h2 class="font-semibold text-violet-900 mb-1">Can't find your book?</h2>
      <p class="text-sm text-zinc-600 mb-4">Use the trope filter to build your own recommendations from scratch.</p>
      <a href="/craft/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold transition-colors">
        🔮 Find My Next Book
      </a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var PER_PAGE = 10;
      var input = document.getElementById('books-like-search');
      var empty = document.getElementById('books-like-empty');
      var pagination = document.getElementById('books-like-pagination');
      var prevBtn = document.getElementById('bl-prev');
      var nextBtn = document.getElementById('bl-next');
      var pageLabel = document.getElementById('bl-page-label');
      var allCards = Array.from(document.querySelectorAll('#books-like-list a[data-search]'));
      var currentPage = 0;
      var filteredCards = allCards.slice();

      function render() {
        var totalPages = Math.ceil(filteredCards.length / PER_PAGE) || 1;
        var start = currentPage * PER_PAGE;
        var end = start + PER_PAGE;

        allCards.forEach(function (card) { card.style.display = 'none'; });
        filteredCards.slice(start, end).forEach(function (card) { card.style.display = ''; });

        if (empty) empty.classList.toggle('hidden', filteredCards.length > 0 || !input.value.trim());
        if (pageLabel) pageLabel.textContent = 'Page ' + (currentPage + 1) + ' of ' + totalPages;
        if (prevBtn) prevBtn.disabled = currentPage === 0;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
        if (pagination) pagination.style.display = filteredCards.length <= PER_PAGE ? 'none' : '';
      }

      if (input) {
        input.addEventListener('input', function () {
          var q = input.value.toLowerCase().trim();
          filteredCards = q
            ? allCards.filter(function (c) { return (c.getAttribute('data-search') || '').includes(q); })
            : allCards.slice();
          currentPage = 0;
          render();
        });
      }

      if (prevBtn) prevBtn.addEventListener('click', function () { if (currentPage > 0) { currentPage--; render(); } });
      if (nextBtn) nextBtn.addEventListener('click', function () {
        var totalPages = Math.ceil(filteredCards.length / PER_PAGE);
        if (currentPage < totalPages - 1) { currentPage++; render(); }
      });

      render();
    });
  </script>
</Layout>
