---
import Layout from '../../components/Layout.astro';
---

<Layout
  title="Books Like... | Fantasy Obscura"
  description="Find books similar to your favorites."
>
  <div class="max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight">Books like...</h1>
    <p class="mt-4 text-lg text-zinc-600">
      Enter a book you love, and we'll find similar reads for you.
    </p>

    <div class="mt-8">
      <div class="relative">
        <input
          type="text"
          placeholder="e.g. The Name of the Wind, Mistborn, ACOTAR..."
          class="w-full rounded-lg border border-zinc-300 px-4 py-3 text-lg focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <button class="absolute right-2 top-2 rounded-md bg-blue-600 px-6 py-2 text-white hover:bg-blue-700 transition-colors">
          Find Books
        </button>
      </div>
      <p class="mt-2 text-sm text-zinc-500">
        Currently supports 10,000+ fantasy and sci-fi books
      </p>
    </div>

    <!-- Mockup results section -->
    <div class="mt-12">
      <div class="rounded-lg border-2 border-dashed border-zinc-300 bg-zinc-50 p-8 text-center">
        <svg class="mx-auto h-16 w-16 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <p class="mt-4 text-zinc-600">Your recommendations will appear here</p>
        <p class="mt-2 text-sm text-zinc-500">Try searching for a book above to get started</p>
      </div>
    </div>

    <!-- Popular searches mockup -->
    <div class="mt-10">
      <h2 class="text-lg font-semibold mb-4">Popular searches:</h2>
      <div class="flex flex-wrap gap-2">
        <button class="rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50 transition-colors">
          Books like The Name of the Wind
        </button>
        <button class="rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50 transition-colors">
          Books like ACOTAR
        </button>
        <button class="rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50 transition-colors">
          Books like Mistborn
        </button>
        <button class="rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50 transition-colors">
          Books like Six of Crows
        </button>
        <button class="rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50 transition-colors">
          Books like The Hobbit
        </button>
        <button class="rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm hover:bg-zinc-50 transition-colors">
          Books like Dune
        </button>
      </div>
    </div>

    <!-- How it works section -->
    <div class="mt-12 rounded-lg bg-blue-50 p-6">
      <h2 class="text-lg font-semibold text-blue-900 mb-3">How it works</h2>
      <ul class="space-y-2 text-sm text-zinc-700">
        <li class="flex items-start">
          <span class="text-blue-600 mr-2 mt-0.5">1.</span>
          <span>Enter the title of a fantasy or sci-fi book you enjoyed</span>
        </li>
        <li class="flex items-start">
          <span class="text-blue-600 mr-2 mt-0.5">2.</span>
          <span>Our algorithm analyzes themes, tone, pacing, and reader preferences</span>
        </li>
        <li class="flex items-start">
          <span class="text-blue-600 mr-2 mt-0.5">3.</span>
          <span>Get personalized recommendations with similarity scores</span>
        </li>
      </ul>
    </div>
  </div>
</Layout>
