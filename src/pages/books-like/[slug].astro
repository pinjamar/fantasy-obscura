---
import Layout from '../../components/Layout.astro'
import { BOOKS_LIKE, getBooksLikeEntry, getDarkness, darknessCandles, getHeat } from '../../data/books-like'
import { READING_ORDERS } from '../../data/reading-orders'
import { supabaseClient } from '../../lib/supabaseClient'

const { slug } = Astro.params
if (!slug) return Astro.redirect('/books-like/')

const entry = getBooksLikeEntry(slug)
if (!entry) return new Response(null, { status: 404, statusText: 'Not Found' })

const { source, aspects, related } = entry

const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')

// Auto-fill related guides up to 6 total, scored by trope overlap + darkness proximity
const RELATED_TARGET = 7
const manualRelatedSlugs = new Set(related.map(r => r.slug))
const sourceTropesSet = new Set(source.tropes)
const autoRelated = BOOKS_LIKE
  .filter(e => e.slug !== slug && !manualRelatedSlugs.has(e.slug))
  .map(e => {
    const tropeOverlap = e.source.tropes.filter(t => sourceTropesSet.has(t)).length
    const darknessDiff = Math.abs((e.source.darkness_level ?? 3) - (source.darkness_level ?? 3))
    return { slug: e.slug, title: `Books Like ${e.source.title}`, score: tropeOverlap * 3 - darknessDiff }
  })
  .filter(e => e.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, Math.max(0, RELATED_TARGET - related.length))
const allRelated = [...related, ...autoRelated]
const sourceAuthors = source.author.split(/\s*&\s*/)
const authorSlug = (source as any).author_slug ?? toSlug(sourceAuthors[0])
const seriesSlug = source.series ? toSlug(source.series) : null
const sourceBookSlug = source.db_slug ?? toSlug(source.title.replace(/\s*\([^)]*\)/g, '').trim())

// Find the correct reading order slug — prefer explicit override, then curated entry, then computed series slug
const curatedReadingOrder = source.series
  ? READING_ORDERS.find(e => e.name.toLowerCase() === source.series!.toLowerCase())
  : null
const readingOrderSlug = (source as any).reading_order_slug ?? curatedReadingOrder?.slug ?? seriesSlug

// Same resolution for rec-level series links — a naive toSlug() breaks on series names
// with apostrophes (e.g. "Ender's Saga" → "ender-s-saga" instead of the curated "enders-game").
const resolveSeriesSlug = (seriesName: string) =>
  READING_ORDERS.find(e => e.name.toLowerCase() === seriesName.toLowerCase())?.slug ?? toSlug(seriesName)


// Fetch tropes + cover + extra fields from DB for the source book
const { data: dbBook } = await supabaseClient
  .from('books')
  .select('tropes, cover_url, subgenres, content_warnings, audiobook_available, audiobook_narrator, audiobook_narrator_rating')
  .eq('slug', sourceBookSlug)
  .maybeSingle()
const sourcetropes: string[] = dbBook?.tropes?.length ? dbBook.tropes : source.tropes
const sourceSubgenres: string[] = (dbBook as any)?.subgenres ?? []
const sourceWarnings: string[] = (dbBook as any)?.content_warnings ?? []
const sourceAudiobook: boolean = (dbBook as any)?.audiobook_available ?? false

function upgradeCoverUrl(url: string | null | undefined): string {
  if (!url) return '';
  if (url.includes('archive.org')) return '';
  if (url.includes('books.google.com/books/content')) {
    const m = url.match(/[?&]id=([^&]+)/);
    if (m) return `https://books.google.com/books/publisher/content/images/frontcover/${m[1]}?fife=w400-h600`;
  }
  return url.replace(/-M\.jpg/, '-L.jpg');
}

const sourceCover: string = upgradeCoverUrl(dbBook?.cover_url || source.cover_url)

// Fetch covers for all rec books from DB (more reliable than hardcoded OpenLibrary ISBNs)
const recSlugs = aspects.flatMap((a) => a.recs.map((r) => (r as any).slug ?? toSlug(r.title)))
const allCheckSlugs = [...new Set([sourceBookSlug, ...recSlugs])]
const { data: dbRecCovers } = await supabaseClient
  .from('books')
  .select('slug, cover_url, content_warnings, audiobook_audible_url, protagonist_gender, darkness_level, heat_level')
  .in('slug', allCheckSlugs)
const dbSlugSet = new Set((dbRecCovers ?? []).map((b) => b.slug))
const dbRecCoverMap = new Map<string, string>(
  (dbRecCovers ?? []).filter((b: any) => b.cover_url && !b.cover_url.includes('archive.org')).map((b: any) => [b.slug, b.cover_url])
)
const dbWarningsMap = new Map<string, string[]>(
  (dbRecCovers ?? []).filter((b: any) => b.content_warnings?.length).map((b: any) => [b.slug, b.content_warnings])
)
const dbAudibleMap = new Map<string, string>(
  (dbRecCovers ?? []).filter((b: any) => b.audiobook_audible_url).map((b: any) => [b.slug, b.audiobook_audible_url])
)
const dbProtagonistMap = new Map<string, string>(
  (dbRecCovers ?? []).filter((b: any) => b.protagonist_gender).map((b: any) => [b.slug, b.protagonist_gender])
)
const dbDarknessMap = new Map<string, number>(
  (dbRecCovers ?? []).filter((b: any) => b.darkness_level != null).map((b: any) => [b.slug, b.darkness_level])
)
const dbHeatMap = new Map<string, string>(
  (dbRecCovers ?? []).filter((b: any) => b.heat_level).map((b: any) => [b.slug, b.heat_level])
)

const SITE = 'https://thegrimoire.co';
const allRecs = aspects.flatMap((a) => a.recs);
const pageDesc = (() => {
  const recCount = allRecs.length;
  const aspectSummary = aspects.slice(0, 2).map(a =>
    a.heading.replace(/^if you loved\s+/i, '').replace(/\.\.\.$/, '').trim()
  ).join(', ');
  return `${recCount} books like ${source.title} by ${source.author}${source.angle ? ` (${source.angle})` : ''} — grouped by what made it great: ${aspectSummary}.`;
})();
const booksLikeJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Books Like ${source.title}`,
  description: pageDesc,
  url: `${SITE}/books-like/${entry.slug}/`,
  numberOfItems: allRecs.length,
  itemListElement: allRecs.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Book',
      name: r.title,
      author: { '@type': 'Person', name: r.author },
    },
  })),
});
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Books Like...', item: `${SITE}/books-like/` },
    { '@type': 'ListItem', position: 2, name: source.title, item: `${SITE}/books-like/${entry.slug}/` },
  ],
});
---

<Layout
  title={`Books Like ${source.title}${source.angle ? `: ${source.angle}` : ''} | The Grimoire`}
  description={pageDesc}
  image={sourceCover || undefined}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={booksLikeJsonLd} />
    <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="text-sm text-zinc-400 mb-8 flex items-center gap-1.5">
    <a href="/books-like/" class="hover:text-zinc-700 transition-colors">Books Like...</a>
    <span>›</span>
    <span class="text-zinc-700 font-medium">{source.title}</span>
  </nav>

  <!-- ── HEADER ──────────────────────────────────────────────────── -->
  <div class="grid gap-8 lg:grid-cols-[200px_1fr] mb-14 rounded-2xl bg-linear-to-br from-slate-50 via-white to-zinc-50 border border-zinc-100 p-6 lg:p-8">

    <!-- Cover -->
    <div class="flex flex-col items-center lg:items-start gap-3">
      {dbSlugSet.has(sourceBookSlug)
        ? <a href={`/books/${sourceBookSlug}/`} class="relative w-full max-w-50 aspect-2/3 rounded-2xl shadow-[0_8px_40px_rgba(0,0,0,0.35)] ring-1 ring-black/10 overflow-hidden bg-linear-to-br from-purple-200 to-blue-200 block">
            <img
              src={sourceCover || '/grimplaceholder.png'}
              alt={`Cover of ${source.title}`}
              class="absolute inset-0 w-full h-full object-cover"
              onerror="this.onerror=null;this.src='/grimplaceholder.png';"
            />
          </a>
        : <div class="relative w-full max-w-50 aspect-2/3 rounded-2xl shadow-[0_8px_40px_rgba(0,0,0,0.35)] ring-1 ring-black/10 overflow-hidden bg-linear-to-br from-purple-200 to-blue-200">
            <img
              src={sourceCover || '/grimplaceholder.png'}
              alt={`Cover of ${source.title}`}
              class="absolute inset-0 w-full h-full object-cover"
              onerror="this.onerror=null;this.src='/grimplaceholder.png';"
            />
          </div>
      }
      <div class="w-full max-w-50 flex flex-col gap-2">
        <a
          href={`https://www.amazon.com/s?k=${encodeURIComponent(source.title + ' ' + source.author)}&tag=librariancura-20`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center px-2 py-1.5 rounded-lg bg-amber-400 hover:bg-amber-500 text-zinc-900 text-xs font-semibold transition-colors"
        >Amazon</a>
        {sourceAudiobook && (
          <a
            href={dbAudibleMap.get(sourceBookSlug) ?? `https://www.audible.com/search?keywords=${encodeURIComponent(source.title + ' ' + source.author)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full text-center px-2 py-1.5 rounded-lg bg-sky-100 hover:bg-sky-200 text-sky-800 text-xs font-semibold transition-colors border border-sky-200"
          >🎧 Audible</a>
        )}
      </div>
    </div>

    <!-- Title + meta -->
    <div>
      <h1 class="text-4xl font-bold tracking-tight leading-tight bg-linear-to-br from-zinc-900 via-zinc-800 to-zinc-600 bg-clip-text text-transparent">
        Books Like {dbSlugSet.has(sourceBookSlug)
          ? <a href={`/books/${sourceBookSlug}/`} class="hover:text-purple-700 transition-colors">{source.title}</a>
          : source.title}
      </h1>
      {source.series && source.series_number != null && readingOrderSlug && (
        <a href={`/reading-orders/${readingOrderSlug}/`} class="inline-block mt-1.5 text-xl text-zinc-400 font-light italic hover:text-zinc-600 transition-colors">
          {source.series} · #{source.series_number} ›
        </a>
      )}
      <p class="mt-2 text-xl text-zinc-500">by {sourceAuthors.map((a, i) => (
        <><a href={`/authors/${i === 0 ? authorSlug : toSlug(a)}/`} class="hover:text-purple-700 transition-colors">{a}</a>{i < sourceAuthors.length - 1 ? ' & ' : ''}</>
      ))}</p>

      <!-- Darkness + Heat badges -->
      {(() => {
        const srcDarkness = dbDarknessMap.get(sourceBookSlug) ?? source.darkness_level
        const srcHeat = dbHeatMap.get(sourceBookSlug) ?? source.heat_level
        const d = getDarkness(srcDarkness)
        const h = getHeat(srcHeat)
        return (
          <div class="mt-5 flex flex-wrap gap-3">
            {d ? (
              <div class="inline-flex items-center gap-3 rounded-2xl border-2 border-orange-200 bg-orange-50 px-4 py-3">
                <span class="text-xl leading-none">{d.candles}</span>
                <div>
                  <div class="font-bold text-orange-700 text-sm">Darkness {srcDarkness}/5 - {d.label}</div>
                  <div class="text-xs text-zinc-500 mt-0.5">{d.desc}</div>
                </div>
              </div>
            ) : null}
            {h ? (
              <div class="inline-flex items-center gap-3 rounded-2xl border-2 border-pink-200 bg-pink-50 px-4 py-3">
                <span class="text-xl leading-none">{h.flames}</span>
                <div>
                  <div class="font-bold text-pink-700 text-sm">Heat - {h.label}</div>
                  <div class="text-xs text-zinc-500 mt-0.5">{h.desc}</div>
                </div>
              </div>
            ) : null}
          </div>
        )
      })()}

      <!-- Subgenre chips -->
      {sourceSubgenres.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {sourceSubgenres.map((g) => (
            <span class="px-3 py-1 bg-purple-50 text-purple-700 border border-purple-200 rounded-full text-sm font-medium">{g}</span>
          ))}
        </div>
      )}

      <!-- Trope pills -->
      <div class="mt-3 flex flex-wrap gap-2">
        {sourcetropes.map((t) => (
          <a href={`/tropes/${toSlug(t)}/`} class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full text-sm hover:bg-indigo-100 transition-colors">{t}</a>
        ))}
      </div>

      <!-- Content warnings (source book) -->
      {sourceWarnings.length > 0 && (
        <div class="relative mt-3">
          <p class="blur-sm select-none transition-[filter] duration-300 pointer-events-none text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
            <span class="font-semibold">⚠️ Content Warnings: </span>{sourceWarnings.join(', ')}
          </p>
          <button
            onclick="this.previousElementSibling.classList.remove('blur-sm','select-none','pointer-events-none');this.remove()"
            class="absolute inset-0 flex items-center justify-center text-xs font-semibold text-zinc-500 hover:text-zinc-800 transition-colors"
          >
            Click to reveal Content Warnings
          </button>
        </div>
      )}

    </div>
  </div>

  <!-- Why people love it -->
  <div class="mb-8 -mt-6 p-5 rounded-2xl bg-linear-to-br from-violet-50 via-white to-indigo-50 border border-violet-100 shadow-sm">
    <h2 class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">Why people love this book</h2>
    {source.why_people_love_rich ? (
      <div class="space-y-3 text-[15px] leading-relaxed">
        {source.why_people_love_rich.map((block) => {
          if (block.type === 'labeled') {
            return (
              <p class="text-zinc-700">
                <span class="font-semibold text-zinc-900">{block.label}</span>{' '}{block.text}
              </p>
            );
          }
          if (block.type === 'warning') {
            return (
              <div class="flex gap-2 mt-1 p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-[14px]">
                <span class="shrink-0">⚠️</span>
                <p>{block.text}</p>
              </div>
            );
          }
          return <p class="text-zinc-700">{block.text}</p>;
        })}
      </div>
    ) : (
      <p class="text-zinc-700 leading-relaxed text-[15px]">{source.why_people_love}</p>
    )}
  </div>

  <!-- ── WHAT YOU'RE REALLY LOOKING FOR ─────────────────────────── -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-zinc-900 mb-3">What you're really looking for?</h2>
    <p class="text-zinc-600 text-sm leading-relaxed mb-8">
      {source.answer_line
        ? <em>{source.answer_line}</em>
        : (source.series && source.series_number != null
          ? `Looking for books like ${source.title}? These picks capture what makes ${source.series} worth reading.`
          : `Looking for books like ${source.title}? These picks capture what makes ${source.author}'s work worth reading.`)}
    </p>
    <div class="space-y-8">
      {aspects.map((aspect) => (
        <div>
          <h3 class="text-base font-bold text-zinc-800 mb-4 pb-2 border-b border-zinc-200">{aspect.heading}</h3>
          <div class="space-y-4">
            {aspect.recs.map((r) => {
              const recSlug = (r as any).slug ?? toSlug(r.title)
              const recDarkness = dbDarknessMap.get(recSlug) ?? r.darkness_level
              const recHeat = dbHeatMap.get(recSlug) ?? r.heat_level
              const h = getHeat(recHeat)
              const recCover = dbRecCoverMap.get(recSlug) ?? (r.cover_url?.includes('archive.org') ? '' : r.cover_url)
              return (
                <div class="rounded-xl border border-violet-200 bg-linear-to-br from-violet-50 to-indigo-50/60 p-4 grid grid-cols-[auto_1fr] gap-x-5 gap-y-3 shadow-sm hover:shadow-[0_0_20px_rgba(139,92,246,0.15)] hover:border-violet-300 transition-all">
                  <!-- Cover + Amazon: spans 2 rows on sm+ so description stays in col 2 -->
                  <div class="sm:row-span-2 flex flex-col gap-2">
                    <a href={`/books/${recSlug}/`} class="relative w-24 aspect-2/3 rounded-lg shadow overflow-hidden bg-linear-to-br from-purple-100 to-blue-100 block">
                      <img src={upgradeCoverUrl(recCover) || '/grimplaceholder.png'} alt={`Cover of ${r.title}`} class="absolute inset-0 w-full h-full object-cover" onerror="this.onerror=null;this.src='/grimplaceholder.png';" onload="if(this.naturalWidth<=1||this.naturalHeight<=1){this.src='/grimplaceholder.png';}" />
                    </a>
                    <a href={r.amazon_url} target="_blank" rel="noopener noreferrer"
                      class="w-full text-center px-2 py-1.5 rounded-lg bg-amber-400 hover:bg-amber-500 text-zinc-900 text-xs font-semibold transition-colors">
                      Amazon
                    </a>
                    {r.audiobook && (() => {
                      const audibleUrl = dbAudibleMap.get(recSlug)
                        ?? `https://www.audible.com/search?keywords=${encodeURIComponent(r.title + ' ' + r.author)}`
                      return (
                        <a href={audibleUrl} target="_blank" rel="noopener noreferrer"
                          class="w-full text-center px-2 py-1.5 rounded-lg bg-sky-100 hover:bg-sky-200 text-sky-800 text-xs font-semibold transition-colors border border-sky-200">
                          🎧 Audible
                        </a>
                      )
                    })()}
                  </div>
                  <!-- Basic info: title, author, series -->
                  <div class="min-w-0">
                    <p class="font-bold text-zinc-900 leading-tight mb-1">
                      {dbSlugSet.has(recSlug)
                        ? <a href={`/books/${recSlug}/`} class="hover:text-purple-700 transition-colors">{r.title}</a>
                        : r.title}
                      {r.series && r.series_number != null && (
                        <a href={`/reading-orders/${resolveSeriesSlug(r.series)}/`} class="font-normal text-zinc-400 text-sm italic hover:text-zinc-600 transition-colors"> · {r.series} #{r.series_number}</a>
                      )}
                    </p>
                    <p class="text-sm text-zinc-500 mb-0.5">
                      by {r.author.split(/\s*&\s*/).map((a: string, i: number, arr: string[]) => (
                        <><a href={`/authors/${toSlug(a)}/`} class="hover:text-purple-700 transition-colors">{a}</a>{i < arr.length - 1 ? ' & ' : ''}</>
                      ))}
                      {r.author_note && <span class="text-zinc-400"> ({r.author_note})</span>}
                    </p>
                    <div class="flex items-center gap-3 text-sm mt-0.5 flex-wrap">
                      <span class="flex items-center gap-1">
                        <span class="text-xs text-zinc-400 font-medium">Darkness:</span>
                        <span title={`Darkness ${recDarkness}/5`}>{darknessCandles(recDarkness)}</span>
                      </span>
                      {h && (
                        <span class="flex items-center gap-1">
                          <span class="text-xs text-zinc-400 font-medium">Heat:</span>
                          <span title={`Heat — ${h.label}`}>{h.flames}</span>
                        </span>
                      )}
                    </div>

                    <!-- Tags: mobile only (above description, next to cover) -->
                    <div class="flex flex-wrap gap-1.5 mt-2 sm:hidden">
                      {r.tags.map((tag) => (
                        <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full text-xs font-medium">{tag}</span>
                      ))}
                    </div>
                  </div>
                  <!-- Description + tags + warning: full width on mobile, col 2 row 2 on sm+ -->
                  <div class="col-span-2 sm:col-span-1">
                    <p class="text-sm text-zinc-700 leading-relaxed" class:list={[r.caveat ? 'mb-2' : 'mb-3']}>{r.note}</p>
                    {r.caveat && (
                      <p class="text-xs text-zinc-500 leading-relaxed border-l-2 border-zinc-300 pl-3 mb-3 italic">
                        <span class="not-italic font-semibold text-zinc-600">Caveat:</span> {r.caveat}
                      </p>
                    )}
                    <!-- Tags: desktop only (below description) -->
                    <div class="hidden sm:flex flex-wrap gap-1.5 mb-3">
                      {r.tags.map((tag) => (
                        <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full text-xs font-medium">{tag}</span>
                      ))}
                    </div>
                    {(() => {
                      const rSlug = (r as any).slug ?? toSlug(r.title)
                      const dbWarnings = dbWarningsMap.get(rSlug)
                      const warningText = dbWarnings?.length
                        ? dbWarnings.join(', ')
                        : r.warning ?? null
                      return warningText ? (
                        <div class="relative mt-1">
                          <p class="blur-sm select-none transition-[filter] duration-300 pointer-events-none text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
                            <span class="font-semibold">⚠️ Content Warnings: </span>{warningText}
                          </p>
                          <button
                            onclick="this.previousElementSibling.classList.remove('blur-sm','select-none','pointer-events-none');this.remove()"
                            class="absolute inset-0 flex items-center justify-center text-xs font-semibold text-zinc-500 hover:text-zinc-800 transition-colors"
                          >
                            Click to reveal Content Warnings
                          </button>
                        </div>
                      ) : null
                    })()}
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM ──────────────────────────────────────────────────── -->
  <div class="border-t pt-8 space-y-6">

    <div class="flex flex-wrap items-center gap-4">
      <span class="text-sm text-zinc-500">Not quite right?</span>
      <a href="/book-finder/" class="text-base font-semibold text-purple-700 hover:underline">
        Try out our extensive custom filters → Find My Next Book
      </a>
    </div>

    {readingOrderSlug && source.series && (
      <div>
        <p class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">Reading Order</p>
        <a
          href={`/reading-orders/${readingOrderSlug}/`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-indigo-200 bg-indigo-50 text-sm text-indigo-700 hover:border-indigo-400 hover:bg-indigo-100 transition-colors"
        >
          📖 {source.series} - full reading order →
        </a>
      </div>
    )}

    {allRelated.length > 0 && (
      <div>
        <p class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">Other readers also searched for</p>
        <div class="flex flex-wrap gap-2">
          {allRelated.map((r) => (
            <a
              href={`/books-like/${r.slug}/`}
              class="px-4 py-2 rounded-full border border-zinc-200 bg-white text-sm text-zinc-700 hover:border-violet-300 hover:bg-violet-50 hover:text-violet-700 transition-colors shadow-sm"
            >
              {r.title}
            </a>
          ))}
        </div>
      </div>
    )}

  </div>

</Layout>
