---
import Layout from '../../components/Layout.astro';
---

<Layout
  title="What to Read? | Fantasy Obscura"
  description="Simple prompts to decide your next read."
>
  <h1 class="text-3xl font-semibold tracking-tight">What to Read?</h1>
  <p class="mt-4 max-w-2xl text-zinc-700">
    A lightweight mockup. This will evolve into a quiz or picker.
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border p-4">
      <div class="font-medium">Short & fast?</div>
      <p class="text-sm text-zinc-600 mt-2">Try a standalone or novella.</p>
    </div>
    <div class="rounded-xl border p-4">
      <div class="font-medium">Big worldbuilding?</div>
      <p class="text-sm text-zinc-600 mt-2">Pick epic or high fantasy.</p>
    </div>
  </div>
</Layout>
