---
import Layout from '../../components/Layout.astro';
---

<Layout
  title="What to Read? | Fantasy Obscura"
  description="Alchemical book selection - mix ingredients to find your perfect read."
>
  <div class="relative">
    <!-- Alchemy background pattern -->
    <div class="absolute inset-0 opacity-5 pointer-events-none">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <pattern id="alchemy-grid" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
          <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="50" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="1"/>
          <line x1="50" y1="20" x2="50" y2="80" stroke="currentColor" stroke-width="1"/>
          <line x1="20" y1="50" x2="80" y2="50" stroke="currentColor" stroke-width="1"/>
        </pattern>
        <rect width="100%" height="100%" fill="url(#alchemy-grid)"/>
      </svg>
    </div>

    <div class="relative">
      <h1 class="text-3xl font-semibold tracking-tight flex items-center justify-center gap-3 text-center">
        <span class="text-4xl">⚗️</span>
        ✨ The Alchemy Table ✨
        <span class="text-4xl">⚗️</span>
      </h1>
      <p class="mt-4 max-w-2xl text-zinc-700 text-center mx-auto">
        Combine story ingredients to build a tailored read. Find the book you were searching for.
      </p>

      <!-- Alchemy Table -->
      <div class="mt-8 rounded-2xl border-2 border-amber-200 bg-gradient-to-br from-amber-50/50 via-yellow-50/30 to-orange-50/50 p-8 shadow-lg">
        <div class="text-center mb-6"></div>

        <div class="space-y-6">
          <!-- Top Row (4 filters) -->
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Mood Vial -->
            <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-purple-200 p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-2xl">⚗️</span>
                <h3 class="font-semibold text-purple-900">Mood Vial</h3>
              </div>
              <div class="space-y-2">
                <button class="w-full text-left px-3 py-2 rounded-lg bg-purple-50 hover:bg-purple-100 text-sm transition-colors">
                  ✨ Whimsical & Light
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-slate-50 hover:bg-slate-100 text-sm transition-colors">
                  🌑 Dark & Gritty
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-amber-50 hover:bg-amber-100 text-sm transition-colors">
                  ⚔️ Action-packed
                </button>
              </div>
            </div>

            <!-- Pacing Elixir -->
            <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-blue-200 p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-2xl">🧉</span>
                <h3 class="font-semibold text-blue-900">Pacing Elixir</h3>
              </div>
              <div class="space-y-2">
                <button class="w-full text-left px-3 py-2 rounded-lg bg-blue-50 hover:bg-blue-100 text-sm transition-colors">
                  ⚡ Fast & Intense
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-green-50 hover:bg-green-100 text-sm transition-colors">
                  🌿 Slow & Atmospheric
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-yellow-50 hover:bg-yellow-100 text-sm transition-colors">
                  🔄 Balanced Mix
                </button>
              </div>
            </div>

            <!-- Magic Essence -->
            <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-rose-200 p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-2xl">🔮</span>
                <h3 class="font-semibold text-rose-900">Magic Essence</h3>
              </div>
              <div class="space-y-2">
                <button class="w-full text-left px-3 py-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-sm transition-colors">
                  💫 Soft & Mysterious
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-sm transition-colors">
                  ⚙️ Hard & Systematic
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-zinc-50 hover:bg-zinc-100 text-sm transition-colors">
                  🚫 No Magic
                </button>
              </div>
            </div>

            <!-- Romance Potion -->
            <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-pink-200 p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-2xl">💕</span>
                <h3 class="font-semibold text-pink-900">Romance Potion</h3>
              </div>
              <div class="space-y-2">
                <button class="w-full text-left px-3 py-2 rounded-lg bg-pink-50 hover:bg-pink-100 text-sm transition-colors">
                  🔥 Spicy & Central
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-sm transition-colors">
                  💐 Sweet Subplot
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-zinc-50 hover:bg-zinc-100 text-sm transition-colors">
                  ❄️ None/Minimal
                </button>
              </div>
            </div>
          </div>

          <!-- Middle Row (4 filters around transmute square) -->
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-[1fr_auto_1fr] items-stretch">
            <!-- Left Column (2 filters) -->
            <div class="grid gap-6 order-1 lg:order-1">
              <!-- World Scope -->
              <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-emerald-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-2xl">🗺️</span>
                  <h3 class="font-semibold text-emerald-900">World Scope</h3>
                </div>
                <div class="space-y-2">
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-sm transition-colors">
                    🌍 Epic Worldbuilding
                  </button>
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-teal-50 hover:bg-teal-100 text-sm transition-colors">
                    🏘️ Intimate & Small
                  </button>
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-cyan-50 hover:bg-cyan-100 text-sm transition-colors">
                    🏙️ Urban/Modern
                  </button>
                </div>
              </div>

              <!-- Conflict Catalyst -->
              <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-red-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-2xl">⚔️</span>
                  <h3 class="font-semibold text-red-900">Conflict Catalyst</h3>
                </div>
                <div class="space-y-2">
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-red-50 hover:bg-red-100 text-sm transition-colors">
                    🧩 Political Intrigue
                  </button>
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-sm transition-colors">
                    🐉 Creature vs Hero
                  </button>
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-orange-50 hover:bg-orange-100 text-sm transition-colors">
                    🕵️ Mystery & Secrets
                  </button>
                </div>
              </div>
            </div>

            <!-- Transmutation Square -->
            <div class="hidden lg:flex items-stretch justify-center order-last lg:order-2">
              <div class="w-full max-w-sm h-full min-h-[420px] rounded-2xl border-2 border-dashed border-amber-300 bg-white/70 backdrop-blur p-5 shadow-inner">
                <div class="text-center">
                  <div class="mx-auto h-52 w-full rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-400 text-5xl">
                    📖
                  </div>
                  <div class="mt-3 text-xs text-amber-700">
                    The book appears here with cover & description
                  </div>
                </div>
                <div class="mt-5 flex justify-center">
                  <button class="inline-flex items-center gap-2 px-6 py-2 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 text-white text-sm font-semibold shadow-lg hover:shadow-xl hover:scale-105 transition-all">
                    <span class="text-lg">✨</span>
                    Transmute Book
                    <span class="text-lg">✨</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Right Column (2 filters) -->
            <div class="grid gap-6 order-2 lg:order-3">
              <!-- Length Measure -->
              <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-orange-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-2xl">📏</span>
                  <h3 class="font-semibold text-orange-900">Format / Length</h3>
                </div>
                <div class="space-y-2">
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-orange-50 hover:bg-orange-100 text-sm transition-colors">
                    📚 Epic Series
                  </button>
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-yellow-50 hover:bg-yellow-100 text-sm transition-colors">
                    📖 Trilogy
                  </button>
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-amber-50 hover:bg-amber-100 text-sm transition-colors">
                    📕 Standalone
                  </button>
                </div>
              </div>

              <!-- Audience -->
              <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-indigo-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-2xl">👥</span>
                  <h3 class="font-semibold text-indigo-900">Audience</h3>
                </div>
                <div class="space-y-2">
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-sm transition-colors">
                    🧑 Adult
                  </button>
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-slate-50 hover:bg-slate-100 text-sm transition-colors">
                    🧒 Young Adult (YA)
                  </button>
                  <button class="w-full text-left px-3 py-2 rounded-lg bg-violet-50 hover:bg-violet-100 text-sm transition-colors">
                    🧸 Children’s
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Row (4 filters) -->
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Theme Catalyst -->
            <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-lime-200 p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-2xl">🧬</span>
                <h3 class="font-semibold text-lime-900">Theme Catalyst</h3>
              </div>
              <div class="space-y-2">
                <button class="w-full text-left px-3 py-2 rounded-lg bg-lime-50 hover:bg-lime-100 text-sm transition-colors">
                  🧭 Destiny & Choice
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-sm transition-colors">
                  🫂 Found Family
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-yellow-50 hover:bg-yellow-100 text-sm transition-colors">
                  ⚖️ Power & Politics
                </button>
              </div>
            </div>

            <!-- POV Lens -->
            <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-sky-200 p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-2xl">👁️</span>
                <h3 class="font-semibold text-sky-900">POV Lens</h3>
              </div>
              <div class="space-y-2">
                <button class="w-full text-left px-3 py-2 rounded-lg bg-sky-50 hover:bg-sky-100 text-sm transition-colors">
                  🧭 Single POV
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-cyan-50 hover:bg-cyan-100 text-sm transition-colors">
                  🧩 Multiple POVs
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-slate-50 hover:bg-slate-100 text-sm transition-colors">
                  🌀 Unreliable Narrator
                </button>
              </div>
            </div>

            <!-- Setting Crucible -->
            <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-fuchsia-200 p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-2xl">🏰</span>
                <h3 class="font-semibold text-fuchsia-900">Setting Crucible</h3>
              </div>
              <div class="space-y-2">
                <button class="w-full text-left px-3 py-2 rounded-lg bg-fuchsia-50 hover:bg-fuchsia-100 text-sm transition-colors">
                  🏔️ Wilderness
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-purple-50 hover:bg-purple-100 text-sm transition-colors">
                  🏛️ Court & City
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-sm transition-colors">
                  🧪 Academy/Lab
                </button>
              </div>
            </div>

            <!-- Character Focus -->
            <div class="bg-white/80 backdrop-blur rounded-xl border-2 border-amber-200 p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-2xl">🧝</span>
                <h3 class="font-semibold text-amber-900">Character Focus</h3>
              </div>
              <div class="space-y-2">
                <button class="w-full text-left px-3 py-2 rounded-lg bg-amber-50 hover:bg-amber-100 text-sm transition-colors">
                  🗡️ Hero’s Journey
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-orange-50 hover:bg-orange-100 text-sm transition-colors">
                  🕵️ Rogues & Outcasts
                </button>
                <button class="w-full text-left px-3 py-2 rounded-lg bg-zinc-50 hover:bg-zinc-100 text-sm transition-colors">
                  👑 Villain Lead
                </button>
              </div>
            </div>
          </div>

          <!-- Transmutation Slot (mobile/small screens: after bottom row) -->
          <div class="flex lg:hidden items-stretch justify-center">
            <div class="w-full max-w-sm h-full min-h-[420px] rounded-2xl border-2 border-dashed border-amber-300 bg-white/70 backdrop-blur p-5 shadow-inner">
              <div class="text-center">
                <div class="mx-auto h-52 w-full rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-400 text-5xl">
                  📖
                </div>
                <div class="mt-3 text-xs text-amber-700">
                  The book appears here with cover & description
                </div>
              </div>
              <div class="mt-5 flex justify-center">
                <button class="inline-flex items-center gap-2 px-6 py-2 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 text-white text-sm font-semibold shadow-lg hover:shadow-xl hover:scale-105 transition-all">
                  <span class="text-lg">✨</span>
                  Transmute Book
                  <span class="text-lg">✨</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
