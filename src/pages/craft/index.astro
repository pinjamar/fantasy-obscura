---
import Layout from '../../components/Layout.astro';
import AlchemyTable from '../../components/AlchemyTable';
---

<Layout
  title="What to Read? | Fantasy Obscura"
  description="Alchemical book selection - mix ingredients to find your perfect read."
>
  <div class="relative">
    <!-- Alchemy background pattern -->
    <div class="absolute inset-0 opacity-5 pointer-events-none">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <pattern id="alchemy-grid" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
          <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="50" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="1"/>
          <line x1="50" y1="20" x2="50" y2="80" stroke="currentColor" stroke-width="1"/>
          <line x1="20" y1="50" x2="80" y2="50" stroke="currentColor" stroke-width="1"/>
        </pattern>
        <rect width="100%" height="100%" fill="url(#alchemy-grid)"/>
      </svg>
    </div>

    <div class="relative">
      <h1 class="text-3xl font-semibold tracking-tight flex items-center justify-center gap-3 text-center">
        <span class="text-4xl">⚗️</span>
        ✨ The Alchemy Table ✨
        <span class="text-4xl">⚗️</span>
      </h1>
      <p class="mt-4 max-w-2xl text-zinc-700 text-center mx-auto">
        Combine story ingredients to build a tailored read. Find the book you were searching for.
      </p>

      <div class="mt-8 rounded-2xl border-2 border-amber-200 bg-gradient-to-br from-amber-50/50 via-yellow-50/30 to-orange-50/50 p-8 shadow-lg">
        <AlchemyTable client:load />
      </div>
    </div>
  </div>
</Layout>
