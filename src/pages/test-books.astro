---
import Layout from "../components/Layout.astro";
import BookHub from "../components/BookHub";
import BookDisplay from "../components/BookDisplay";
---

<Layout title="Book API Test" description="Test the book APIs and display books">
  <div class="space-y-12">
    <!-- Header -->
    <div>
      <h1 class="text-4xl font-bold">📚 Book API Test</h1>
      <p class="text-lg text-zinc-600 mt-2">
        Import books using the BookHub and display them below
      </p>
    </div>

    <!-- BookHub Component (for importing) -->
    <div class="bg-gradient-to-br from-purple-50 to-blue-50 border border-purple-200 rounded-lg p-8">
      <h2 class="text-2xl font-semibold mb-4">🔍 Search & Import Books</h2>
      <BookHub client:load />
    </div>

    <!-- BookDisplay Component (for showing results) -->
    <div>
      <BookDisplay client:load />
    </div>

    <!-- Instructions -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
      <h3 class="font-semibold text-blue-900 mb-3">How to Test:</h3>
      <ol class="space-y-2 text-sm text-blue-800">
        <li><strong>1.</strong> Use the BookHub form above to search for books</li>
        <li><strong>2.</strong> Select a source (Open Library recommended for testing)</li>
        <li><strong>3.</strong> Click "Search" to fetch results</li>
        <li><strong>4.</strong> Fill in any additional details and click "Save Book"</li>
        <li><strong>5.</strong> Scroll down to see your imported books displayed below</li>
      </ol>
    </div>

    <!-- API Test Info -->
    <div class="bg-zinc-50 border border-zinc-200 rounded-lg p-6">
      <h3 class="font-semibold text-zinc-900 mb-3">🛠️ API Endpoints Tested:</h3>
      <ul class="space-y-2 text-sm text-zinc-700 font-mono">
        <li>
          <strong>GET /api/search</strong> - Search external book APIs
        </li>
        <li>
          <strong>POST /api/books</strong> - Save books to database
        </li>
        <li>
          <strong>GET /api/books</strong> - Fetch all books from database
        </li>
      </ul>
    </div>
  </div>
</Layout>
