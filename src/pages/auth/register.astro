---
import Layout from '../../components/Layout.astro';

if (Astro.locals.user) return Astro.redirect('/');

const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success') === '1';
---

<Layout title="Create Account | Fantasy Obscura" description="Create a Fantasy Obscura account" noindex>
  <div class="max-w-sm mx-auto mt-16">
    <h1 class="text-2xl font-bold tracking-tight mb-2">Create account</h1>
    <p class="text-sm text-zinc-500 mb-8">
      Already have an account? <a href="/auth/login" class="text-purple-600 hover:underline">Sign in</a>
    </p>

    {success ? (
      <div class="px-5 py-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-center">
        <p class="text-2xl mb-3">📬</p>
        <p class="font-semibold text-emerald-900 mb-1">Check your email</p>
        <p class="text-sm text-emerald-700">
          We've sent a confirmation link. Click it to activate your account, then sign in.
        </p>
        <a href="/auth/login" class="inline-block mt-4 text-sm text-purple-600 font-medium hover:underline">
          Go to sign in →
        </a>
      </div>
    ) : (
      <>
        {error && (
          <div class="mb-5 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
            {error}
          </div>
        )}

        <form method="POST" action="/api/auth/register" class="flex flex-col gap-4">
          <div>
            <label class="block text-sm font-medium text-zinc-700 mb-1" for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full px-3 py-2 rounded-lg border border-zinc-300 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-zinc-700 mb-1" for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="new-password"
              minlength="6"
              class="w-full px-3 py-2 rounded-lg border border-zinc-300 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm"
            />
            <p class="text-xs text-zinc-400 mt-1">At least 6 characters</p>
          </div>

          <button
            type="submit"
            class="w-full py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-semibold text-sm transition-colors"
          >
            Create account
          </button>
        </form>
      </>
    )}
  </div>
</Layout>
