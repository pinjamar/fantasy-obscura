---
import { createClient } from '@supabase/supabase-js';

const adminKey = Astro.url.searchParams.get('key') ?? '';
const isAuthed = !!import.meta.env.ADMIN_SECRET && adminKey === import.meta.env.ADMIN_SECRET;

// Skip DB entirely if not authenticated
let pending: any[] = [];
let totalPending: number | null = null;
let totalPages = 0;

const SOURCE_LABELS: Record<string, string> = {
  regex: 'Regex',
  google_books: 'Google Books',
  llm: 'Gemini LLM',
  manual: 'Manual',
};

const PAGE_SIZE = 200;
const page = parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const sort = Astro.url.searchParams.get('sort') ?? 'confidence';

if (isAuthed) {
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
  );

  const offset = (page - 1) * PAGE_SIZE;

  const orderMap: Record<string, { col: string; asc: boolean }> = {
    confidence: { col: 'series_confidence', asc: false },
    author:     { col: 'authors',           asc: true  },
    title:      { col: 'title',             asc: true  },
  };
  const { col: orderCol, asc: orderAsc } = orderMap[sort] ?? orderMap.confidence;

  const [{ data, error }, { count }] = await Promise.all([
    supabase
      .from('books')
      .select('slug,title,authors,series,series_number,series_confidence,series_review,series_source')
      .eq('series_review', 'pending')
      .order(orderCol, { ascending: orderAsc })
      .range(offset, offset + PAGE_SIZE - 1),
    supabase
      .from('books')
      .select('*', { count: 'exact', head: true })
      .eq('series_review', 'pending'),
  ]);

  if (error) throw new Error(error.message);
  pending = data ?? [];
  totalPending = count ?? 0;
  totalPages = Math.ceil((count ?? 0) / PAGE_SIZE);
}

// Helper to build links that preserve key + sort + page
function href(params: Record<string, string | number>) {
  const p = new URLSearchParams({ key: adminKey, sort, page: String(page), ...params });
  return '?' + p.toString();
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Series Review — Admin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0f0f13; color: #e2e2e8; padding: 2rem; }
    h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
    .subtitle { color: #888; margin-bottom: 1rem; font-size: 0.9rem; }
    .toolbar { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .pagination { display: flex; gap: 0.5rem; align-items: center; margin-left: auto; }
    .pagination a { color: #a78bfa; text-decoration: none; padding: 4px 10px; border: 1px solid #2a2a40; border-radius: 4px; font-size: 0.85rem; }
    .pagination a:hover { background: #1e1e2e; }
    .pagination .current { background: #2a2a3e; padding: 4px 10px; border-radius: 4px; font-size: 0.85rem; color: #e2e2e8; }
    table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    th { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #2a2a35; color: #aaa; font-weight: 500; }
    td { padding: 0.5rem 0.75rem; border-bottom: 1px solid #1e1e28; vertical-align: middle; }
    tr:hover td { background: #16161f; }
    .conf-high  { color: #4ade80; }
    .conf-med   { color: #facc15; }
    .conf-low   { color: #f87171; }
    .source-tag { font-size: 0.7rem; background: #2a2a3e; padding: 2px 6px; border-radius: 4px; color: #a0a0c0; }
    .series-input { background: #1e1e2e; border: 1px solid #2a2a40; color: #e2e2e8; padding: 4px 8px; border-radius: 4px; width: 200px; }
    .num-input { width: 60px; }
    .btn { padding: 4px 12px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.8rem; font-weight: 600; }
    .btn-confirm { background: #16a34a; color: #fff; }
    .btn-confirm:hover { background: #15803d; }
    .btn-reject  { background: #991b1b; color: #fff; margin-left: 4px; }
    .btn-reject:hover { background: #7f1d1d; }
    .btn-all { background: #1d4ed8; color: #fff; padding: 6px 16px; font-size: 0.85rem; }
    .btn-all:hover { background: #1e40af; }
    .btn:disabled { opacity: 0.4; cursor: default; }
    .done { opacity: 0.3; }
    .empty { text-align: center; padding: 4rem; color: #555; }
    .sort-link { color: #aaa; text-decoration: none; }
    .sort-link:hover { color: #e2e2e8; }
    .sort-active { color: #a78bfa; font-weight: 600; }
    /* login gate */
    .gate { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; gap: 1rem; }
    .gate input { background: #1e1e2e; border: 1px solid #3a3a50; color: #e2e2e8; padding: 10px 14px; border-radius: 6px; font-size: 1rem; width: 260px; }
    .gate button { background: #4f46e5; color: #fff; border: none; padding: 10px 28px; border-radius: 6px; font-size: 1rem; cursor: pointer; }
    .gate button:hover { background: #4338ca; }
    .gate .err { color: #f87171; font-size: 0.875rem; }
  </style>
</head>
<body>

{!isAuthed ? (
  <div class="gate">
    <h1>Series Review — Admin</h1>
    <input type="password" id="key-input" placeholder="Admin key" autofocus />
    <button id="login-btn">Enter</button>
    {adminKey && <p class="err">Incorrect key</p>}
    <script is:inline>
      document.getElementById('login-btn').addEventListener('click', () => {
        const key = document.getElementById('key-input').value.trim();
        if (key) window.location.href = '?key=' + encodeURIComponent(key);
      });
      document.getElementById('key-input').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('login-btn').click();
      });
    </script>
  </div>
) : (
  <>
    <h1>Series Review Queue</h1>
    <p class="subtitle">{totalPending ?? 0} total pending — page {page} of {totalPages} — sorted by {sort}</p>

    {!pending.length ? (
      <div class="empty">✅ Queue is empty — nothing to review</div>
    ) : (
      <>
        <div class="toolbar">
          <button class="btn btn-all" id="confirm-all-btn">✓ Confirm all {pending.length} on this page</button>
          <div class="pagination">
            {page > 1 && <a href={href({ page: page - 1 })}>← Prev</a>}
            <span class="current">Page {page} / {totalPages}</span>
            {page < totalPages && <a href={href({ page: page + 1 })}>Next →</a>}
          </div>
        </div>

        <table>
          <thead>
            <tr>
              <th><a class={`sort-link ${sort === 'title'      ? 'sort-active' : ''}`} href={href({ sort: 'title',      page: 1 })}>Book</a></th>
              <th><a class={`sort-link ${sort === 'author'     ? 'sort-active' : ''}`} href={href({ sort: 'author',     page: 1 })}>Author</a></th>
              <th>Detected Series</th>
              <th>#</th>
              <th><a class={`sort-link ${sort === 'confidence' ? 'sort-active' : ''}`} href={href({ sort: 'confidence', page: 1 })}>Conf</a></th>
              <th>Source</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="queue">
            {pending.map(book => {
              const conf = book.series_confidence ?? 0;
              const confClass = conf >= 0.85 ? 'conf-high' : conf >= 0.70 ? 'conf-med' : 'conf-low';
              return (
                <tr id={`row-${book.slug}`}>
                  <td>
                    <a href={`/books/${book.slug}`} target="_blank" style="color:#a78bfa">
                      {book.title}
                    </a>
                  </td>
                  <td style="color:#aaa">{book.authors?.join(', ')}</td>
                  <td>
                    <input
                      class="series-input"
                      id={`series-${book.slug}`}
                      type="text"
                      value={book.series ?? ''}
                    />
                  </td>
                  <td>
                    <input
                      class="series-input num-input"
                      id={`num-${book.slug}`}
                      type="number"
                      step="0.5"
                      value={book.series_number ?? ''}
                      placeholder="—"
                    />
                  </td>
                  <td class={confClass}>{(conf * 100).toFixed(0)}%</td>
                  <td><span class="source-tag">{SOURCE_LABELS[book.series_source ?? ''] ?? book.series_source}</span></td>
                  <td>
                    <button class="btn btn-confirm" onclick={`act('${book.slug}', 'confirm')`}>✓</button>
                    <button class="btn btn-reject"  onclick={`act('${book.slug}', 'reject')`}>✗</button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>

        <div class="toolbar" style="margin-top:1.5rem">
          <div class="pagination">
            {page > 1 && <a href={href({ page: page - 1 })}>← Prev</a>}
            <span class="current">Page {page} / {totalPages}</span>
            {page < totalPages && <a href={href({ page: page + 1 })}>Next →</a>}
          </div>
        </div>
      </>
    )}

  </>
)}

<script is:inline define:vars={{ adminKey }}>
  window.act = async function act(slug, action) {
    const row = document.getElementById('row-' + slug);
    const seriesName = document.getElementById('series-' + slug)?.value?.trim();
    const numRaw = document.getElementById('num-' + slug)?.value;
    const seriesNumber = numRaw ? parseFloat(numRaw) : null;

    row.querySelectorAll('.btn').forEach(b => b.disabled = true);

    const res = await fetch('/api/admin/series-review', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
      body: JSON.stringify({ slug, action, series_name: seriesName, series_number: seriesNumber }),
    });

    if (res.ok) {
      row.classList.add('done');
      setTimeout(() => row.remove(), 600);
    } else {
      const err = await res.json();
      alert('Error: ' + err.error);
      row.querySelectorAll('.btn').forEach(b => b.disabled = false);
    }
  }

  document.getElementById('confirm-all-btn')?.addEventListener('click', async function() {
    const slugs = [...document.querySelectorAll('#queue tr[id]')]
      .map(r => r.id.replace('row-', ''));
    if (!slugs.length) return;
    this.disabled = true;
    this.textContent = 'Confirming…';

    const res = await fetch('/api/admin/series-confirm-all', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-admin-key': adminKey },
      body: JSON.stringify({ slugs }),
    });

    if (res.ok) {
      document.querySelectorAll('#queue tr').forEach(r => r.classList.add('done'));
      setTimeout(() => window.location.reload(), 800);
    } else {
      const err = await res.json();
      alert('Error: ' + err.error);
      this.disabled = false;
      this.textContent = '✓ Confirm all on this page';
    }
  });
</script>
</body>
</html>
