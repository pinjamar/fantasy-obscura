---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';
import { supabaseClient } from '../../lib/supabaseClient';

const bookData = [
  {
    title: 'A Game of Thrones',
    slug: 'a-game-of-thrones',
    status: 'mandatory' as const,
    note: 'The foundation. Introduces the major houses, the political web, and the first major shock that signals what kind of series this is.',
    page_count: 694,
    publication_year: 1996,
  },
  {
    title: 'A Clash of Kings',
    slug: 'a-clash-of-kings',
    status: 'mandatory' as const,
    note: 'Five kings claim the throne. The political complexity doubles and the world expands beyond King\'s Landing.',
    page_count: 768,
    publication_year: 1998,
  },
  {
    title: 'A Storm of Swords',
    slug: 'a-storm-of-swords',
    status: 'mandatory' as const,
    note: 'The peak of the series. Contains the most devastating and celebrated chapters Martin has written. Do not look anything up.',
    page_count: 973,
    publication_year: 2000,
  },
  {
    title: 'A Feast for Crows',
    slug: 'a-feast-for-crows',
    status: 'mandatory' as const,
    note: 'Slower, more political. Many fan-favourite characters are absent — Martin split books 4 and 5 by POV, not timeline. Essential context for Dance.',
    page_count: 753,
    publication_year: 2005,
  },
  {
    title: 'A Dance with Dragons',
    slug: 'a-dance-with-dragons',
    status: 'mandatory' as const,
    note: 'Runs parallel to Feast for the first half, then moves forward. Reunites the missing POVs. The series is unfinished here — book 6 has no release date.',
    page_count: 1016,
    publication_year: 2011,
  },
];

const bookSlugs = bookData.map(b => b.slug);
const { data: dbRows } = await supabaseClient.from('books').select('slug, cover_url, darkness_level, avg_rating, series, series_number').in('slug', bookSlugs);
const dbMap = new Map<string, any>((dbRows ?? []).map((r: any) => [r.slug, r]));
const books = bookData.map(b => { const db = dbMap.get(b.slug); return { ...b, cover_url: db?.cover_url ?? null, darkness_level: db?.darkness_level ?? null, avg_rating: db?.avg_rating ?? null, series_label: db?.series && db?.series_number != null ? `${db.series} #${db.series_number}` : null }; });

const totalPages = books.reduce((sum, b) => sum + (b.page_count ?? 0), 0);
const totalHours = Math.round(totalPages / 30);
const coreBooks = books.filter(b => b.status === 'mandatory').length;
---

<Layout
  title="A Song of Ice and Fire Reading Order | Fantasy Obscura"
  description="Complete reading order for George R.R. Martin's A Song of Ice and Fire — the series behind Game of Thrones."
>

  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">← Reading Orders</a>
  </div>

  {/* ── Header ── */}
  <div class="mb-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-purple-600 uppercase tracking-wider mb-1">Reading Order</p>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900">A Song of Ice and Fire</h1>
        <p class="mt-1 text-lg text-zinc-500">by George R.R. Martin</p>
      </div>
      <span class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-50 border border-red-200 text-red-700 text-sm font-medium">
        ⚠️ Unfinished Series
      </span>
    </div>

    <div class="mt-5 flex flex-wrap gap-6 text-sm text-zinc-600 border-y border-zinc-100 py-4">
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📚</span> {books.length} books published (7 planned)</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📄</span> ~{totalPages.toLocaleString()} pages total</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">⏱</span> ~{totalHours} hours reading time</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">🕯️🕯️🕯️🕯️</span> Dark</span>
    </div>

    <p class="mt-5 text-base text-zinc-700 leading-relaxed max-w-2xl">
      The series that redefined epic fantasy for a generation. Five books of political chess, moral complexity, and the systematic destruction of the idea that protagonists are safe. No character is guaranteed survival; no storyline is guaranteed resolution. Read the books — they are significantly richer than the show.
    </p>
  </div>

  {/* ── Reading Order Timeline ── */}
  <div class="mb-12">
    <h2 class="text-xl font-semibold mb-1">Reading Order</h2>
    <p class="text-sm text-zinc-500 mb-6">Publication order is the only order. There are no prequels or companion novels required for the main series.</p>
    <ReadingOrder books={books} client:load />
  </div>

  {/* ── Quick Reference ── */}
  <div class="mb-10 grid gap-3 sm:grid-cols-3">
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">
      <p class="font-semibold text-blue-900 mb-2">⚡ The Peak</p>
      <p class="text-sm text-blue-800"><strong>A Storm of Swords</strong> is the series at its best — dense, brutal, and with some of the most discussed chapters in modern fantasy. Do not look anything up before reading it.</p>
    </div>
    <div class="rounded-xl border border-amber-100 bg-amber-50 p-5">
      <p class="font-semibold text-amber-900 mb-2">📖 Books 4 & 5</p>
      <p class="text-sm text-amber-800">Martin split the story by POV character across two books covering the same timeline. <strong>A Feast for Crows</strong> and <strong>A Dance with Dragons</strong> are best read back-to-back.</p>
    </div>
    <div class="rounded-xl border border-red-100 bg-red-50 p-5">
      <p class="font-semibold text-red-900 mb-2">⚠️ The Wait</p>
      <p class="text-sm text-red-800"><strong>The Winds of Winter</strong> has been in progress since 2011 with no confirmed release date. Read the published books knowing this.</p>
    </div>
  </div>

  {/* ── Safe Starting Points ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Where to start</h2>
    <div class="space-y-3 text-sm text-zinc-700">
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>New to the series?</strong> Start with <strong>A Game of Thrones</strong> — there is no other entry point. The series requires sequential reading.</div>
      </div>
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>Watched the show?</strong> Still start from book one. The books diverge significantly from season 5 onwards and have substantially richer plotting throughout.</div>
      </div>
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>Should you read the prequels?</strong> <em>Fire & Blood</em> and <em>The World of Ice and Fire</em> are supplementary lore — not required, best read after completing the main series.</div>
      </div>
    </div>
  </div>

  {/* ── Key Notes ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">What to know</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li class="flex gap-2"><span class="text-zinc-400">→</span> No character is plot-armoured. Major POV characters die. Do not get attached to narrative convention.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The first 100 pages of <em>A Game of Thrones</em> are slow world-building. The series earns its reputation from chapter 6 onwards.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> <em>A Feast for Crows</em> is the most divisive book — slower pace, unfamiliar POVs. Push through; Dance rewards it.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The <em>Dunk & Egg</em> novellas (Tales of Dunk and Egg) are standalone prequels set 90 years earlier. Good but non-essential.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Avoid the wiki. Seriously. This series is best experienced blind.</li>
    </ul>
  </div>

  {/* ── Darkness Progression ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-4">Darkness across the series</h2>
    <div class="space-y-3 text-sm">
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-56 shrink-0">A Game of Thrones</span>
        <span class="text-zinc-400">🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Serious — political violence, moral complexity</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-56 shrink-0">A Clash of Kings</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Dark — war begins in earnest</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-56 shrink-0">A Storm of Swords</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Brutal — the series' most devastating events</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-56 shrink-0">A Feast for Crows</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Dark — aftermath and political decay</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-56 shrink-0">A Dance with Dragons</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Dark — isolation, survival, and hard choices</span>
      </div>
    </div>
    <p class="mt-4 text-xs text-zinc-400">Scale: 🕯️ Lighthearted → 🕯️🕯️🕯️🕯️🕯️ Brutal</p>
  </div>

  {/* ── Footer ── */}
  <div class="border-t pt-8 flex flex-col sm:flex-row gap-6 justify-between">
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Finished the published books?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/categories/epic" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Browse Epic Fantasy →</a>
        <a href="/craft" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Find similar books →</a>
      </div>
    </div>
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Related reading orders</p>
      <div class="flex flex-wrap gap-3">
        <a href="/reading-orders/first-law" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">The First Law</a>
        <a href="/reading-orders/malazan" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">Malazan</a>
        <a href="/reading-orders/wheel-of-time" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">Wheel of Time</a>
      </div>
    </div>
  </div>

</Layout>
