---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';
import { supabaseClient } from '../../lib/supabaseClient';

const bookData = [
  {
    title: 'Throne of Glass',
    slug: 'throne-of-glass',
    status: 'mandatory' as const,
    note: 'Start here. Celaena Sardothien, assassin, enters a deadly competition in a corrupt kingdom.',
    page_count: 404,
    publication_year: 2012,
  },
  {
    title: 'The Assassin\'s Blade',
    slug: 'the-assassins-blade',
    status: 'optional' as const,
    note: 'Five prequel novellas in one volume. Best read after Throne of Glass — contains spoilers for book 1.',
    page_count: 432,
    publication_year: 2014,
  },
  {
    title: 'Crown of Midnight',
    slug: 'crown-of-midnight',
    status: 'mandatory' as const,
    note: 'The series finds its footing. Darker, faster, with a reveal that reframes everything.',
    page_count: 418,
    publication_year: 2013,
  },
  {
    title: 'Heir of Fire',
    slug: 'heir-of-fire',
    status: 'mandatory' as const,
    note: 'The world expands massively. Magic, Fae, and the true threat are introduced. A turning point.',
    page_count: 565,
    publication_year: 2014,
  },
  {
    title: 'Queen of Shadows',
    slug: 'queen-of-shadows',
    status: 'mandatory' as const,
    note: 'Aelin returns to Rifthold. High stakes, new alliances, and a cast that finally converges.',
    page_count: 648,
    publication_year: 2015,
  },
  {
    title: 'Empire of Storms',
    slug: 'empire-of-storms',
    status: 'mandatory' as const,
    note: 'The war begins in earnest. Read alongside Tower of Dawn or before it — both cover the same timeline.',
    page_count: 689,
    publication_year: 2016,
  },
  {
    title: 'Tower of Dawn',
    slug: 'tower-of-dawn',
    status: 'mandatory' as const,
    note: "Chaol's story, running parallel to Empire of Storms. Read EoS first or alternate chapters using a reading guide.",
    page_count: 660,
    publication_year: 2017,
  },
  {
    title: 'Kingdom of Ash',
    slug: 'kingdom-of-ash',
    status: 'mandatory' as const,
    note: 'The finale. All characters and storylines converge for the last battle. Massive in scope.',
    page_count: 992,
    publication_year: 2018,
  },
];

const bookSlugs = bookData.map(b => b.slug);
const { data: dbRows } = await supabaseClient.from('books').select('slug, cover_url, darkness_level, avg_rating, series, series_number').in('slug', bookSlugs);
const dbMap = new Map<string, any>((dbRows ?? []).map((r: any) => [r.slug, r]));
const books = bookData.map(b => { const db = dbMap.get(b.slug); return { ...b, cover_url: db?.cover_url ?? null, darkness_level: db?.darkness_level ?? null, avg_rating: db?.avg_rating ?? null, series_label: db?.series && db?.series_number != null ? `${db.series} #${db.series_number}` : null }; });

const groups = [
  {
    label: 'The Main Series',
    sublabel: 'books 1–6 + optional prequel',
    books: books.slice(0, 6),
    noteType: 'required' as const,
    note: "All main books are essential and must be read in order. The Assassin's Blade (prequel) is optional — read it after Throne of Glass or skip it. The series takes off at Crown of Midnight.",
  },
  {
    label: 'The Finale',
    sublabel: 'Tower of Dawn + Kingdom of Ash — read back-to-back',
    books: books.slice(6),
    noteType: 'warning' as const,
    note: "Tower of Dawn runs parallel to Empire of Storms from Chaol's POV. Option A: read EoS then ToD in full. Option B: alternate chapters using an online reading guide. Do not skip ToD — its events are essential for Kingdom of Ash.",
  },
];

const totalPages = books.reduce((sum, b) => sum + (b.page_count ?? 0), 0);
const totalHours = Math.round(totalPages / 30);
const coreBooks = books.filter(b => b.status === 'mandatory').length;
---

<Layout
  title="Throne of Glass Reading Order | Fantasy Obscura"
  description="Complete reading order for the Throne of Glass series by Sarah J. Maas."
>

  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">← Reading Orders</a>
  </div>

  <div class="mb-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-purple-600 uppercase tracking-wider mb-1">Reading Order</p>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900">Throne of Glass</h1>
        <p class="mt-1 text-lg text-zinc-500">by Sarah J. Maas</p>
      </div>
      <span class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium">
        ✓ Completed Series
      </span>
    </div>

    <div class="mt-5 flex flex-wrap gap-6 text-sm text-zinc-600 border-y border-zinc-100 py-4">
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📚</span> {books.length} books ({coreBooks} essential)</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📄</span> ~{totalPages.toLocaleString()} pages</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">⏱</span> ~{totalHours} hours reading time</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">🕯️🕯️🕯️🕯️</span> Dark</span>
    </div>

    <p class="mt-5 text-base text-zinc-700 leading-relaxed max-w-2xl">
      An assassin forced to compete for her freedom becomes the fulcrum of a war against an immortal darkness. Starts as a YA competition novel and grows into a full-scale epic fantasy with Fae, ancient magic, and a world-ending threat. The series earns its scope.
    </p>
  </div>

  <div class="mb-12">
    <h2 class="text-xl font-semibold mb-1">Reading Order</h2>
    <p class="text-sm text-zinc-500 mb-6">Publication order is the correct order. The Empire of Storms / Tower of Dawn overlap is the one structural complication — see the note below.</p>
    <ReadingOrder groups={groups} client:load />
  </div>

  <div class="mb-10 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">
      <p class="font-semibold text-blue-900 mb-2">⚡ Essential ({coreBooks} books)</p>
      <p class="text-sm text-blue-800">All main books — ToG through Kingdom of the Golden Flame. Tower of Dawn is mandatory despite being a "companion" novel.</p>
    </div>
    <div class="rounded-xl border border-green-100 bg-green-50 p-5">
      <p class="font-semibold text-green-900 mb-2">📖 Optional (1 book)</p>
      <p class="text-sm text-green-800"><strong>The Assassin's Blade</strong> — prequel novellas. Adds emotional depth but nothing you'll lose without. Read after book 1.</p>
    </div>
  </div>

  <div class="mb-10 rounded-xl border border-amber-100 bg-amber-50 p-6">
    <h2 class="font-semibold text-amber-900 mb-3">⚠️ The Empire of Storms / Tower of Dawn problem</h2>
    <p class="text-sm text-amber-800 leading-relaxed mb-3">
      These two books cover the same timeline from different POVs. The author intended them to be read simultaneously — there are even published chapter-interleaving guides online.
    </p>
    <ul class="space-y-1.5 text-sm text-amber-800">
      <li>— <strong>Option A (recommended):</strong> Read Empire of Storms in full, then Tower of Dawn. Slightly less immersive but easier to follow.</li>
      <li>— <strong>Option B:</strong> Use the chapter-interleave guide (search "ToG EoS ToD reading guide"). More work, better payoff.</li>
      <li>— <strong>Do not skip Tower of Dawn.</strong> Its events directly affect the finale and cannot be skipped without confusion.</li>
    </ul>
  </div>

  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Before you start</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The first book is the weakest. The series takes off at <strong>Crown of Midnight</strong>. Don't judge it on book 1 alone.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> <strong>Heir of Fire</strong> is when the magic system, the Fae, and the true antagonist arrive. This is where it becomes epic fantasy.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The protagonist goes by Celaena in early books — her name and identity evolve over the series. This is intentional.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The series grows significantly darker from book 3 onward. Book 1 is YA-adjacent. Book 7 is not.</li>
    </ul>
  </div>

  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-4">Darkness progression</h2>
    <div class="space-y-3 text-sm">
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-44 shrink-0">Books 1–2</span>
        <span class="text-zinc-400">🕯️🕯️</span>
        <span class="text-zinc-500">Competition, intrigue, assassination — relatively contained</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-44 shrink-0">Books 3–5</span>
        <span class="text-zinc-400">🕯️🕯️🕯️</span>
        <span class="text-zinc-500">War builds, magic escalates, loss becomes real</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-44 shrink-0">Books 6–8</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Full-scale war, sacrifice, world-ending stakes</span>
      </div>
    </div>
    <p class="mt-4 text-xs text-zinc-400">Scale: 🕯️ Lighthearted → 🕯️🕯️🕯️🕯️🕯️ Brutal</p>
  </div>

  <div class="border-t pt-8 flex flex-col sm:flex-row gap-6 justify-between">
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Finished the series?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/categories/epic" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Browse Epic Fantasy →</a>
        <a href="/craft" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Find books like Throne of Glass →</a>
      </div>
    </div>
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Related reading orders</p>
      <div class="flex flex-wrap gap-3">
        <a href="/reading-orders/acotar" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">ACOTAR</a>
        <a href="/reading-orders/first-law" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">The First Law</a>
      </div>
    </div>
  </div>

</Layout>
