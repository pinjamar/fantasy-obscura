---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';

const books = [
  {
    title: 'Guards! Guards! (City Watch #1)',
    status: 'mandatory' as const,
    note: 'Best starting point. Introduces the Night Watch.'
  },
  {
    title: 'Men at Arms (City Watch #2)',
    status: 'mandatory' as const,
    note: 'Continues the Watch storyline.'
  },
  {
    title: 'Feet of Clay (City Watch #3)',
    status: 'mandatory' as const,
    note: 'Mystery and golems.'
  },
  {
    title: 'Mort (Death #1)',
    status: 'optional' as const,
    note: 'Death takes an apprentice. Standalone subseries.'
  },
  {
    title: 'Reaper Man (Death #2)',
    status: 'optional' as const,
    note: 'Death gets fired.'
  },
  {
    title: 'Small Gods',
    status: 'optional' as const,
    note: 'Standalone masterpiece about religion. Highly recommended.'
  },
  {
    title: 'Jingo (City Watch #4)',
    status: 'mandatory' as const,
    note: 'War and politics.'
  },
  {
    title: 'The Fifth Elephant (City Watch #5)',
    status: 'mandatory' as const,
    note: 'Vimes goes abroad.'
  },
  {
    title: 'Going Postal (Moist #1)',
    status: 'optional' as const,
    note: 'Con artist rebuilds the postal service. Great entry point.'
  },
  {
    title: 'Night Watch (City Watch #6)',
    status: 'mandatory' as const,
    note: 'Time travel and revolution. One of the best.'
  },
];
---

<Layout
  title="Discworld Reading Order | Fantasy Obscura"
  description="Reading order for Terry Pratchett's Discworld series."
>
  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-blue-600 hover:underline">← Back to Reading Orders</a>
  </div>

  <h1 class="text-4xl font-bold tracking-tight">Discworld Reading Order</h1>
  <p class="mt-2 text-zinc-600">by Terry Pratchett</p>

  <div class="mt-8">
    <ReadingOrder
      books={books}
      description="Discworld has 41 books across multiple subseries. This focuses on the City Watch arc, the most popular entry point. All Discworld books can be read standalone."
      client:load
    />
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2">
    <div class="rounded-lg border bg-zinc-50 p-6">
      <h2 class="font-semibold mb-3">Best Starting Points</h2>
      <ul class="space-y-2 text-sm text-zinc-700">
        <li>• <strong>Guards! Guards!</strong> — City Watch (most popular)</li>
        <li>• <strong>Mort</strong> — Death subseries (quirky & fun)</li>
        <li>• <strong>Going Postal</strong> — Moist subseries (standalone)</li>
        <li>• <strong>Small Gods</strong> — Standalone masterpiece</li>
      </ul>
    </div>

    <div class="rounded-lg border bg-zinc-50 p-6">
      <h2 class="font-semibold mb-3">Other Subseries</h2>
      <ul class="space-y-2 text-sm text-zinc-700">
        <li>✓ <strong>Witches</strong> — Wyrd Sisters, Maskerade</li>
        <li>✓ <strong>Rincewind</strong> — The Colour of Magic (avoid as first)</li>
        <li>✓ <strong>Industrial Revolution</strong> — Going Postal, Making Money</li>
        <li>✓ <strong>Tiffany Aching</strong> — YA subseries (excellent)</li>
      </ul>
    </div>
  </div>

  <div class="mt-6 rounded-lg bg-blue-50 p-6">
    <h2 class="font-semibold text-blue-900 mb-2">Why Not Start at Book 1?</h2>
    <p class="text-sm text-zinc-700">
      The first two books (The Colour of Magic, The Light Fantastic) are very different from the rest of Discworld. Pratchett's style evolved significantly. Most fans recommend starting with Guards! Guards! or Mort, then going back to the early books if you want more.
    </p>
  </div>
</Layout>
