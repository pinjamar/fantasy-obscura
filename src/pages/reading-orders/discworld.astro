---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';
import { supabaseClient } from '../../lib/supabaseClient';

const bookData = [
  {
    title: 'Guards! Guards!',
    slug: 'guards-guards',
    status: 'mandatory' as const,
    note: 'Best starting point. Night Watch is introduced. Dragons invade Ankh-Morpork.',
    page_count: 288,
    publication_year: 1989,
  },
  {
    title: 'Men at Arms',
    slug: 'men-at-arms',
    status: 'mandatory' as const,
    note: 'The Watch grows. Carrot, Angua, diversity politics — Pratchett at his social best.',
    page_count: 300,
    publication_year: 1993,
  },
  {
    title: 'Feet of Clay',
    slug: 'feet-of-clay',
    status: 'mandatory' as const,
    note: 'Murder mystery involving golems. One of the sharpest Watch books.',
    page_count: 288,
    publication_year: 1996,
  },
  {
    title: 'Mort',
    slug: 'mort',
    status: 'optional' as const,
    note: 'Death takes an apprentice. The Death subseries — darkly funny and surprisingly moving.',
    page_count: 243,
    publication_year: 1987,
  },
  {
    title: 'Reaper Man',
    slug: 'reaper-man',
    status: 'optional' as const,
    note: 'Death gets fired and has to find a job. Surprisingly tender.',
    page_count: 252,
    publication_year: 1991,
  },
  {
    title: 'Small Gods',
    slug: 'small-gods',
    status: 'optional' as const,
    note: 'Standalone masterpiece about religion, faith, and institutional power. Read this.',
    page_count: 284,
    publication_year: 1992,
  },
  {
    title: 'Jingo',
    slug: 'jingo',
    status: 'mandatory' as const,
    note: 'City Watch #4. War satire. Vimes at his most furious and brilliant.',
    page_count: 288,
    publication_year: 1997,
  },
  {
    title: 'The Fifth Elephant',
    slug: 'the-fifth-elephant',
    status: 'mandatory' as const,
    note: 'Vimes goes on a diplomatic mission. Dwarves, werewolves, and a murder.',
    page_count: 321,
    publication_year: 1999,
  },
  {
    title: 'Night Watch',
    slug: 'night-watch',
    status: 'mandatory' as const,
    note: 'Time travel, revolution, and Vimes at his absolute best. One of the great Discworld books.',
    page_count: 338,
    publication_year: 2002,
  },
  {
    title: 'Going Postal',
    slug: 'going-postal',
    status: 'optional' as const,
    note: 'A con artist is forced to run the Ankh-Morpork post office. Perfect standalone entry.',
    page_count: 471,
    publication_year: 2004,
  },
];

const bookSlugs = bookData.map(b => b.slug);
const { data: coverRows } = await supabaseClient.from('books').select('slug, cover_url').in('slug', bookSlugs);
const coverMap = new Map<string, string | null>((coverRows ?? []).map((r: any) => [r.slug, r.cover_url ?? null]));
const books = bookData.map(b => ({ ...b, cover_url: coverMap.get(b.slug) ?? null }));

const totalPages = books.reduce((sum, b) => sum + (b.page_count ?? 0), 0);
const totalHours = Math.round(totalPages / 30);
const coreBooks = books.filter(b => b.status === 'mandatory').length;
---

<Layout
  title="Discworld Reading Order | Fantasy Obscura"
  description="Recommended reading order for Terry Pratchett's Discworld — starting with the City Watch subseries."
>

  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">← Reading Orders</a>
  </div>

  <div class="mb-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-purple-600 uppercase tracking-wider mb-1">Reading Order</p>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900">Discworld</h1>
        <p class="mt-1 text-lg text-zinc-500">by Terry Pratchett</p>
      </div>
      <span class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium">
        ✓ Completed Series (41 books)
      </span>
    </div>

    <div class="mt-5 flex flex-wrap gap-6 text-sm text-zinc-600 border-y border-zinc-100 py-4">
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📚</span> 41 total books ({coreBooks} in this guide)</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📄</span> ~{totalPages.toLocaleString()} pages (this guide)</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">⏱</span> ~{totalHours} hours reading time</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">🕯️🕯️</span> Mild darkness</span>
    </div>

    <p class="mt-5 text-base text-zinc-700 leading-relaxed max-w-2xl">
      Forty-one books of razor-sharp satire dressed as comedy fantasy. Pratchett used a flat world on the back of a turtle to say more about humanity than most literary fiction. You can start almost anywhere — but this guide gives you the best path in.
    </p>
  </div>

  <div class="mb-12">
    <h2 class="text-xl font-semibold mb-1">Recommended Reading Order (City Watch focus)</h2>
    <p class="text-sm text-zinc-500 mb-6">The City Watch arc is the most popular entry. All Discworld books work as standalones — this guide mixes Watch essentials with the best standalone picks.</p>
    <ReadingOrder books={books} client:load />
  </div>

  <div class="mb-10 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">
      <p class="font-semibold text-blue-900 mb-2">⚡ City Watch essentials ({coreBooks} books)</p>
      <p class="text-sm text-blue-800">Guards! Guards! → Men at Arms → Feet of Clay → Jingo → The Fifth Elephant → Night Watch. The main Watch arc.</p>
    </div>
    <div class="rounded-xl border border-green-100 bg-green-50 p-5">
      <p class="font-semibold text-green-900 mb-2">📖 Best standalone picks</p>
      <p class="text-sm text-green-800"><strong>Small Gods</strong> (standalone masterpiece), <strong>Mort</strong> (Death), <strong>Going Postal</strong> (great entry point). Can be read anytime.</p>
    </div>
  </div>

  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Why not start with book 1?</h2>
    <p class="text-sm text-zinc-700 leading-relaxed">
      The first two books (<em>The Colour of Magic</em>, <em>The Light Fantastic</em>) are Pratchett finding his voice — they're fine but very different from what the series becomes. Most fans and Pratchett himself recommended starting with <strong>Guards! Guards!</strong>, <strong>Mort</strong>, or <strong>Small Gods</strong> for a first-time reader.
    </p>
  </div>

  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Other subseries</h2>
    <div class="space-y-2 text-sm text-zinc-700">
      <div class="flex gap-3"><span class="font-medium w-32 shrink-0">Witches</span><span class="text-zinc-500">Wyrd Sisters, Witches Abroad, Maskerade — feminist, sharp, excellent</span></div>
      <div class="flex gap-3"><span class="font-medium w-32 shrink-0">Death</span><span class="text-zinc-500">Mort, Reaper Man, Soul Music, Hogfather — dark comedy at its best</span></div>
      <div class="flex gap-3"><span class="font-medium w-32 shrink-0">Tiffany Aching</span><span class="text-zinc-500">YA subseries — The Wee Free Men. Excellent starting point for younger readers</span></div>
      <div class="flex gap-3"><span class="font-medium w-32 shrink-0">Industrial Revolution</span><span class="text-zinc-500">Going Postal, Making Money, Raising Steam — Moist von Lipwig</span></div>
    </div>
  </div>

  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">What to know</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Every book is a standalone. You can read them in any order within a subseries.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Pratchett's satire gets sharper as the series progresses — the later Watch books are darker and angrier.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Night Watch is widely considered one of the best books in the entire series. Save it for when you love Vimes.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Pratchett wrote 41 Discworld novels before his death from Alzheimer's in 2015.</li>
    </ul>
  </div>

  <div class="border-t pt-8 flex flex-col sm:flex-row gap-6 justify-between">
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Want more Discworld?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/categories/cozy" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Browse Cozy Fantasy →</a>
        <a href="/craft" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Find books like Discworld →</a>
      </div>
    </div>
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Related reading orders</p>
      <div class="flex flex-wrap gap-3">
        <a href="/reading-orders/kingkiller" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">Kingkiller Chronicle</a>
        <a href="/reading-orders/first-law" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">The First Law</a>
      </div>
    </div>
  </div>

</Layout>
