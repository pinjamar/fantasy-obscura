---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';
import { supabaseClient } from '../../lib/supabaseClient';

const bookData = [
  { title: 'From Blood and Ash',         slug: 'from-blood-and-ash',         status: 'mandatory' as const, note: 'Start here. Poppy is a sheltered Maiden whose world unravels when she meets her guard Hawke. Slow-burn enemies-to-lovers with high tension and a twist ending.', page_count: 622, publication_year: 2020 },
  { title: 'A Kingdom of Flesh and Fire', slug: 'a-kingdom-of-flesh-and-fire', status: 'mandatory' as const, note: 'The slow burn ignites. Answers start coming and the world expands significantly. Darker tone than book one.', page_count: 651, publication_year: 2020 },
  { title: 'The Crown of Gilded Bones',   slug: 'the-crown-of-gilded-bones',   status: 'mandatory' as const, note: "Poppy's identity is fully revealed and the political scope broadens. The series shifts from romance-first to fantasy-first.", page_count: 728, publication_year: 2021 },
  { title: 'The War of Two Queens',       slug: 'the-war-of-two-queens',       status: 'mandatory' as const, note: 'War arc begins. Longer and more brutal — the romance takes a back seat to plot. Heavy on action and stakes.', page_count: 726, publication_year: 2022 },
  { title: 'A Soul of Ash and Blood',     slug: 'a-soul-of-ash-and-blood',     status: 'optional' as const,  note: "Retells book one from Hawke's POV. Not required — adds depth and context but contains no new plot. Best after book 4 or 5.", page_count: 829, publication_year: 2023 },
  { title: 'A Light in the Flame',        slug: 'a-light-in-the-flame',        status: 'mandatory' as const, note: 'Companion novel following Nyktos and Sera — set in a different era of the same world. Read after book 4 (The War of Two Queens).', page_count: 638, publication_year: 2023 },
  { title: 'A Fire in the Flesh',         slug: 'a-fire-in-the-flesh',         status: 'mandatory' as const, note: 'Continuation of the Rites of the Realms arc. The two storylines begin to converge.', page_count: 569, publication_year: 2023 },
  { title: 'A Veil of Gods and Skin',     slug: 'a-veil-of-gods-and-skin',     status: 'mandatory' as const, note: 'The Rites of the Realms trilogy concludes. Connects directly to the main Blood and Ash storyline.', page_count: 560, publication_year: 2024 },
];

const bookSlugs = bookData.map(b => b.slug);
const { data: dbRows } = await supabaseClient.from('books').select('slug, cover_url, darkness_level, avg_rating, series, series_number').in('slug', bookSlugs);
const dbMap = new Map<string, any>((dbRows ?? []).map((r: any) => [r.slug, r]));
const books = bookData.map(b => { const db = dbMap.get(b.slug); return { ...b, cover_url: db?.cover_url ?? null, darkness_level: db?.darkness_level ?? null, avg_rating: db?.avg_rating ?? null, series_label: db?.series && db?.series_number != null ? `${db.series} #${db.series_number}` : null }; });

const coreBooks = books.filter(b => b.status === 'mandatory');
const totalPages = books.reduce((sum, b) => sum + (b.page_count ?? 0), 0);
const totalHours = Math.round(totalPages / 30);

const groups = [
  {
    label: 'Blood and Ash',
    sublabel: 'main series — start here',
    books: books.slice(0, 5),
    noteType: 'required' as const,
    note: "The core story. All four main books are essential. A Soul of Ash and Blood (book 5) is optional — it retells book 1 from Hawke's POV with no new plot. Read it after book 4 or skip it.",
  },
  {
    label: 'Rites of the Realms',
    sublabel: 'companion trilogy — read after book 4',
    books: books.slice(5),
    noteType: 'warning' as const,
    note: 'A Light in the Flame begins a companion trilogy set in the same world but earlier in its history. The storylines converge — read these after The War of Two Queens, not alongside it.',
  },
];
---

<Layout
  title="Blood and Ash Reading Order (From Blood and Ash) | Fantasy Obscura"
  description="Complete reading order for Jennifer L. Armentrout's Blood and Ash series — main books, Hawke's POV retelling, and the Rites of the Realms companion trilogy."
>

  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">← Reading Orders</a>
  </div>

  {/* ── Header ── */}
  <div class="mb-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-purple-600 uppercase tracking-wider mb-1">Reading Order</p>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900">Blood and Ash</h1>
        <p class="mt-1 text-lg text-zinc-500">by Jennifer L. Armentrout</p>
      </div>
      <span class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-sm font-medium">
        ⏳ Ongoing Series
      </span>
    </div>

    <div class="mt-5 flex flex-wrap gap-6 text-sm text-zinc-600 border-y border-zinc-100 py-4">
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📚</span> {books.length} books ({coreBooks.length} essential)</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📄</span> ~{totalPages.toLocaleString()} pages total</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">⏱</span> ~{totalHours} hours reading time</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">🕯️🕯️🕯️</span> Serious · 🔥🔥🔥 Explicit</span>
    </div>

    <p class="mt-5 text-base text-zinc-700 leading-relaxed max-w-2xl">
      Romantasy with slow-burn enemies-to-lovers at its core — From Blood and Ash starts as a sheltered Maiden meets her mysterious guard and spirals into a full-scale fantasy epic. The first book reads like pure romantasy; by book three it's a proper political fantasy with war, gods, and a sprawling world. Explicit throughout.
    </p>
  </div>

  {/* ── Reading Order ── */}
  <div class="mb-12">
    <h2 class="text-xl font-semibold mb-1">Reading Order</h2>
    <p class="text-sm text-zinc-500 mb-6">The main series (books 1–4) comes first. The companion trilogy slots in after book 4 — the two stories converge by the end.</p>
    <ReadingOrder groups={groups} client:load />
  </div>

  {/* ── Quick Reference ── */}
  <div class="mb-10 grid gap-3 sm:grid-cols-3">
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">
      <p class="font-semibold text-blue-900 mb-2">💘 The Hook</p>
      <p class="text-sm text-blue-800"><strong>From Blood and Ash</strong> is slow-burn enemies-to-lovers with a sharp plot twist at the end. The tension between Poppy and Hawke carries the whole first book — and then the reveal reframes everything.</p>
    </div>
    <div class="rounded-xl border border-amber-100 bg-amber-50 p-5">
      <p class="font-semibold text-amber-900 mb-2">⚔️ The Shift</p>
      <p class="text-sm text-amber-800">By <strong>The Crown of Gilded Bones</strong>, romance takes a back seat to world-building and war. Books 3–4 are significantly more plot-heavy and darker than the first two.</p>
    </div>
    <div class="rounded-xl border border-purple-100 bg-purple-50 p-5">
      <p class="font-semibold text-purple-900 mb-2">🔥 Content Note</p>
      <p class="text-sm text-purple-800">All books contain <strong>explicit sexual content</strong>. The series also includes war violence, torture, and character death. Not suitable for younger readers.</p>
    </div>
  </div>

  {/* ── Where to Start ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Where to start</h2>
    <div class="space-y-3 text-sm text-zinc-700">
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>New to the series?</strong> Start with <strong>From Blood and Ash</strong> — no exceptions. The series is strictly sequential.</div>
      </div>
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>Finished book 4 — read the companion trilogy or continue the main story?</strong> The Rites of the Realms trilogy (starting with A Light in the Flame) is set in the same world but follows different characters. Read it after book 4 before book 5 comes out, or save it for later — both work.</div>
      </div>
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>Should you read A Soul of Ash and Blood?</strong> Only if you loved the slow-burn tension of book 1 and want to relive it from Hawke's perspective. It adds nothing to the plot — skip it if you want to keep moving forward.</div>
      </div>
    </div>
  </div>

  {/* ── What to Know ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">What to know</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The first book ends on a major twist that reframes everything. Go in without spoilers.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Books 1–2 are romance-heavy; books 3–4 shift toward epic fantasy. If you came for the romance, know the balance changes.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The world-building is gradually revealed — there's a lot of lore underneath the romance that only becomes clear in book 2 and 3.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Armentrout publishes quickly — books 1–4 released in under two years, and the companion trilogy followed closely.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The series shares its world with the Flesh and Fire series (also by Armentrout) — same universe, earlier timeline.</li>
    </ul>
  </div>

  {/* ── Darkness ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-4">Darkness across the series</h2>
    <div class="space-y-3 text-sm">
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">From Blood and Ash</span>
        <span class="text-zinc-400">🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Serious — sheltered world, danger present but filtered</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">A Kingdom of Flesh and Fire</span>
        <span class="text-zinc-400">🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Serious — darker tone, more violence, higher stakes</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">The Crown of Gilded Bones</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Dark — war begins, real consequences</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">The War of Two Queens</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Dark — war, torture, heavy losses</span>
      </div>
    </div>
    <p class="mt-4 text-xs text-zinc-400">Scale: 🕯️ Lighthearted → 🕯️🕯️🕯️🕯️🕯️ Brutal</p>
  </div>

  {/* ── Footer ── */}
  <div class="border-t pt-8 flex flex-col sm:flex-row gap-6 justify-between">
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Finished what's published?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/categories/romantasy" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Browse Romantasy →</a>
        <a href="/craft" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Find similar books →</a>
      </div>
    </div>
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Related reading orders</p>
      <div class="flex flex-wrap gap-3">
        <a href="/reading-orders/empyrean" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">The Empyrean (Fourth Wing)</a>
        <a href="/reading-orders/acotar" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">A Court of Thorns and Roses</a>
      </div>
    </div>
  </div>

</Layout>
