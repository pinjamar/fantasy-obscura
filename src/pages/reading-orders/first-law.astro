---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';
import { supabaseClient } from '../../lib/supabaseClient';

const bookData = [
  { title: 'The Blade Itself',       slug: 'the-blade-itself',       status: 'mandatory' as const, note: 'Start here. Introduces the full cast across three storylines.', page_count: 531, publication_year: 2006 },
  { title: 'Before They Are Hanged', slug: 'before-they-are-hanged', status: 'mandatory' as const, note: 'The quest, the siege, the politics — all accelerate.', page_count: 543, publication_year: 2007 },
  { title: 'Last Argument of Kings', slug: 'last-argument-of-kings', status: 'mandatory' as const, note: 'Brutal conclusion. Nothing lands the way you expect.', page_count: 639, publication_year: 2008 },
  { title: 'Best Served Cold',       slug: 'best-served-cold',       status: 'mandatory' as const, note: 'Revenge thriller set in Styria, 7 years later. Monza Murcatto assembles a crew.', page_count: 531, publication_year: 2009 },
  { title: 'The Heroes',             slug: 'the-heroes',             status: 'mandatory' as const, note: 'Three days of battle in the North. War dissected from every angle.', page_count: 544, publication_year: 2011 },
  { title: 'Red Country',            slug: 'red-country',            status: 'mandatory' as const, note: 'Western frontier fantasy. Shy South and a familiar stranger.', page_count: 473, publication_year: 2012 },
  { title: 'Sharp Ends',             slug: 'sharp-ends',             status: 'optional' as const,  note: 'Short story collection. Fills gaps between main books — best read after Red Country.', page_count: 352, publication_year: 2016 },
  { title: 'A Little Hatred',        slug: 'a-little-hatred',        status: 'mandatory' as const, note: 'Age of Madness begins. Industrial revolution, new generation, same rotten world.', page_count: 373, publication_year: 2019 },
  { title: 'The Trouble With Peace', slug: 'the-trouble-with-peace', status: 'mandatory' as const, note: 'Political tension escalates toward inevitable conflict.', page_count: 483, publication_year: 2020 },
  { title: 'The Wisdom of Crowds',   slug: 'the-wisdom-of-crowds',   status: 'mandatory' as const, note: 'Revolution, consequence, and the full weight of the series paying off.', page_count: 448, publication_year: 2021 },
];

// Fetch covers from DB
const bookSlugs = bookData.map(b => b.slug);
const { data: coverRows } = await supabaseClient.from('books').select('slug, cover_url').in('slug', bookSlugs);
const coverMap = new Map<string, string | null>((coverRows ?? []).map((r: any) => [r.slug, r.cover_url ?? null]));
const books = bookData.map(b => ({ ...b, cover_url: coverMap.get(b.slug) ?? null }));

const totalPages = books.reduce((sum, b) => sum + (b.page_count ?? 0), 0);
const totalHours = Math.round(totalPages / 30);
const coreBooks = books.filter(b => b.status === 'mandatory').length;

const groups = [
  {
    label: 'The Original Trilogy',
    sublabel: 'start here',
    books: books.slice(0, 3),
    noteType: 'required' as const,
    note: 'All three essential. Read in order — nothing should be skipped.',
  },
  {
    label: 'Standalones',
    sublabel: 'set in the same world, any order after the trilogy',
    books: books.slice(3, 6),
    noteType: 'optional' as const,
    note: "Each standalone works on its own but hits harder after the trilogy. Best Served Cold is the fan favourite. The Heroes is the weakest entry point. Read all three before starting Age of Madness.",
  },
  {
    label: 'Extra',
    sublabel: 'optional',
    books: books.slice(6, 7),
    noteType: 'optional' as const,
    note: 'Short story collection — fills gaps between the main books. Read after Red Country or skip entirely without losing anything essential.',
  },
  {
    label: 'The Age of Madness',
    sublabel: 'sequel trilogy',
    books: books.slice(7),
    noteType: 'warning' as const,
    note: 'Read the original trilogy plus at least two standalones first. Characters and payoffs depend heavily on what came before.',
  },
];


const darknessByArc = [
  { arc: 'Original Trilogy', level: 4, label: 'Dark — moral rot, betrayal, broken heroes' },
  { arc: 'Standalones', level: 4, label: 'Dark — revenge, war, frontier brutality' },
  { arc: 'Age of Madness', level: 5, label: 'Brutal — revolution, mass violence, no clean hands' },
];
---

<Layout
  title="The First Law Reading Order | Fantasy Obscura"
  description="Complete reading order for The First Law World by Joe Abercrombie — original trilogy, standalones, and Age of Madness."
>

  {/* Back nav */}
  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">← Reading Orders</a>
  </div>

  {/* ── Header ── */}
  <div class="mb-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-purple-600 uppercase tracking-wider mb-1">Reading Order</p>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900">The First Law World</h1>
        <p class="mt-1 text-lg text-zinc-500">by Joe Abercrombie</p>
      </div>
      <span class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium">
        ✓ Completed Series
      </span>
    </div>

    {/* Stats row */}
    <div class="mt-5 flex flex-wrap gap-6 text-sm text-zinc-600 border-y border-zinc-100 py-4">
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📚</span> {books.length} books ({coreBooks} essential)</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📄</span> ~{totalPages.toLocaleString()} pages total</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">⏱</span> ~{totalHours} hours reading time</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">🕯️🕯️🕯️🕯️</span> Dark → Brutal</span>
    </div>

    {/* Hook */}
    <p class="mt-5 text-base text-zinc-700 leading-relaxed max-w-2xl">
      A grimdark masterclass where the heroes are as broken as the villains — and the world keeps punishing both. Abercrombie dismantles every fantasy trope with wit, cruelty, and genuine craft.
    </p>
  </div>

  {/* ── Reading Order Timeline ── */}
  <div class="mb-12">
    <h2 class="text-xl font-semibold mb-1">Recommended Reading Order</h2>
    <p class="text-sm text-zinc-500 mb-6">Publication order = best reading order. Do not skip the standalones before Age of Madness.</p>
    <ReadingOrder
      groups={groups}
      client:load
    />
  </div>

  {/* ── Quick Reference ── */}
  <div class="mb-10 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">
      <p class="font-semibold text-blue-900 mb-2">⚡ Essential reads ({coreBooks} books)</p>
      <p class="text-sm text-blue-800">The Blade Itself → Last Argument of Kings → Best Served Cold → The Heroes → Red Country → Age of Madness trilogy. Skip none of these.</p>
    </div>
    <div class="rounded-xl border border-green-100 bg-green-50 p-5">
      <p class="font-semibold text-green-900 mb-2">📖 Optional (1 book)</p>
      <p class="text-sm text-green-800"><strong>Sharp Ends</strong> — short story collection. Adds flavour and backstory but nothing you'll miss if you skip it. Read after Red Country.</p>
    </div>
  </div>

  {/* ── Publication vs Chronological ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Publication order vs Chronological order</h2>
    <p class="text-sm text-zinc-700 leading-relaxed">
      These are the same. Abercrombie wrote the world in the order you should read it. The standalones (Best Served Cold, The Heroes, Red Country) happen between the trilogies but were published between them too — that's intentional. Reading them out of order spoils the payoff of both trilogies.
    </p>
    <div class="mt-4 text-sm text-zinc-600">
      <p class="font-medium mb-1">Timeline at a glance:</p>
      <ol class="space-y-1 list-none">
        <li class="flex gap-2"><span class="text-zinc-400 shrink-0">Y0–Y3</span> Original Trilogy (The Blade Itself → Last Argument of Kings)</li>
        <li class="flex gap-2"><span class="text-zinc-400 shrink-0">Y10</span> Best Served Cold (Styrian civil war)</li>
        <li class="flex gap-2"><span class="text-zinc-400 shrink-0">Y12</span> The Heroes (Battle of Osrung)</li>
        <li class="flex gap-2"><span class="text-zinc-400 shrink-0">Y14</span> Red Country (Far Country frontier)</li>
        <li class="flex gap-2"><span class="text-zinc-400 shrink-0">Y40</span> Age of Madness trilogy (next generation)</li>
      </ol>
    </div>
  </div>

  {/* ── Safe Starting Points ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Safe starting point</h2>
    <p class="text-sm text-zinc-700 leading-relaxed">
      <strong>Start with The Blade Itself</strong> — no exceptions. The standalones and Age of Madness trilogy carry heavy spoilers for the original trilogy and reward readers who've grown attached to the characters. Jumping in at Best Served Cold or A Little Hatred is technically possible but significantly reduces the impact.
    </p>
    <div class="mt-3 inline-flex items-center gap-2 text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
      <span>⚠️</span> Do not start with Age of Madness — it spoils the original trilogy ending.
    </div>
  </div>

  {/* ── Spoiler-free Notes ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Spoiler-free notes</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The Blade Itself starts slowly — the payoff is in book 2 and 3. Trust the setup.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Each standalone follows different protagonists, but familiar faces appear throughout.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The standalones are not filler — events in them directly shape the Age of Madness world.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Sharp Ends short stories are best read scattered throughout or all at the end — not before the standalones.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Age of Madness is darker than the original trilogy. The world has changed, and not for the better.</li>
    </ul>
  </div>

  {/* ── Darkness Progression ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-4">Darkness progression</h2>
    <div class="space-y-3">
      {darknessByArc.map(arc => (
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 text-sm">
          <span class="font-medium text-zinc-700 sm:w-44 shrink-0">{arc.arc}</span>
          <span class="text-zinc-400">{'🕯️'.repeat(arc.level)}{'　'.repeat(5 - arc.level)}</span>
          <span class="text-zinc-500">{arc.label}</span>
        </div>
      ))}
    </div>
    <p class="mt-4 text-xs text-zinc-400">Scale: 🕯️ Lighthearted → 🕯️🕯️🕯️🕯️🕯️ Brutal</p>
  </div>

  {/* ── Footer ── */}
  <div class="border-t pt-8 flex flex-col sm:flex-row gap-6 justify-between">
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Finished the series?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/categories/grimdark" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Browse more Grimdark →</a>
        <a href="/craft" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Find books like First Law →</a>
      </div>
    </div>
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Related reading orders</p>
      <div class="flex flex-wrap gap-3">
        <a href="/reading-orders/malazan" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">Malazan Book of the Fallen</a>
        <a href="/reading-orders/kingkiller" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">Kingkiller Chronicle</a>
      </div>
    </div>
  </div>

</Layout>
