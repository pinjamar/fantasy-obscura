---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';

const books = [
  {
    title: 'The Blade Itself',
    status: 'mandatory' as const,
    note: 'First book of the original trilogy. Start here.'
  },
  {
    title: 'Before They Are Hanged',
    status: 'mandatory' as const,
    note: 'Second book of the original trilogy.'
  },
  {
    title: 'Last Argument of Kings',
    status: 'mandatory' as const,
    note: 'Concludes the original trilogy.'
  },
  {
    title: 'Best Served Cold',
    status: 'mandatory' as const,
    note: 'Standalone set 7 years after the trilogy. Revenge tale in Styria.'
  },
  {
    title: 'The Heroes',
    status: 'mandatory' as const,
    note: 'Standalone battle story. Three days of warfare in the North.'
  },
  {
    title: 'Red Country',
    status: 'mandatory' as const,
    note: 'Western-inspired standalone. Set in the Far Country.'
  },
  {
    title: 'Sharp Ends',
    status: 'optional' as const,
    note: 'Short story collection. Read after Red Country.'
  },
  {
    title: 'A Little Hatred',
    status: 'mandatory' as const,
    note: 'First book of Age of Madness trilogy, 30 years later.'
  },
  {
    title: 'The Trouble With Peace',
    status: 'mandatory' as const,
    note: 'Second book of Age of Madness.'
  },
  {
    title: 'The Wisdom of Crowds',
    status: 'mandatory' as const,
    note: 'Concludes the Age of Madness trilogy.'
  },
];
---

<Layout
  title="The First Law Reading Order | Fantasy Obscura"
  description="Complete reading order for The First Law series by Joe Abercrombie."
>
  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-blue-600 hover:underline">← Back to Reading Orders</a>
  </div>

  <h1 class="text-4xl font-bold tracking-tight">The First Law Reading Order</h1>
  <p class="mt-2 text-zinc-600">by Joe Abercrombie</p>

  <div class="mt-8">
    <ReadingOrder
      books={books}
      description="Start with the original trilogy, then read the three standalones before moving to the Age of Madness trilogy. Each standalone works on its own but builds on previous books."
      client:load
    />
  </div>

  <div class="mt-12 rounded-lg border bg-zinc-50 p-6">
    <h2 class="font-semibold mb-3">Reading Notes</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li>✓ The standalones feature different protagonists but share the same world</li>
      <li>✓ Events in the standalones impact the Age of Madness trilogy</li>
      <li>✓ Sharp Ends contains stories set throughout the timeline</li>
      <li>✓ Publication order = best reading order for maximum impact</li>
    </ul>
  </div>
</Layout>
