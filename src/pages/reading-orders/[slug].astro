---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';
import { getReadingOrderEntry, READING_ORDERS } from '../../data/reading-orders';
import type { ReadingOrderEntry } from '../../data/reading-orders';
import { getAllSeries, getBooksBySeries, authorToSlug } from '../../lib/db/books';
import { supabaseClient } from '../../lib/supabaseClient';
import { READING_ORDER_IMAGE_SLUG, readingOrderSrcset, readingOrderFallback } from '../../data/image-map';
import { BOOKS_LIKE } from '../../data/books-like';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/reading-orders/');

function upgradeCoverUrl(url: string | null | undefined): string {
  if (!url) return '';
  if (url.includes('archive.org')) return '';
  if (url.includes('books.google.com/books/content')) {
    const m = url.match(/[?&]id=([^&]+)/);
    if (m) return `https://books.google.com/books/publisher/content/images/frontcover/${m[1]}?fife=w400-h600`;
  }
  return url.replace(/-M\.jpg/, '-L.jpg');
}

const DARKNESS_CANDLES = ['', '🕯️', '🕯️🕯️', '🕯️🕯️🕯️', '🕯️🕯️🕯️🕯️', '🕯️🕯️🕯️🕯️🕯️'];

// ── Curated path ──────────────────────────────────────────────────────────────
const dbSlugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
let entry = getReadingOrderEntry(slug);
if (!entry) {
  // If the DB-derived slug for a curated entry's name matches this slug,
  // redirect to the canonical curated slug (e.g. "memory-sorrow-and-thorn" → "memory-sorrow-thorn")
  const nameMatch = READING_ORDERS.find((e) => dbSlugify(e.name) === slug);
  if (nameMatch) return Astro.redirect(`/reading-orders/${nameMatch.slug}/`, 301);
}

type MergedBook = {
  title: string; slug: string; status: string; note: string;
  page_count: number; publication_year: number;
  cover_url: string | null; darkness_level: number | null;
  heat_level: string | null;
  avg_rating: number | null; series_label: string | null;
  position?: number | null;
  seriesLabel?: string | null;
};

let isCurated = false;
let curatedEntry: ReadingOrderEntry | null = null;
let mergedGroups: { label: string; sublabel?: string; note?: string; noteType?: string; books: MergedBook[] }[] | null = null;
let mergedBooks: MergedBook[] | null = null;
let totalPagesCurated = 0;
let totalHoursCurated = 0;
let coreCount = 0;
let allBooksCurated: MergedBook[] = [];

if (entry) {
  isCurated = true;
  curatedEntry = entry;

  const rawBooks = entry.groups
    ? entry.groups.flatMap((g) => g.books)
    : (entry.books ?? []);
  const bookSlugs = rawBooks.map((b) => b.slug).filter(Boolean);

  const { data: dbRows } = await supabaseClient
    .from('books')
    .select('slug, cover_url, isbn, darkness_level, heat_level, avg_rating, series, series_number')
    .in('slug', bookSlugs);
  const dbMap = new Map<string, any>((dbRows ?? []).map((r: any) => [r.slug, r]));

  function mergeBook(b: typeof rawBooks[number]): MergedBook {
    const db = dbMap.get(b.slug);
    return {
      ...b,
      cover_url: upgradeCoverUrl(db?.cover_url) || (db?.isbn ? `https://covers.openlibrary.org/b/isbn/${db.isbn}-L.jpg?default=false` : null),
      darkness_level: db?.darkness_level ?? null,
      heat_level: db?.heat_level ?? null,
      avg_rating: db?.avg_rating ?? null,
      series_label: db?.series && db?.series_number != null ? `${db.series} #${db.series_number}` : null,
      position: b.position ?? null,
      seriesLabel: (b as any).seriesLabel ?? null,
    };
  }

  if (entry.groups) {
    mergedGroups = entry.groups.map((g) => ({ ...g, books: g.books.map(mergeBook) }));
    allBooksCurated = mergedGroups.flatMap((g) => g.books);
  } else if (entry.books) {
    mergedBooks = entry.books.map(mergeBook);
    allBooksCurated = mergedBooks;
  }

  totalPagesCurated = allBooksCurated.reduce((s, b) => s + (b.page_count ?? 0), 0);
  totalHoursCurated = Math.round(totalPagesCurated / 30);
  coreCount = allBooksCurated.filter((b) => b.status === 'mandatory').length;
}

// ── DB-driven fallback ────────────────────────────────────────────────────────
let seriesMeta: Awaited<ReturnType<typeof getAllSeries>>[number] | null = null;
let dbBooks: Awaited<ReturnType<typeof getBooksBySeries>> = [];
let authorNames: string[] = [];
let books: any[] = [];
let similarSeries: { name: string; slug: string; cover: string | null; score: number; avgRating: number | null }[] = [];
let contentWarnings: string[] = [];
let avgRatingDb: string | null = null;
let totalPagesDb = 0;
let topSubgenres: string[] = [];
let topTropes: string[] = [];

if (!isCurated) {
  const allSeries = await getAllSeries();
  seriesMeta = allSeries.find((s) => s.slug === slug) ?? null;

  // Fallback: series has <2 books — find by wildcard matching the slug pattern
  if (!seriesMeta) {
    const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const wildcardPattern = '%' + slug.split('-').join('%') + '%';
    const { data: candidates } = await supabaseClient
      .from('books')
      .select('series')
      .ilike('series', wildcardPattern)
      .not('series', 'is', null)
      .limit(20);
    const matchedSeries = (candidates ?? []).find((b) => b.series && toSlug(b.series) === slug)?.series ?? null;
    if (matchedSeries) {
      seriesMeta = { name: matchedSeries, slug, bookCount: 1 };
    }
  }

  if (!seriesMeta) return new Response(null, { status: 404, statusText: 'Not Found' });

  dbBooks = await getBooksBySeries(seriesMeta.name);

  // Only 1 book in DB — not enough for a series page. Redirect to the author's page instead.
  if (dbBooks.length <= 1) {
    const authors: string[] = dbBooks[0]?.authors ?? [];
    if (authors.length > 0) {
      return Astro.redirect(`/authors/${authorToSlug(authors[0])}/`, 302);
    }
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }

  books = dbBooks.map((b) => ({
    title: b.title,
    slug: b.slug ?? null,
    cover_url: b.cover_url ?? null,
    publication_year: b.publication_year ?? null,
    page_count: b.page_count ?? null,
    darkness_level: (b as any).darkness_level ?? null,
    avg_rating: (b as any).avg_rating ?? null,
    series_number: (b as any).series_number ?? null,
    synopsis: (b as any).synopsis ?? null,
  }));

  authorNames = [...new Set(dbBooks.flatMap((b) => b.authors ?? []))];

  const allSubgenres = dbBooks.flatMap((b) => (b as any).subgenres ?? []);
  const subgenreCounts = new Map<string, number>();
  for (const g of allSubgenres) subgenreCounts.set(g, (subgenreCounts.get(g) ?? 0) + 1);
  topSubgenres = [...subgenreCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([g]) => g);

  const allTropes = dbBooks.flatMap((b) => (b as any).tropes ?? []);
  const tropeCounts = new Map<string, number>();
  for (const t of allTropes) tropeCounts.set(t, (tropeCounts.get(t) ?? 0) + 1);
  topTropes = [...tropeCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([t]) => t);

  contentWarnings = [...new Set(dbBooks.flatMap((b) => (b as any).content_warnings ?? []))].sort() as string[];

  type SimilarRow = { series: string | null; cover_url: string | null; avg_rating: number | null; subgenres: string[] | null; tropes: string[] | null };
  const { data: similarRaw } = await supabaseClient
    .from('books')
    .select('series, cover_url, avg_rating, subgenres, tropes')
    .not('series', 'is', null)
    .neq('series', seriesMeta.name)
    .eq('series_number', 1) as { data: SimilarRow[] | null };

  const seriesScore = new Map<string, { score: number; cover: string | null; ratings: number[] }>();
  for (const row of similarRaw ?? []) {
    if (!row.series) continue;
    const subgenreOverlap = (row.subgenres ?? []).filter((g) => topSubgenres.includes(g)).length;
    const tropeOverlap = (row.tropes ?? []).filter((t) => topTropes.includes(t)).length;
    const score = subgenreOverlap * 2 + tropeOverlap;
    if (score === 0) continue;
    seriesScore.set(row.series, { score, cover: row.cover_url, ratings: row.avg_rating != null ? [row.avg_rating] : [] });
  }

  if (seriesScore.size > 0) {
    type RatingRow = { series: string | null; avg_rating: number | null };
    const { data: allRatings } = await supabaseClient
      .from('books').select('series, avg_rating')
      .in('series', [...seriesScore.keys()])
      .not('avg_rating', 'is', null) as { data: RatingRow[] | null };
    for (const row of allRatings ?? []) {
      if (!row.series || row.avg_rating == null) continue;
      const e = seriesScore.get(row.series);
      if (e && !e.ratings.includes(row.avg_rating)) e.ratings.push(row.avg_rating);
    }
  }

  similarSeries = [...seriesScore.entries()]
    .map(([name, v]) => {
      const avgRating = v.ratings.length ? v.ratings.reduce((s, r) => s + r, 0) / v.ratings.length : null;
      return { name, slug: name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''), cover: v.cover, score: v.score, avgRating };
    })
    .sort((a, b) => b.score - a.score || (b.avgRating ?? 0) - (a.avgRating ?? 0))
    .slice(0, 8);

  totalPagesDb = books.reduce((sum, b) => sum + (b.page_count ?? 0), 0);
  const ratedBooks = books.filter(b => b.avg_rating != null);
  avgRatingDb = ratedBooks.length
    ? (ratedBooks.reduce((s, b) => s + (b.avg_rating ?? 0), 0) / ratedBooks.length).toFixed(2)
    : null;
}

// ── Non-curated derived display values ────────────────────────────────────────
const dbYears = books.map(b => b.publication_year).filter(Boolean) as number[];
const dbYearMin = dbYears.length ? Math.min(...dbYears) : null;
const dbYearMax = dbYears.length ? Math.max(...dbYears) : null;
const dbYearRange = dbYearMin && dbYearMax
  ? dbYearMin === dbYearMax ? `${dbYearMin}` : `${dbYearMin}–${dbYearMax}`
  : null;

const dbDarknessLevels = books.map(b => b.darkness_level).filter(Boolean) as number[];
const dbAvgDarkness = dbDarknessLevels.length
  ? Math.round(dbDarknessLevels.reduce((s, d) => s + d, 0) / dbDarknessLevels.length)
  : null;
const CANDLES = ['', '🕯️', '🕯️🕯️', '🕯️🕯️🕯️', '🕯️🕯️🕯️🕯️', '🕯️🕯️🕯️🕯️🕯️'];
const DARKNESS_LABELS = ['', 'Lighthearted', 'Mild', 'Serious', 'Dark', 'Brutal'];

// Curated series: compute darkness + heat from DB values of the core books
const HEAT_ORDER = ['Closed Door', 'Sweet Romance', 'Open Door', 'Explicit', 'Fiery'];
const HEAT_FLAMES = ['', '🔥', '🔥🔥', '🔥🔥🔥', '🔥🔥🔥🔥', '🔥🔥🔥🔥🔥'];
const curatedCoreBooks = (mergedBooks ?? allBooksCurated).filter(b => b.status === 'essential' || b.status === 'core' || b.status === 'mandatory');
const curatedDarknessLevels = curatedCoreBooks.map(b => b.darkness_level).filter(Boolean) as number[];
const curatedAvgDarkness = curatedDarknessLevels.length
  ? Math.round(curatedDarknessLevels.reduce((s, d) => s + d, 0) / curatedDarknessLevels.length)
  : null;
const curatedHeatValues = curatedCoreBooks.map(b => b.heat_level).filter(Boolean) as string[];
const curatedMaxHeat = curatedHeatValues.length
  ? curatedHeatValues.reduce((max, h) => HEAT_ORDER.indexOf(h) > HEAT_ORDER.indexOf(max) ? h : max, curatedHeatValues[0])
  : null;
const curatedDarknessDisplay = (() => {
  const parts: string[] = [];
  if (curatedAvgDarkness) parts.push(`${CANDLES[curatedAvgDarkness]} ${DARKNESS_LABELS[curatedAvgDarkness]}`);
  if (curatedMaxHeat) {
    const hi = HEAT_ORDER.indexOf(curatedMaxHeat) + 1;
    parts.push(`${HEAT_FLAMES[hi]} ${curatedMaxHeat}`);
  }
  return parts.join(' · ') || curatedEntry?.darknessDisplay || '';
})();

const dbHeatValues = dbBooks.map(b => (b as any).heat_level).filter(Boolean) as string[];
const dbMaxHeat = dbHeatValues.length
  ? dbHeatValues.reduce((max, h) => HEAT_ORDER.indexOf(h) > HEAT_ORDER.indexOf(max) ? h : max, dbHeatValues[0])
  : null;
const dbMaxHeatDisplay = dbMaxHeat ? (() => {
  const hi = HEAT_ORDER.indexOf(dbMaxHeat) + 1;
  return `${HEAT_FLAMES[hi]} ${dbMaxHeat}`;
})() : null;

// Card color classes
const cardColors: Record<string, { border: string; bg: string; title: string; body: string }> = {
  blue:   { border: 'border-blue-100',   bg: 'bg-blue-50',   title: 'text-blue-900',   body: 'text-blue-800'   },
  green:  { border: 'border-green-100',  bg: 'bg-green-50',  title: 'text-green-900',  body: 'text-green-800'  },
  amber:  { border: 'border-amber-100',  bg: 'bg-amber-50',  title: 'text-amber-900',  body: 'text-amber-800'  },
  red:    { border: 'border-red-100',    bg: 'bg-red-50',    title: 'text-red-900',    body: 'text-red-800'    },
  purple: { border: 'border-purple-100', bg: 'bg-purple-50', title: 'text-purple-900', body: 'text-purple-800' },
};

const pageTitle = curatedEntry
  ? `${curatedEntry.name} Reading Order: All ${curatedEntry.author} Books in Order | The Grimoire`
  : `${seriesMeta?.name} Series Reading Order${authorNames.length ? `: All ${authorNames[0]} Books in Order` : ''} | The Grimoire`;
const pageDesc = curatedEntry
  ? `Complete reading order for ${curatedEntry.name} by ${curatedEntry.author} — ${allBooksCurated.length} books, ${coreCount} core${allBooksCurated.length - coreCount > 0 ? ` + ${allBooksCurated.length - coreCount} optional` : ''}. What to read first, what's skippable.`
  : `Complete reading order for ${seriesMeta?.name}${authorNames.length ? ` by ${authorNames.slice(0, 2).join(' & ')}` : ''}. All ${seriesMeta?.bookCount ?? dbBooks.length} books in order — what to read first and what comes next.`;

const SITE = 'https://thegrimoire.co';
const imgSlug = READING_ORDER_IMAGE_SLUG[slug!];
const heroImageUrl = imgSlug ? `${SITE}${readingOrderFallback(imgSlug)}` : null;
const seriesName = isCurated ? curatedEntry?.name : seriesMeta?.name;

// Find matching Books Like guide for this series
const matchingBooksLike = seriesName
  ? BOOKS_LIKE.find(e =>
      e.source.series?.toLowerCase() === seriesName.toLowerCase() ||
      e.source.title.toLowerCase() === seriesName.toLowerCase()
    )
  : null;
const seriesAuthor = isCurated ? curatedEntry?.author : (authorNames[0] ?? null);
const seriesBookList = (isCurated ? allBooksCurated : dbBooks).slice(0, 20);
const readingOrderJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BookSeries',
  name: seriesName,
  url: `${SITE}/reading-orders/${slug}/`,
  description: pageDesc,
  ...(seriesAuthor ? { author: { '@type': 'Person', name: seriesAuthor } } : {}),
  ...(heroImageUrl ? { image: heroImageUrl } : {}),
  hasPart: seriesBookList.map((b, i) => ({
    '@type': 'Book',
    position: i + 1,
    name: b.title,
    ...(b.slug ? { url: `${SITE}/books/${b.slug}/` } : {}),
    ...((b as any).publication_year ? { datePublished: String((b as any).publication_year) } : {}),
    ...((b as any).page_count ? { numberOfPages: (b as any).page_count } : {}),
  })),
});

const itemListJsonLd = isCurated ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${seriesName} Reading Order`,
  url: `${SITE}/reading-orders/${slug}/`,
  numberOfItems: allBooksCurated.length,
  itemListElement: allBooksCurated.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.title,
    ...(b.slug ? { url: `${SITE}/books/${b.slug}/` } : {}),
  })),
}) : null;

const faqItems = (curatedEntry?.sections ?? []).filter(s => s.prose || (s.bullets && s.bullets.length > 0));
const faqJsonLd = faqItems.length > 0 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(s => ({
    '@type': 'Question',
    name: s.heading,
    acceptedAnswer: {
      '@type': 'Answer',
      text: s.prose ?? (s.bullets ?? []).join(' '),
    },
  })),
}) : null;

const seoProseText = curatedEntry
  ? `Looking for the complete ${curatedEntry.name} reading order? This guide covers all ${allBooksCurated.filter(b => b.status !== 'upcoming').length} ${curatedEntry.author} books in ${curatedEntry.name} in order — including which are essential, which are optional, and the best place to start. Whether you're reading ${curatedEntry.name} for the first time or catching up before the next release, this is the order we recommend.`
  : null;

// ── Non-curated SEO additions ─────────────────────────────────────────────────
const dbShouldNoIndex = !isCurated && (seriesMeta?.bookCount ?? 0) < 3;

const dbItemListJsonLd = !isCurated && seriesMeta ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${seriesMeta.name} Reading Order`,
  url: `${SITE}/reading-orders/${slug}/`,
  numberOfItems: books.length,
  itemListElement: books.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.title,
    ...(b.slug ? { url: `${SITE}/books/${b.slug}/` } : {}),
  })),
}) : null;

const dbTotalHours = totalPagesDb > 0 ? Math.round(totalPagesDb / 30) : null;
const dbFaqJsonLd = !isCurated && seriesMeta ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `How many books are in ${seriesMeta.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${seriesMeta.name} contains ${seriesMeta.bookCount} ${seriesMeta.bookCount === 1 ? 'book' : 'books'}${authorNames.length ? ` by ${authorNames.slice(0, 2).join(' & ')}` : ''}.`,
      },
    },
    {
      '@type': 'Question',
      name: `What order should I read ${seriesMeta.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Read ${seriesMeta.name} in publication order, starting with book one. Each book builds on the events of the previous, so following the order listed on this page is the recommended approach.`,
      },
    },
    ...(dbTotalHours ? [{
      '@type': 'Question',
      name: `How long does it take to read ${seriesMeta.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${seriesMeta.name} spans approximately ${totalPagesDb.toLocaleString()} pages across all ${seriesMeta.bookCount} books — roughly ${dbTotalHours} hours of reading at an average pace.`,
      },
    }] : []),
  ],
}) : null;

const dbSeoProse = !isCurated && seriesMeta
  ? `Looking for the complete ${seriesMeta.name} reading order?${authorNames.length ? ` This guide lists all ${seriesMeta.bookCount} ${authorNames[0]} books in ${seriesMeta.name} in order` : ` This guide lists all ${seriesMeta.bookCount} books in ${seriesMeta.name} in order`} — with covers, ratings, and page counts for every entry.${totalPagesDb > 0 ? ` The full series spans approximately ${totalPagesDb.toLocaleString()} pages.` : ''}`
  : null;
---

<Layout title={pageTitle} description={pageDesc} image={heroImageUrl || undefined}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={readingOrderJsonLd} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Reading Orders', item: `${SITE}/reading-orders/` },
        { '@type': 'ListItem', position: 2, name: seriesName, item: `${SITE}/reading-orders/${slug}/` },
      ],
    })} />
    {itemListJsonLd && <script is:inline type="application/ld+json" set:html={itemListJsonLd} />}
    {faqJsonLd && <script is:inline type="application/ld+json" set:html={faqJsonLd} />}
    {dbItemListJsonLd && <script is:inline type="application/ld+json" set:html={dbItemListJsonLd} />}
    {dbFaqJsonLd && <script is:inline type="application/ld+json" set:html={dbFaqJsonLd} />}
    {dbShouldNoIndex && <meta name="robots" content="noindex, follow" />}
  </Fragment>

{isCurated && curatedEntry && (
  <>
    <!-- Back link -->
    <div class="mb-6">
      <a href="/reading-orders/" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">← Reading Orders</a>
    </div>

    <!-- Hero image (if available) -->
    {(() => {
      const imgSlug = READING_ORDER_IMAGE_SLUG[slug!];
      return imgSlug ? (
        <div class="relative rounded-2xl overflow-hidden mb-8 border border-zinc-200">
          <picture>
            <source type="image/avif" srcset={readingOrderSrcset(imgSlug, 'avif')} sizes="(min-width: 1024px) 800px, 100vw" />
            <source type="image/webp" srcset={readingOrderSrcset(imgSlug, 'webp')} sizes="(min-width: 1024px) 800px, 100vw" />
            <img src={readingOrderFallback(imgSlug)} alt="" width="800" height="400" loading="eager" decoding="async" class="w-full aspect-3/1 object-cover" />
          </picture>
          <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent" />
          <div class="absolute inset-0 px-6 py-6 flex flex-col justify-end">
            <p class="text-xs font-semibold uppercase tracking-widest text-white/60 mb-1">Reading Order</p>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white [text-shadow:0_1px_4px_rgba(0,0,0,0.6)]">{curatedEntry.name}</h1>
            <p class="mt-1 text-sm text-white/75">by {curatedEntry.author}</p>
          </div>
        </div>
      ) : null;
    })()}

    <!-- Header -->
    <div class="mb-10">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-4xl font-bold tracking-tight text-zinc-900">{curatedEntry.name} Reading Order</h1>
          <p class="mt-1 text-lg text-zinc-500">by <a href={`/authors/${authorToSlug(curatedEntry.author)}/`} class="hover:text-purple-700 hover:underline transition-colors">{curatedEntry.author}</a></p>
        </div>
        <span class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium">
          {curatedEntry.seriesStatusLabel}
        </span>
      </div>

      <div class="mt-5 flex flex-wrap gap-6 text-sm text-zinc-600 border-y border-zinc-100 py-4">
        <span class="flex items-center gap-1.5"><span class="text-zinc-400">📚</span> {allBooksCurated.filter((b: any) => b.status !== 'upcoming').length} books ({coreCount} essential)</span>
        {totalPagesCurated > 0 && (
          <span class="flex items-center gap-1.5"><span class="text-zinc-400">📄</span> ~{totalPagesCurated.toLocaleString()} pages</span>
        )}
        {totalHoursCurated > 0 && (
          <span class="flex items-center gap-1.5"><span class="text-zinc-400">⏱</span> ~{totalHoursCurated} hours reading time</span>
        )}
        <span class="flex items-center gap-1.5">{curatedDarknessDisplay}</span>
      </div>

      <p class="mt-5 text-base text-zinc-700 leading-relaxed">{curatedEntry.description}</p>
      {seoProseText && (
        <p class="hidden mt-3 text-sm text-zinc-400 leading-relaxed">{seoProseText}</p>
      )}
    </div>

    <!-- Warning block -->
    {curatedEntry.warning && (
      <div class="mb-8 rounded-xl border border-amber-200 bg-amber-50/60 px-5 py-4">
        <p class="text-sm text-amber-900">⚠️ {curatedEntry.warning}</p>
      </div>
    )}

    <!-- Quick cards (above timeline) -->
    {curatedEntry.cards && curatedEntry.cards.length > 0 && curatedEntry.cardsPosition === 'above' && (
      <div class={`mb-8 grid gap-3 ${curatedEntry.cards.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3'}`}>
        {curatedEntry.cards.map((card) => {
          const cc = cardColors[card.color] ?? cardColors.blue;
          return (
            <div class={`rounded-xl border ${cc.border} ${cc.bg} p-5`}>
              <p class={`font-semibold ${cc.title} mb-2`}>{card.title}</p>
              <p class={`text-sm ${cc.body}`} set:html={card.body} />
            </div>
          );
        })}
      </div>
    )}

    <!-- Reading Order -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold mb-1">Reading Order</h2>
      {curatedEntry.orderNote && (
        <p class="text-sm text-zinc-500 mb-6">{curatedEntry.orderNote}</p>
      )}
      {mergedGroups ? (
        <ReadingOrder groups={mergedGroups as any} client:load />
      ) : mergedBooks ? (
        <ReadingOrder books={mergedBooks as any} client:load />
      ) : null}
    </div>

    <!-- Quick cards (below timeline) -->
    {curatedEntry.cards && curatedEntry.cards.length > 0 && curatedEntry.cardsPosition !== 'above' && (
      <div class={`mb-10 grid gap-3 ${curatedEntry.cards.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3'}`}>
        {curatedEntry.cards.map((card) => {
          const cc = cardColors[card.color] ?? cardColors.blue;
          return (
            <div class={`rounded-xl border ${cc.border} ${cc.bg} p-5`}>
              <p class={`font-semibold ${cc.title} mb-2`}>{card.title}</p>
              <p class={`text-sm ${cc.body}`} set:html={card.body} />
            </div>
          );
        })}
      </div>
    )}

    <!-- Info sections -->
    {curatedEntry.sections && curatedEntry.sections.map((section) => (
      <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
        {section.type === 'warning' ? (
          <>
            <h2 class="font-semibold text-amber-900 mb-3">⚠️ {section.heading}</h2>
            {section.prose && <p class="text-sm text-amber-800">{section.prose}</p>}
            {section.bullets && (
              <ul class="space-y-2 text-sm text-amber-800">
                {section.bullets.map((b) => (
                  <li class="flex gap-2"><span class="text-amber-400">→</span> <span set:html={b} /></li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <>
            <h2 class="font-semibold text-zinc-900 mb-3">{section.heading}</h2>
            {section.prose && <p class="text-sm text-zinc-700 leading-relaxed">{section.prose}</p>}
            {section.bullets && (
              <ul class="space-y-2 text-sm text-zinc-700">
                {section.bullets.map((b) => (
                  <li class="flex gap-2"><span class="text-zinc-400">→</span> <span set:html={b} /></li>
                ))}
              </ul>
            )}
          </>
        )}
      </div>
    ))}

    <!-- Darkness table -->
    {curatedEntry.darkness && curatedEntry.darkness.length > 0 && (
      <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
        <h2 class="font-semibold text-zinc-900 mb-4">Darkness progression</h2>
        <div class="space-y-3 text-sm">
          {curatedEntry.darkness.map((row) => (
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
              <span class="font-medium text-zinc-700 sm:w-44 shrink-0">{row.label}</span>
              <span class="text-zinc-400">{DARKNESS_CANDLES[row.level] ?? ''}</span>
              <span class="text-zinc-500">{row.desc}</span>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs text-zinc-400">Scale: 🕯️ Lighthearted → 🕯️🕯️🕯️🕯️🕯️ Brutal</p>
      </div>
    )}

    <!-- Footer -->
    <div class="mt-12 rounded-2xl bg-zinc-50 border border-zinc-200 px-6 py-6 flex flex-col sm:flex-row gap-8">
      <div class="flex-1">
        <p class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">{curatedEntry.finishedLabel}</p>
        <div class="flex flex-wrap gap-2">
          <a href={curatedEntry.categoryHref} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-purple-100 text-purple-700 hover:bg-purple-200 transition-colors text-sm font-medium">
            {curatedEntry.categoryLabel} →
          </a>
          {curatedEntry.booksLikeSlug && (
            <a href={`/books-like/${curatedEntry.booksLikeSlug}/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-purple-100 text-purple-700 hover:bg-purple-200 transition-colors text-sm font-medium">
              📚 Books like {curatedEntry.name} →
            </a>
          )}
        </div>
      </div>
      {curatedEntry.related.length > 0 && (
        <div class="sm:border-l sm:border-zinc-200 sm:pl-8">
          <p class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">More reading orders</p>
          <div class="flex flex-col gap-2">
            {curatedEntry.related.map((relSlug) => {
              const relEntry = getReadingOrderEntry(relSlug);
              return (
                <a href={`/reading-orders/${relSlug}/`} class="text-sm text-zinc-600 hover:text-purple-700 transition-colors font-medium">
                  {relEntry?.name ?? relSlug} →
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </>
)}

{!isCurated && seriesMeta && (
  <>
    <!-- Breadcrumb -->
    <nav class="text-sm text-zinc-400 mb-8 flex items-center gap-2">
      <a href="/reading-orders/" class="hover:text-zinc-700 transition-colors">Reading Orders</a>
      <span>›</span>
      <span class="text-zinc-700 font-medium">{seriesMeta.name}</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900">{seriesMeta.name} Series Reading Order</h1>

      {authorNames.length > 0 && (
        <p class="mt-2 text-zinc-500 text-lg">
          by{' '}
          {authorNames.map((name, i) => (
            <span>
              <a href={`/authors/${authorToSlug(name)}/`} class="text-purple-700 hover:underline font-medium">{name}</a>{i < authorNames.length - 1 ? ', ' : ''}
            </span>
          ))}
        </p>
      )}

      <div class="mt-4 flex flex-wrap gap-5 text-sm text-zinc-600 border-y border-zinc-100 py-4">
        <span class="flex items-center gap-1.5">
          <span class="text-zinc-400">📚</span> {seriesMeta.bookCount} {seriesMeta.bookCount === 1 ? 'book' : 'books'}
        </span>
        {totalPagesDb > 0 && (
          <span class="flex items-center gap-1.5">
            <span class="text-zinc-400">📄</span> ~{totalPagesDb.toLocaleString()} pages
          </span>
        )}
        {avgRatingDb && (
          <span class="flex items-center gap-1.5">
            <span class="text-amber-400">★</span> {avgRatingDb} avg rating
          </span>
        )}
        {dbYearRange && (
          <span class="flex items-center gap-1.5">
            <span class="text-zinc-400">📅</span> {dbYearRange}
          </span>
        )}
        {dbAvgDarkness && (
          <span class="flex items-center gap-1.5" title={`Darkness: ${DARKNESS_LABELS[dbAvgDarkness]}`}>
            {CANDLES[dbAvgDarkness]} {DARKNESS_LABELS[dbAvgDarkness]}
          </span>
        )}
        {dbMaxHeatDisplay && (
          <span class="flex items-center gap-1.5">
            {dbMaxHeatDisplay}
          </span>
        )}
      </div>
      {(topSubgenres.length > 0 || topTropes.length > 0) && (
        <div class="mt-4 flex flex-wrap gap-2">
          {topSubgenres.map((g) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-purple-50 text-purple-700 border border-purple-200">{g}</span>
          ))}
          {topTropes.map((t) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-zinc-100 text-zinc-600 border border-zinc-200">{t}</span>
          ))}
        </div>
      )}
      {dbSeoProse && <p class="hidden mt-4 text-sm text-zinc-400 leading-relaxed max-w-2xl">{dbSeoProse}</p>}
    </div>

    <!-- Books — vertical list -->
    <div class="space-y-3 mb-12">
      {books.map((book, i) => {
        const dl = book.darkness_level != null && book.darkness_level >= 1 ? book.darkness_level : null;
        const shortSynopsis = book.synopsis ? book.synopsis.slice(0, 120).trimEnd() : null;
        const hasTruncated = book.synopsis && book.synopsis.length > 120;
        const cardId = `book-synopsis-${i}`;
        const inner = (
          <div class="flex items-start gap-4 rounded-xl border border-zinc-200 bg-white px-4 py-3 hover:border-purple-300 hover:bg-purple-50/30 transition-colors group">
            <span class="shrink-0 mt-1 w-6 h-6 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold text-xs">{i + 1}</span>
            <div class="shrink-0 w-10 h-14 rounded overflow-hidden bg-zinc-100 border border-zinc-200">
              {book.cover_url ? (
                <img src={book.cover_url} alt={book.title} class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/grimplaceholder.png';" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-zinc-300">📖</div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors leading-snug">{book.title}</p>
                  <p class="text-xs text-indigo-600 mt-0.5">{seriesMeta.name}{book.series_number != null ? ` #${book.series_number}` : ''}</p>
                </div>
                {book.avg_rating != null && (
                  <span class="shrink-0 text-sm font-semibold text-amber-500 whitespace-nowrap">★ {book.avg_rating.toFixed(2)}</span>
                )}
              </div>
              {shortSynopsis && (
                <p class="mt-1.5 text-xs text-zinc-500 leading-relaxed">
                  <span data-short={cardId}>{shortSynopsis}{hasTruncated ? '…' : ''}</span>
                  {hasTruncated && (
                    <>
                      <span data-full={cardId} class="hidden">{book.synopsis}</span>
                      <button data-toggle={cardId} class="ml-1 text-purple-600 hover:text-purple-800 font-medium text-xs underline-offset-2 hover:underline">read more</button>
                    </>
                  )}
                </p>
              )}
              <div class="flex flex-wrap items-center gap-3 mt-1.5 text-xs text-zinc-400">
                {book.publication_year && <span>{book.publication_year}</span>}
                {book.page_count && <span>{book.page_count} pp.</span>}
                {dl && <span>{DARKNESS_CANDLES[dl]}</span>}
              </div>
            </div>
          </div>
        );
        return book.slug ? <a href={`/books/${book.slug}/`} class="block">{inner}</a> : inner;
      })}
    </div>

    <!-- Content Warnings -->
    {contentWarnings.length > 0 && (
      <div class="mb-10 rounded-xl border border-amber-200 bg-amber-50/60 px-5 py-4">
        <h2 class="text-sm font-semibold text-amber-800 uppercase tracking-wider mb-3">⚠️ Content Warnings</h2>
        <div class="flex flex-wrap gap-2">
          {contentWarnings.map((w) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-900 border border-amber-200">{w}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Books Like cross-link -->
    {matchingBooksLike && (
      <div class="border-t py-8 flex flex-col justify-center sm:items-start items-center sm:text-left text-center">
        <p class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">Looking for similar books?</p>
        <a
          href={`/books-like/${matchingBooksLike.slug}/`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-indigo-200 bg-indigo-50 text-sm font-medium text-indigo-700 hover:border-indigo-400 hover:bg-indigo-100 transition-colors"
        >
          📚 Books Like {matchingBooksLike.source.title} →
        </a>
      </div>
    )}

    <!-- Similar series -->
    {similarSeries.length > 0 && (
      <div class="border-t pt-8">
        <h2 class="text-xl font-semibold text-zinc-900 mb-5">More series like this</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {similarSeries.map((s) => (
            <a href={`/reading-orders/${s.slug}/`} class="group flex items-center gap-4 rounded-xl border border-zinc-200 bg-white p-4 hover:border-purple-300 hover:bg-purple-50/40 transition-colors">
              <div class="shrink-0 w-14 h-20 rounded-lg overflow-hidden bg-zinc-100 border border-zinc-200">
                {s.cover ? (
                  <img src={s.cover} alt={s.name} class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/grimplaceholder.png';" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-zinc-300 text-xl">📖</div>
                )}
              </div>
              <div class="min-w-0">
                <p class="text-base font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors leading-snug line-clamp-2">{s.name}</p>
                {s.avgRating && <p class="text-sm text-amber-500 mt-1">★ {s.avgRating.toFixed(2)}</p>}
                <p class="text-xs text-zinc-400 mt-1">Reading order →</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </>
)}

</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const id = btn.dataset.toggle!;
      const shortEl = document.querySelector(`[data-short="${id}"]`)!;
      const fullEl = document.querySelector(`[data-full="${id}"]`)!;
      const nowHidden = fullEl.classList.toggle('hidden');
      shortEl.classList.toggle('hidden');
      btn.textContent = nowHidden ? 'read more' : 'read less';
    });
  });
</script>
