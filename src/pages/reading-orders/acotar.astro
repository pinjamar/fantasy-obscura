---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';
import { supabaseClient } from '../../lib/supabaseClient';

const bookData = [
  {
    title: 'A Court of Thorns and Roses',
    slug: 'a-court-of-thorns-and-roses',
    status: 'mandatory' as const,
    note: 'Start here. Feyre is dragged into Prythian. Dark fairy tale retelling with slow-burn romance.',
    page_count: 419,
    publication_year: 2015,
  },
  {
    title: 'A Court of Mist and Fury',
    slug: 'a-court-of-mist-and-fury',
    status: 'mandatory' as const,
    note: 'The best book in the series by consensus. Everything opens up — the world, the stakes, the romance.',
    page_count: 624,
    publication_year: 2016,
  },
  {
    title: 'A Court of Wings and Ruin',
    slug: 'a-court-of-wings-and-ruin',
    status: 'mandatory' as const,
    note: 'War arrives. Closes the main trilogy with a large-scale battle and full cast convergence.',
    page_count: 699,
    publication_year: 2017,
  },
  {
    title: 'A Court of Frost and Starlight',
    slug: 'a-court-of-frost-and-starlight',
    status: 'supplementary' as const,
    note: 'Short bridge novella (~230 pages). Aftermath of the war. Sets up the companion novels — read before ACSF.',
    page_count: 232,
    publication_year: 2018,
  },
  {
    title: 'A Court of Silver Flames',
    slug: 'a-court-of-silver-flames',
    status: 'mandatory' as const,
    note: "Nesta and Cassian's book. Divisive but beloved — read it as its own thing, not a sequel to the trilogy.",
    page_count: 757,
    publication_year: 2021,
  },
];

const bookSlugs = bookData.map(b => b.slug);
const { data: coverRows } = await supabaseClient.from('books').select('slug, cover_url').in('slug', bookSlugs);
const coverMap = new Map<string, string | null>((coverRows ?? []).map((r: any) => [r.slug, r.cover_url ?? null]));
const books = bookData.map(b => ({ ...b, cover_url: coverMap.get(b.slug) ?? null }));

const groups = [
  {
    label: 'The Original Trilogy',
    sublabel: 'start here',
    books: books.slice(0, 3),
    noteType: 'required' as const,
    note: 'All three are essential and must be read in order. ACMAF is frequently cited as one of the best romance-fantasy novels of the decade.',
  },
  {
    label: 'Companion Books',
    sublabel: 'same world, different POVs',
    books: books.slice(3),
    noteType: 'optional' as const,
    note: 'ACFAS is a short bridge (~230 pages) — worthwhile context. ACSF follows Nesta and Cassian and works best read after the bridge novella.',
  },
];

const totalPages = books.reduce((sum, b) => sum + (b.page_count ?? 0), 0);
const totalHours = Math.round(totalPages / 30);
const coreBooks = books.filter(b => b.status === 'mandatory').length;
---

<Layout
  title="A Court of Thorns and Roses Reading Order | Fantasy Obscura"
  description="Complete reading order for the ACOTAR series by Sarah J. Maas."
>

  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">← Reading Orders</a>
  </div>

  <div class="mb-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-purple-600 uppercase tracking-wider mb-1">Reading Order</p>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900">A Court of Thorns and Roses</h1>
        <p class="mt-1 text-lg text-zinc-500">by Sarah J. Maas</p>
      </div>
      <span class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium">
        ✓ Main Series Complete
      </span>
    </div>

    <div class="mt-5 flex flex-wrap gap-6 text-sm text-zinc-600 border-y border-zinc-100 py-4">
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📚</span> {books.length} books ({coreBooks} essential)</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📄</span> ~{totalPages.toLocaleString()} pages</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">⏱</span> ~{totalHours} hours reading time</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">🕯️🕯️🕯️</span> Moderate darkness</span>
    </div>

    <p class="mt-5 text-base text-zinc-700 leading-relaxed max-w-2xl">
      A dark fairy tale retelling that becomes a full epic fantasy by book two. Feyre is pulled into a world of immortal fae, political power, and war — with romance woven through every layer. ACMAF is the breakout book that defines the series.
    </p>
  </div>

  <div class="mb-12">
    <h2 class="text-xl font-semibold mb-1">Reading Order</h2>
    <p class="text-sm text-zinc-500 mb-6">Read the trilogy first. The companion books are best read after — they assume you've finished ACWAR.</p>
    <ReadingOrder groups={groups} client:load />
  </div>

  <div class="mb-10 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">
      <p class="font-semibold text-blue-900 mb-2">⚡ Essential ({coreBooks} books)</p>
      <p class="text-sm text-blue-800">ACOTAR → ACMAF → ACWAR → ACSF. The first book is the slowest — ACMAF is where the series truly begins.</p>
    </div>
    <div class="rounded-xl border border-amber-100 bg-amber-50 p-5">
      <p class="font-semibold text-amber-900 mb-2">🔀 Bridge Novella (1 book)</p>
      <p class="text-sm text-amber-800"><strong>A Court of Frost and Starlight</strong> — short (~230 pages), covers the aftermath of ACWAR. Read before A Court of Silver Flames.</p>
    </div>
  </div>

  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">What to expect from each book</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li class="flex gap-2"><span class="text-zinc-400">→</span> <strong>ACOTAR</strong>: Beauty and the Beast retelling. Slower pacing, establishing tone. The romance is understated.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> <strong>ACMAF</strong>: The series expands completely. New court, new POV, the world triples in scale. Most consider this the best in the series.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> <strong>ACWAR</strong>: War arc. Wraps all main threads. More political than the previous two.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> <strong>ACFAS</strong>: Short recovery story. Skip if you only want the main plot — read if you want emotional closure after ACWAR.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> <strong>ACSF</strong>: Nesta's book. Darker and more intense than the trilogy. Works best if you appreciated her character arc.</li>
    </ul>
  </div>

  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Spoiler-free notes</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The first ~100 pages of ACOTAR are the slowest in the series. Don't judge it until you've finished the book.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> ACMAF is where most readers fall for the series — the tone, setting, and characters shift significantly.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The fae world has internal politics that reward paying attention — courts, powers, and allegiances matter.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The series has explicit content from ACMAF onward.</li>
    </ul>
  </div>

  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-4">Darkness progression</h2>
    <div class="space-y-3 text-sm">
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-44 shrink-0">ACOTAR</span>
        <span class="text-zinc-400">🕯️🕯️</span>
        <span class="text-zinc-500">Dark fairy tale — captivity, monster threats, sacrifice</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-44 shrink-0">ACMAF</span>
        <span class="text-zinc-400">🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Trauma, war build-up, political intrigue</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-44 shrink-0">ACWAR + ACSF</span>
        <span class="text-zinc-400">🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Full war, loss, recovery arcs</span>
      </div>
    </div>
    <p class="mt-4 text-xs text-zinc-400">Scale: 🕯️ Lighthearted → 🕯️🕯️🕯️🕯️🕯️ Brutal</p>
  </div>

  <div class="border-t pt-8 flex flex-col sm:flex-row gap-6 justify-between">
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Finished the series?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/categories/romance-fantasy" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Browse Romance Fantasy →</a>
        <a href="/craft" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Find books like ACOTAR →</a>
      </div>
    </div>
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Related reading orders</p>
      <div class="flex flex-wrap gap-3">
        <a href="/reading-orders/throne-of-glass" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">Throne of Glass</a>
        <a href="/reading-orders/witcher" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">The Witcher</a>
      </div>
    </div>
  </div>

</Layout>
