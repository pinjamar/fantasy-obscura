---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';

const books = [
  {
    title: 'The Way of Kings',
    status: 'mandatory' as const,
    note: 'First book. Epic introduction to Roshar.'
  },
  {
    title: 'Words of Radiance',
    status: 'mandatory' as const,
    note: 'Continues the story. Multiple viewpoints.'
  },
  {
    title: 'Edgedancer',
    status: 'supplementary' as const,
    note: 'Novella focusing on Lift. Read before Oathbringer.'
  },
  {
    title: 'Oathbringer',
    status: 'mandatory' as const,
    note: 'Third book. Dalinar\'s backstory revealed.'
  },
  {
    title: 'Dawnshard',
    status: 'supplementary' as const,
    note: 'Novella with Rysn. Read before Rhythm of War.'
  },
  {
    title: 'Rhythm of War',
    status: 'mandatory' as const,
    note: 'Fourth book. Fabrials and science.'
  },
];
---

<Layout
  title="The Stormlight Archive Reading Order | Fantasy Obscura"
  description="Reading order for The Stormlight Archive by Brandon Sanderson."
>
  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-blue-600 hover:underline">← Back to Reading Orders</a>
  </div>

  <h1 class="text-4xl font-bold tracking-tight">The Stormlight Archive Reading Order</h1>
  <p class="mt-2 text-zinc-600">by Brandon Sanderson</p>

  <div class="mt-8">
    <ReadingOrder
      books={books}
      description="Read in publication order. The novellas (Edgedancer, Dawnshard) provide important context for later books."
      client:load
    />
  </div>

  <div class="mt-12 rounded-lg border bg-zinc-50 p-6">
    <h2 class="font-semibold mb-3">Before You Start</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li>✓ Each book is 1000+ pages — be prepared for a commitment</li>
      <li>✓ Reading Warbreaker first adds to the experience (optional)</li>
      <li>✓ Part of the larger Cosmere universe</li>
      <li>✓ Book 5 (Wind and Truth) releases December 2024</li>
    </ul>
  </div>
</Layout>
