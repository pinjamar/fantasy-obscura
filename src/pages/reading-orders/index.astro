---
export const prerender = true;

import Layout from '../../components/Layout.astro';
import { READING_ORDERS } from '../../data/reading-orders';
import { READING_ORDER_IMAGE_SLUG, readingOrderFallback } from '../../data/image-map';

// Build search map from static data — book titles make each series searchable by title
const seriesSearchMap = new Map<string, string>();
for (const e of READING_ORDERS) {
  const allBooks = e.groups ? e.groups.flatMap(g => g.books) : (e.books ?? []);
  seriesSearchMap.set(e.name, allBooks.map(b => b.title).join(' ').toLowerCase());
}

function sortKey(name: string) {
  return name.replace(/^the\s+/i, '').toLowerCase();
}
const curatedSeries = READING_ORDERS.map((e) => ({
  slug: e.slug,
  name: e.name,
  author: e.author,
  bookCount: e.groups
    ? e.groups.reduce((sum, g) => sum + g.books.length, 0)
    : (e.books?.length ?? 0),
})).sort((a, b) => sortKey(a.name).localeCompare(sortKey(b.name)));

const dbOnly: { name: string; slug: string; bookCount: number }[] = [];

const readingOrdersPageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Fantasy Series Reading Orders',
  description: "Reading orders for every major fantasy series — what to read first, what's optional, and where each series stumbles.",
  url: 'https://thegrimoire.co/reading-orders/',
});
---

<Layout
  title="Fantasy Series Reading Orders | The Grimoire"
  description="Reading orders for every major fantasy series — what to read first, what's optional, and where each series stumbles. Covers Stormlight, Wheel of Time, Malazan, First Law, and more."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={readingOrdersPageJsonLd} />
  </Fragment>
  <!-- Banner -->
  <div class="relative rounded-2xl overflow-hidden mb-8 border border-zinc-200">
    <picture>
      <source type="image/avif" srcset="/images/banners/reading-orders-banner-400.avif 400w, /images/banners/reading-orders-banner-800.avif 800w" sizes="(min-width: 1024px) 800px, 100vw" />
      <source type="image/webp" srcset="/images/banners/reading-orders-banner-400.webp 400w, /images/banners/reading-orders-banner-800.webp 800w" sizes="(min-width: 1024px) 800px, 100vw" />
      <img src="/images/banners/reading-orders-banner-800.webp" alt="" width="800" height="400" loading="eager" decoding="async" class="w-full aspect-3/1 object-cover" />
    </picture>
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/50 to-black/10" />
    <div class="absolute inset-0 px-6 py-6 flex flex-col justify-end">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Fantasy Series Reading Orders</h1>
      <p class="hidden sm:block mt-2 max-w-2xl text-white/80 text-sm leading-relaxed">
        Fantasy series get complicated fast - <strong class="text-white">novellas, companion books, sequel trilogies, prequels and shared universes</strong> all
        create confusion about where to start and what to skip. These guides cover major fantasy series with a clear
        reading order, honest notes on what's optional, and warnings about where each series stumbles.
        Every book is labelled <strong class="text-white">Core</strong>, <strong class="text-white">Optional</strong>, <strong class="text-white">Extra</strong>, or <strong class="text-white">Upcoming</strong> - so you always know which way to go.
      </p>
    </div>
  </div>

  <!-- Search bar -->
  <div class="mt-6 relative max-w-lg">
    <input
      id="series-search"
      type="text"
      placeholder="Search series, author, or book title…"
      class="w-full rounded-xl border-2 border-zinc-300 bg-white px-4 py-3 pl-10 text-sm shadow-md focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200 transition"
      autocomplete="off"
    />
    <svg class="absolute left-3 top-3.5 h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
    </svg>
  </div>

  <!-- Series grid — curated guides shown by default; DB-only shown only when searched -->
  <div id="series-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {curatedSeries.map((s) => {
      const imgSlug = READING_ORDER_IMAGE_SLUG[s.slug];
      return (
        <a
          href={`/reading-orders/${s.slug}/`}
          data-search={`${s.name.toLowerCase()} ${s.author.toLowerCase()} ${seriesSearchMap.get(s.name) ?? ''}`}
          class="series-card group relative overflow-hidden rounded-xl border transition-all hover:shadow-lg hover:border-purple-200 bg-white flex flex-col"
        >
          {imgSlug ? (
            <div class="relative aspect-2/1 overflow-hidden flex-1">
              <img
                src={readingOrderFallback(imgSlug)}
                alt=""
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent" />
              <span class="absolute top-3 left-3 text-xs bg-purple-600 text-white px-2 py-0.5 rounded-full font-medium">Curated guide</span>
              <div class="absolute bottom-0 left-0 right-0 px-4 py-3">
                <p class="text-lg font-bold text-white leading-snug drop-shadow-md [text-shadow:0_1px_4px_rgba(0,0,0,0.8)]">{s.name}</p>
                <p class="text-xs text-white/70 mt-0.5 drop-shadow-md">{s.bookCount} {s.bookCount === 1 ? 'book' : 'books'}</p>
              </div>
            </div>
          ) : (
            <div class="p-5">
              <div class="absolute inset-0 bg-linear-to-br from-purple-50 to-indigo-50 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl" />
              <div class="relative">
                <p class="font-semibold text-zinc-900 group-hover:text-purple-800 transition-colors leading-snug">{s.name}</p>
                <p class="mt-1 text-sm text-zinc-500">{s.bookCount} {s.bookCount === 1 ? 'book' : 'books'}</p>
                <span class="mt-2 inline-block text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full font-medium">Curated guide</span>
              </div>
            </div>
          )}
        </a>
      );
    })}
    {dbOnly.map((s) => (
      <a
        href={`/reading-orders/${s.slug}/`}
        data-search={`${s.name.toLowerCase()} ${seriesSearchMap.get(s.name) ?? ''}`}
        data-dbonly="true"
        class="series-card group relative overflow-hidden rounded-xl border p-5 transition-all hover:shadow-lg hover:border-zinc-300 bg-white hidden"
      >
        <div class="absolute inset-0 bg-linear-to-br from-zinc-50 to-zinc-100 opacity-0 group-hover:opacity-100 transition-opacity" />
        <div class="relative">
          <p class="font-semibold text-zinc-900 group-hover:text-zinc-700 transition-colors leading-snug">{s.name}</p>
          <p class="mt-1 text-sm text-zinc-500">{s.bookCount} {s.bookCount === 1 ? 'book' : 'books'}</p>
          <span class="mt-2 inline-block text-xs bg-zinc-100 text-zinc-500 px-2 py-0.5 rounded-full font-medium">Series list</span>
        </div>
      </a>
    ))}
  </div>

  <!-- Pagination -->
  <div id="ro-pagination" class="mt-8 flex items-center justify-between gap-2">
    <button id="ro-prev" disabled class="px-4 py-2 rounded-lg border border-zinc-200 text-sm text-zinc-600 hover:bg-zinc-50 disabled:opacity-30 disabled:cursor-not-allowed transition-colors">← Previous</button>
    <span id="ro-page-label" class="text-sm text-zinc-400"></span>
    <button id="ro-next" class="px-4 py-2 rounded-lg border border-zinc-200 text-sm text-zinc-600 hover:bg-zinc-50 disabled:opacity-30 disabled:cursor-not-allowed transition-colors">Next →</button>
  </div>

  <!-- Empty state -->
  <p id="no-results" class="hidden mt-10 text-center text-zinc-500">No series found for that search.</p>

  <!-- Legend -->
  <div class="mt-12 rounded-xl bg-zinc-50 border p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">How reading labels work</h2>
    <div class="flex flex-wrap gap-5 text-sm">
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded-full text-xs font-semibold border bg-blue-100 text-blue-800 border-blue-200">Core</span>
        <span class="text-zinc-600">Essential to the main story</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded-full text-xs font-semibold border bg-green-100 text-green-800 border-green-200">Optional</span>
        <span class="text-zinc-600">Adds depth, not required</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded-full text-xs font-semibold border bg-amber-100 text-amber-800 border-amber-200">Extra</span>
        <span class="text-zinc-600">Side stories & novellas</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded-full text-xs font-semibold border bg-red-100 text-red-700 border-red-200">Upcoming</span>
        <span class="text-zinc-600">Not yet published</span>
      </div>
    </div>
    <p class="mt-4 text-xs text-zinc-400">Start with Core. Everything else is your call.</p>
  </div>
</Layout>

<script>
  const PER_PAGE = 36;
  const input = document.getElementById('series-search') as HTMLInputElement;
  const allCards = Array.from(document.querySelectorAll<HTMLElement>('.series-card'));
  const curatedCards = allCards.filter(c => c.dataset.dbonly !== 'true');
  const noResults = document.getElementById('no-results')!;
  const pagination = document.getElementById('ro-pagination')!;
  const prevBtn = document.getElementById('ro-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('ro-next') as HTMLButtonElement;
  const pageLabel = document.getElementById('ro-page-label')!;

  let currentPage = 0;

  function renderPage() {
    const totalPages = Math.ceil(curatedCards.length / PER_PAGE) || 1;
    const start = currentPage * PER_PAGE;
    const end = start + PER_PAGE;
    curatedCards.forEach((card, i) => {
      card.classList.toggle('hidden', i < start || i >= end);
    });
    pageLabel.textContent = `Page ${currentPage + 1} of ${totalPages}`;
    prevBtn.disabled = currentPage === 0;
    nextBtn.disabled = currentPage >= totalPages - 1;
    pagination.style.display = curatedCards.length <= PER_PAGE ? 'none' : '';
  }

  prevBtn.addEventListener('click', () => { if (currentPage > 0) { currentPage--; renderPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });
  nextBtn.addEventListener('click', () => {
    const totalPages = Math.ceil(curatedCards.length / PER_PAGE);
    if (currentPage < totalPages - 1) { currentPage++; renderPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });

  input.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    if (q) {
      // Search mode: show all matching (curated + db-only), hide pagination
      pagination.style.display = 'none';
      let visible = 0;
      allCards.forEach((card) => {
        const matches = (card.dataset.search ?? '').includes(q);
        const isDbOnly = card.dataset.dbonly === 'true';
        const show = isDbOnly ? matches : matches;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      noResults.classList.toggle('hidden', visible > 0);
    } else {
      // Back to paginated view
      noResults.classList.add('hidden');
      allCards.filter(c => c.dataset.dbonly === 'true').forEach(c => c.classList.add('hidden'));
      currentPage = 0;
      renderPage();
    }
  });

  renderPage();
</script>
