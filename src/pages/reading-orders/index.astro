---
import Layout from '../../components/Layout.astro';
---

<Layout
  title="Reading Orders | Fantasy Obscura"
  description="Clear, spoiler‑free reading orders."
>
  <h1 class="text-3xl font-semibold tracking-tight">Reading Orders</h1>
  <p class="mt-4 max-w-2xl text-zinc-700">
    Simple mockup lists you can expand later.
  </p>

  <ul class="mt-6 list-disc pl-5 space-y-2 text-zinc-700">
    <li>Dune — main series only</li>
    <li>The Witcher — novels first</li>
    <li>Discworld — recommended start points</li>
  </ul>
</Layout>
