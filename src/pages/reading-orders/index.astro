---
import Layout from '../../components/Layout.astro';
import { getAllSeries } from '../../lib/db/books';
import { supabaseClient } from '../../lib/supabaseClient';

const [dbSeries, booksRes] = await Promise.all([
  getAllSeries(),
  supabaseClient.from('books').select('title, authors, series').not('series', 'is', null),
]);

// Build a map: series name → searchable text (all book titles + all author names)
type BooksRow = { title: string; authors: string[] | null; series: string | null };
const seriesSearchMap = new Map<string, string>();
for (const b of (booksRes.data ?? []) as BooksRow[]) {
  if (!b.series) continue;
  const existing = seriesSearchMap.get(b.series) ?? '';
  const authors = (b.authors ?? []).join(' ');
  seriesSearchMap.set(b.series, `${existing} ${b.title} ${authors}`.toLowerCase());
}

// Curated hand-written series (these have static pages with optional/extra markings)
const curatedSeries = [
  { slug: 'cosmere',       name: "Brandon Sanderson's Cosmere", bookCount: 15 },
  { slug: 'stormlight',   name: 'The Stormlight Archive',       bookCount: 5  },
  { slug: 'first-law',    name: 'The First Law',                bookCount: 10 },
  { slug: 'discworld',    name: 'Discworld',                    bookCount: 41 },
  { slug: 'malazan',      name: 'Malazan Book of the Fallen',   bookCount: 10 },
  { slug: 'wheel-of-time',name: 'The Wheel of Time',            bookCount: 14 },
  { slug: 'kingkiller',   name: 'The Kingkiller Chronicle',     bookCount: 3  },
  { slug: 'witcher',      name: 'The Witcher',                  bookCount: 8  },
  { slug: 'dresden-files', name: 'The Dresden Files',            bookCount: 17 },
  { slug: 'acotar',       name: 'A Court of Thorns and Roses',  bookCount: 5  },
  { slug: 'throne-of-glass', name: 'Throne of Glass',           bookCount: 8  },
  { slug: 'asoiaf',      name: 'A Song of Ice and Fire',        bookCount: 5  },
  { slug: 'robin-hobb',  name: 'Realm of the Elderlings',       bookCount: 16 },
  { slug: 'empyrean',    name: 'The Empyrean',                  bookCount: 3  },
  { slug: 'blood-and-ash', name: 'Blood and Ash',              bookCount: 8  },
];

// Merge: curated series take priority; add DB-only series after
// DB slugs are generated from series names, which differ from our curated slugs
// (e.g. "The First Law" → "the-first-law" vs curated slug "first-law")
// So we exclude by both the curated slug AND the DB-generated slug from the name.
function dbSlugify(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
const curatedSlugs = new Set([
  ...curatedSeries.map((s) => s.slug),
  ...curatedSeries.map((s) => dbSlugify(s.name)),
]);
const dbOnly = dbSeries.filter((s) => !curatedSlugs.has(s.slug));

---

<Layout
  title="Fantasy Series Reading Orders | Fantasy Obscura"
  description="Reading orders for every major fantasy series — what to read first, what's optional, and where each series stumbles. Covers Stormlight, Wheel of Time, Malazan, First Law, and more."
>
  <h1 class="text-3xl font-bold tracking-tight">Fantasy Series Reading Orders</h1>
  <div class="prose prose-zinc max-w-2xl mt-3 mb-2 text-sm leading-relaxed">
    <p>
      Fantasy series get complicated fast — <strong>novellas, companion books, sequel trilogies, and shared universes</strong> all
      create genuine confusion about where to start and what to skip. These guides cover every major fantasy series with a clear
      reading order, honest notes on what's optional, and warnings about where each series stumbles.
      Every book is labelled <strong>Core</strong>, <strong>Optional</strong>, or <strong>Extra</strong> — so you're never reading filler thinking it's essential.
    </p>
  </div>

  <!-- Search bar -->
  <div class="mt-6 relative max-w-lg">
    <input
      id="series-search"
      type="text"
      placeholder="Search series, author, or book title…"
      class="w-full rounded-xl border border-zinc-300 bg-white px-4 py-3 pl-10 text-sm shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-200 transition"
      autocomplete="off"
    />
    <svg class="absolute left-3 top-3.5 h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
    </svg>
  </div>

  <!-- Series grid — curated guides shown by default; DB-only shown only when searched -->
  <div id="series-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {curatedSeries.map((s) => (
      <a
        href={`/reading-orders/${s.slug}/`}
        data-search={`${s.name.toLowerCase()} ${seriesSearchMap.get(s.name) ?? ''}`}
        class="series-card group relative overflow-hidden rounded-xl border p-5 transition-all hover:shadow-lg hover:border-purple-200 bg-white"
      >
        <div class="absolute inset-0 bg-linear-to-br from-purple-50 to-indigo-50 opacity-0 group-hover:opacity-100 transition-opacity" />
        <div class="relative">
          <p class="font-semibold text-zinc-900 group-hover:text-purple-800 transition-colors leading-snug">{s.name}</p>
          <p class="mt-1 text-sm text-zinc-500">{s.bookCount} {s.bookCount === 1 ? 'book' : 'books'}</p>
          <span class="mt-2 inline-block text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full font-medium">Curated guide</span>
        </div>
      </a>
    ))}
    {dbOnly.map((s) => (
      <a
        href={`/reading-orders/${s.slug}/`}
        data-search={`${s.name.toLowerCase()} ${seriesSearchMap.get(s.name) ?? ''}`}
        data-dbonly="true"
        class="series-card group relative overflow-hidden rounded-xl border p-5 transition-all hover:shadow-lg hover:border-zinc-300 bg-white hidden"
      >
        <div class="absolute inset-0 bg-linear-to-br from-zinc-50 to-zinc-100 opacity-0 group-hover:opacity-100 transition-opacity" />
        <div class="relative">
          <p class="font-semibold text-zinc-900 group-hover:text-zinc-700 transition-colors leading-snug">{s.name}</p>
          <p class="mt-1 text-sm text-zinc-500">{s.bookCount} {s.bookCount === 1 ? 'book' : 'books'}</p>
          <span class="mt-2 inline-block text-xs bg-zinc-100 text-zinc-500 px-2 py-0.5 rounded-full font-medium">Series list</span>
        </div>
      </a>
    ))}
  </div>

  <!-- Empty state -->
  <p id="no-results" class="hidden mt-10 text-center text-zinc-500">No series found for that search.</p>

  <!-- Legend -->
  <div class="mt-12 rounded-xl bg-zinc-50 border p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">How reading labels work</h2>
    <div class="flex flex-wrap gap-5 text-sm">
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded-full text-xs font-semibold border bg-blue-100 text-blue-800 border-blue-200">Core</span>
        <span class="text-zinc-600">Essential to the main story</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded-full text-xs font-semibold border bg-green-100 text-green-800 border-green-200">Optional</span>
        <span class="text-zinc-600">Adds depth, not required</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded-full text-xs font-semibold border bg-amber-100 text-amber-800 border-amber-200">Extra</span>
        <span class="text-zinc-600">Side stories & novellas</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('series-search') as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>('.series-card');
  const noResults = document.getElementById('no-results')!;

  input.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    let visible = 0;
    cards.forEach((card) => {
      const searchText = card.dataset.search ?? '';
      const isDbOnly = card.dataset.dbonly === 'true';
      const matches = !q || searchText.includes(q);
      // DB-only cards: show only when there's an active query and it matches
      const show = isDbOnly ? (!!q && matches) : matches;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    noResults.classList.toggle('hidden', visible > 0 || !q);
  });
</script>
