---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';

const books = [
  {
    title: 'The Name of the Wind',
    status: 'mandatory' as const,
    note: 'Kvothe tells his story. Beautiful prose, slow burn.'
  },
  {
    title: 'The Wise Man\'s Fear',
    status: 'mandatory' as const,
    note: 'Continues the story. Longer and more divisive.'
  },
  {
    title: 'The Slow Regard of Silent Things',
    status: 'supplementary' as const,
    note: 'Novella about Auri. Very experimental. Read after book 2.'
  },
];
---

<Layout
  title="The Kingkiller Chronicle Reading Order | Fantasy Obscura"
  description="Reading order for The Kingkiller Chronicle by Patrick Rothfuss."
>
  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-blue-600 hover:underline">← Back to Reading Orders</a>
  </div>

  <h1 class="text-4xl font-bold tracking-tight">The Kingkiller Chronicle Reading Order</h1>
  <p class="mt-2 text-zinc-600">by Patrick Rothfuss</p>

  <div class="mt-8">
    <ReadingOrder
      books={books}
      description="Read in publication order. Book 3 (The Doors of Stone) has no release date and may never be published."
      client:load
    />
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2">
    <div class="rounded-lg border bg-zinc-50 p-6">
      <h2 class="font-semibold mb-3">What to Expect</h2>
      <ul class="space-y-2 text-sm text-zinc-700">
        <li>✓ Beautiful, lyrical prose</li>
        <li>✓ Slow-burn storytelling</li>
        <li>✓ Frame narrative structure</li>
        <li>✓ Magic system based on music and naming</li>
      </ul>
    </div>

    <div class="rounded-lg border bg-amber-50 p-6">
      <h2 class="font-semibold text-amber-900 mb-3">⚠️ Important Note</h2>
      <p class="text-sm text-zinc-700">
        Book 3 has been in development since 2011 with no release date. The story is incomplete. Many readers prefer to wait for the final book before starting.
      </p>
    </div>
  </div>

  <div class="mt-6 rounded-lg bg-blue-50 p-6">
    <h2 class="font-semibold text-blue-900 mb-2">The Slow Regard of Silent Things</h2>
    <p class="text-sm text-zinc-700">
      This novella follows Auri and has almost no plot. Rothfuss himself warns it's not for everyone. Only read if you loved Auri's character and want a meditative, atmospheric experience.
    </p>
  </div>
</Layout>
