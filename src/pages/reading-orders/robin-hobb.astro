---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';
import { supabaseClient } from '../../lib/supabaseClient';

const bookData = [
  // ── The Farseer Trilogy ──
  {
    title: "Assassin's Apprentice",
    slug: 'assassins-apprentice',
    status: 'mandatory' as const,
    note: 'Start here. FitzChivalry Farseer, royal bastard and assassin-in-training. Quiet, character-driven, devastating by the end.',
    page_count: 356,
    publication_year: 1995,
  },
  {
    title: 'Royal Assassin',
    slug: 'royal-assassin',
    status: 'mandatory' as const,
    note: 'The stakes rise sharply. Court politics, the Wit bond with Nighteyes, and Hobb\'s gift for slow emotional devastation at full strength.',
    page_count: 675,
    publication_year: 1996,
  },
  {
    title: "Assassin's Quest",
    slug: 'assassins-quest',
    status: 'mandatory' as const,
    note: 'Long quest structure, deeply interior. Divisive — some find it too slow. The emotional payoff of the trilogy hinges entirely on it.',
    page_count: 757,
    publication_year: 1997,
  },
  // ── The Liveship Traders ──
  {
    title: 'Ship of Magic',
    slug: 'ship-of-magic',
    status: 'mandatory' as const,
    note: 'Different characters, same world. Sentient ships, a merchant family in crisis, and pirates. Essential for the later Fitz books — the Liveship world connects deeply to the Fool trilogy.',
    page_count: 880,
    publication_year: 1998,
  },
  {
    title: 'The Mad Ship',
    slug: 'the-mad-ship',
    status: 'mandatory' as const,
    note: 'The Liveship Traders hits its stride. Althea, Brashen, and the Paragon — one of Hobb\'s most compelling relationship triangles.',
    page_count: 906,
    publication_year: 1999,
  },
  {
    title: 'Ship of Destiny',
    slug: 'ship-of-destiny',
    status: 'mandatory' as const,
    note: 'Closes the Liveship arc and quietly sets up the mythology that underpins the entire Elderlings world. Do not skip this.',
    page_count: 789,
    publication_year: 2000,
  },
  // ── The Tawny Man ──
  {
    title: "Fool's Errand",
    slug: 'fools-errand',
    status: 'mandatory' as const,
    note: 'Fitz returns, fifteen years later. Quieter opening but Hobb is rebuilding everything — the Fitz/Fool relationship is now the emotional core of the entire sequence.',
    page_count: 661,
    publication_year: 2001,
  },
  {
    title: 'The Golden Fool',
    slug: 'the-golden-fool',
    status: 'mandatory' as const,
    note: 'Court intrigue, the Wit persecutions, and the Fool\'s identity pulled into sharp focus. The middle book of the trilogy does heavy lifting.',
    page_count: 688,
    publication_year: 2002,
  },
  {
    title: "Fool's Fate",
    slug: 'fools-fate',
    status: 'mandatory' as const,
    note: 'The conclusion of the Tawny Man — and arguably of the Fitz arc as a whole. Hobb goes further emotionally than most readers expect.',
    page_count: 896,
    publication_year: 2003,
  },
  // ── The Rain Wild Chronicles ──
  {
    title: 'Dragon Keeper',
    slug: 'dragon-keeper',
    status: 'optional' as const,
    note: 'Returns to the Liveship world with new characters and the damaged dragons of the Rain Wilds. A gentler entry-point into the bridge between Tawny Man and Fitz & the Fool.',
    page_count: 404,
    publication_year: 2009,
  },
  {
    title: 'Dragon Haven',
    slug: 'dragon-haven',
    status: 'optional' as const,
    note: 'Continues directly from Dragon Keeper. The dragon migration provides mythology that enriches Fitz & the Fool but is not required to follow it.',
    page_count: 429,
    publication_year: 2010,
  },
  {
    title: 'City of Dragons',
    slug: 'city-of-dragons',
    status: 'optional' as const,
    note: 'The lost Elderling city revealed. More world-building than plot — reads better as part of the full Rain Wild sequence.',
    page_count: 368,
    publication_year: 2012,
  },
  {
    title: 'Blood of Dragons',
    slug: 'blood-of-dragons',
    status: 'optional' as const,
    note: 'Closes the Rain Wild Chronicles. Recommended if you want the full Elderlings picture before reading the final Fitz trilogy.',
    page_count: 418,
    publication_year: 2013,
  },
  // ── Fitz and the Fool ──
  {
    title: "Fool's Assassin",
    slug: 'fools-assassin',
    status: 'mandatory' as const,
    note: 'Fitz in his sixties, settled — and then everything changes. Hobb resets the board slowly and deliberately. The ending of book one is not safe.',
    page_count: 752,
    publication_year: 2014,
  },
  {
    title: "Fool's Quest",
    slug: 'fools-quest',
    status: 'mandatory' as const,
    note: 'The middle book of the final trilogy — urgent, desperate, and building toward a conclusion that has been decades in the making.',
    page_count: 752,
    publication_year: 2015,
  },
  {
    title: "Assassin's Fate",
    slug: 'assassins-fate',
    status: 'mandatory' as const,
    note: 'The end of everything. All sixteen books converge here. Hobb closes arcs that have been open since 1995. Read with tissues nearby.',
    page_count: 944,
    publication_year: 2017,
  },
];

const bookSlugs = bookData.map(b => b.slug);
const { data: coverRows } = await supabaseClient.from('books').select('slug, cover_url').in('slug', bookSlugs);
const coverMap = new Map<string, string | null>((coverRows ?? []).map((r: any) => [r.slug, r.cover_url ?? null]));
const books = bookData.map(b => ({ ...b, cover_url: coverMap.get(b.slug) ?? null }));

const totalPages = books.reduce((sum, b) => sum + (b.page_count ?? 0), 0);
const totalHours = Math.round(totalPages / 30);
const coreBooks = books.filter(b => b.status === 'mandatory').length;
---

<Layout
  title="Robin Hobb Realm of the Elderlings Reading Order | Fantasy Obscura"
  description="Complete reading order for Robin Hobb's Realm of the Elderlings — all 16 books across four series."
>

  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">← Reading Orders</a>
  </div>

  {/* ── Header ── */}
  <div class="mb-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-purple-600 uppercase tracking-wider mb-1">Reading Order</p>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-900">Realm of the Elderlings</h1>
        <p class="mt-1 text-lg text-zinc-500">by Robin Hobb</p>
      </div>
      <span class="mt-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-50 border border-green-200 text-green-700 text-sm font-medium">
        ✅ Complete Series
      </span>
    </div>

    <div class="mt-5 flex flex-wrap gap-6 text-sm text-zinc-600 border-y border-zinc-100 py-4">
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📚</span> 16 books ({coreBooks} essential)</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">📄</span> ~{totalPages.toLocaleString()} pages total</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">⏱</span> ~{totalHours} hours reading time</span>
      <span class="flex items-center gap-1.5"><span class="text-zinc-400">🕯️🕯️🕯️🕯️</span> Dark</span>
    </div>

    <p class="mt-5 text-base text-zinc-700 leading-relaxed max-w-2xl">
      Sixteen books across four interconnected series, all set in the same world, all building toward a conclusion that has been in progress since 1995. Robin Hobb writes character-driven fantasy with a particular genius for emotional devastation — her protagonists make choices that hurt, and she never lets them off easily. This is the most complete emotional journey in epic fantasy.
    </p>
  </div>

  {/* ── Reading Order Timeline ── */}
  <div class="mb-12">
    <h2 class="text-xl font-semibold mb-1">Recommended Reading Order</h2>
    <p class="text-sm text-zinc-500 mb-6">Publication order. The Rain Wild Chronicles (books 10–13) can be read after completing the Tawny Man or after the full sequence — both work.</p>
    <ReadingOrder books={books} client:load />
  </div>

  {/* ── Series breakdown ── */}
  <div class="mb-10 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">
      <p class="font-semibold text-blue-900 mb-1">The Farseer Trilogy (Books 1–3)</p>
      <p class="text-sm text-blue-800">FitzChivalry Farseer — royal bastard, king's assassin, and Hobb's main protagonist across the entire sequence. Start here no matter what.</p>
    </div>
    <div class="rounded-xl border border-purple-100 bg-purple-50 p-5">
      <p class="font-semibold text-purple-900 mb-1">The Liveship Traders (Books 4–6)</p>
      <p class="text-sm text-purple-800">New characters, same world. Ships that are alive, a merchant family in crisis. Feels like a detour — it isn't. The mythology here underlies the Fool trilogy.</p>
    </div>
    <div class="rounded-xl border border-green-100 bg-green-50 p-5">
      <p class="font-semibold text-green-900 mb-1">The Tawny Man (Books 7–9)</p>
      <p class="text-sm text-green-800">Fitz returns, older. The relationship between Fitz and the Fool becomes the emotional axis of everything. Many consider <em>Fool's Fate</em> the best book in the series.</p>
    </div>
    <div class="rounded-xl border border-amber-100 bg-amber-50 p-5">
      <p class="font-semibold text-amber-900 mb-1">Rain Wild Chronicles (Books 10–13)</p>
      <p class="text-sm text-amber-800">Optional but enriching — returns to the Liveship world with damaged dragons and new characters. Adds depth to <em>Fitz and the Fool</em> if read first.</p>
    </div>
  </div>

  {/* ── Safe Starting Points ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">Where to start</h2>
    <div class="space-y-3 text-sm text-zinc-700">
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>New to Robin Hobb?</strong> Start with <strong>Assassin's Apprentice</strong>. It is the only entry point. The world and character foundations must be laid here.</div>
      </div>
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>Can you skip the Liveship Traders?</strong> Technically yes — Fitz & the Fool works without them. But the world of the Elderlings will feel incomplete, and some revelations in Assassin's Fate hit harder with Liveship context.</div>
      </div>
      <div class="flex gap-3">
        <span class="text-zinc-400 shrink-0 mt-0.5">→</span>
        <div><strong>Can you skip the Rain Wild Chronicles?</strong> Yes, without losing the main thread. Read them if you want the full world — best between Tawny Man and Fitz & the Fool.</div>
      </div>
    </div>
  </div>

  {/* ── Key Notes ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-3">What to know</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Hobb's pacing is slow and deliberate. These are character-first novels — if you need constant plot momentum, recalibrate.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Fitz is a frustrating protagonist on purpose. His self-sabotage and passivity are features, not flaws. Hobb is doing something specific with it.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> The Fool is one of fantasy's most original and moving secondary characters. The Fitz/Fool relationship is the emotional spine of the entire sequence.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> Emotional content: grief, trauma, self-sacrifice, loneliness, and chosen family done with unusual honesty. Not a comfortable read. Deeply rewarding.</li>
      <li class="flex gap-2"><span class="text-zinc-400">→</span> <em>Assassin's Fate</em> is 944 pages and earns every one of them. It is the conclusion to a 22-year story and should be read last.</li>
    </ul>
  </div>

  {/* ── Darkness Progression ── */}
  <div class="mb-10 rounded-xl border bg-zinc-50 p-6">
    <h2 class="font-semibold text-zinc-900 mb-4">Darkness by series</h2>
    <div class="space-y-3 text-sm">
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">The Farseer Trilogy</span>
        <span class="text-zinc-400">🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Serious — loss, sacrifice, identity</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">The Liveship Traders</span>
        <span class="text-zinc-400">🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Serious — slavery, family collapse, survival</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">The Tawny Man</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Dark — cumulative grief, persecution, devastating choices</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">Rain Wild Chronicles</span>
        <span class="text-zinc-400">🕯️🕯️</span>
        <span class="text-zinc-500">Mild — lighter tone, character-driven discovery</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
        <span class="font-medium text-zinc-700 sm:w-52 shrink-0">Fitz and the Fool</span>
        <span class="text-zinc-400">🕯️🕯️🕯️🕯️</span>
        <span class="text-zinc-500">Dark — loss compounding over 22 years, no easy resolutions</span>
      </div>
    </div>
    <p class="mt-4 text-xs text-zinc-400">Scale: 🕯️ Lighthearted → 🕯️🕯️🕯️🕯️🕯️ Brutal</p>
  </div>

  {/* ── Footer ── */}
  <div class="border-t pt-8 flex flex-col sm:flex-row gap-6 justify-between">
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Finished the Elderlings?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/categories/epic" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Browse Epic Fantasy →</a>
        <a href="/craft" class="text-sm text-purple-600 hover:text-purple-800 underline underline-offset-2">Find similar books →</a>
      </div>
    </div>
    <div>
      <p class="text-sm font-medium text-zinc-700 mb-2">Related reading orders</p>
      <div class="flex flex-wrap gap-3">
        <a href="/reading-orders/first-law" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">The First Law</a>
        <a href="/reading-orders/wheel-of-time" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">Wheel of Time</a>
        <a href="/reading-orders/asoiaf" class="text-sm text-zinc-500 hover:text-zinc-800 transition-colors">A Song of Ice and Fire</a>
      </div>
    </div>
  </div>

</Layout>
