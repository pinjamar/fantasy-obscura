---
import Layout from '../../components/Layout.astro';
import ReadingOrder from '../../components/ReadingOrder';

const books = [
  { title: 'Gardens of the Moon', status: 'mandatory' as const, note: 'Dense and challenging. Pushthrough the first 200 pages.' },
  { title: 'Deadhouse Gates', status: 'mandatory' as const, note: 'New continent, different characters. Chain of Dogs.' },
  { title: 'Memories of Ice', status: 'mandatory' as const, note: 'Returns to Genabackis. One of the best.' },
  { title: 'House of Chains', status: 'mandatory' as const, note: 'Karsa Orlong introduction.' },
  { title: 'Midnight Tides', status: 'mandatory' as const, note: 'Completely new setting. Tehol and Bugg.' },
  { title: 'The Bonehunters', status: 'mandatory' as const, note: 'Storylines start converging.' },
  { title: 'Reaper\'s Gale', status: 'mandatory' as const, note: 'Continues Midnight Tides arc.' },
  { title: 'Toll the Hounds', status: 'mandatory' as const, note: 'Returns to Darujhistan.' },
  { title: 'Dust of Dreams', status: 'mandatory' as const, note: 'First part of two-book finale.' },
  { title: 'The Crippled God', status: 'mandatory' as const, note: 'Epic conclusion to the series.' },
];
---

<Layout
  title="Malazan Book of the Fallen Reading Order | Fantasy Obscura"
  description="Reading order for Malazan Book of the Fallen by Steven Erikson."
>
  <div class="mb-6">
    <a href="/reading-orders" class="text-sm text-blue-600 hover:underline">← Back to Reading Orders</a>
  </div>

  <h1 class="text-4xl font-bold tracking-tight">Malazan Book of the Fallen Reading Order</h1>
  <p class="mt-2 text-zinc-600">by Steven Erikson</p>

  <div class="mt-8">
    <ReadingOrder
      books={books}
      description="Read in publication order. This is one of fantasy's most complex and rewarding series. Takes significant commitment."
      client:load
    />
  </div>

  <div class="mt-12 rounded-lg border bg-amber-50 p-6">
    <h2 class="font-semibold text-amber-900 mb-3">⚠️ Fair Warning</h2>
    <ul class="space-y-2 text-sm text-zinc-700">
      <li>✓ Extremely complex — hundreds of POV characters</li>
      <li>✓ No hand-holding — events unfold without explanation</li>
      <li>✓ Gardens of the Moon is notoriously difficult to start</li>
      <li>✓ Requires patience but incredibly rewarding</li>
    </ul>
  </div>
</Layout>
