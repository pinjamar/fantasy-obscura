---
import Layout from '../../../components/Layout.astro';
import { getBooks } from '../../../lib/db/books';
import type { SortOption } from '../../../lib/types';

const PAGE_SIZE = 24;

const pageParam = parseInt(Astro.url.searchParams.get('page') ?? '1');
const page = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;
const sort = (Astro.url.searchParams.get('sort') ?? 'rating_desc') as SortOption;

const { data: books, count } = await getBooks({}, { page, pageSize: PAGE_SIZE, sort });
const totalPages = Math.ceil((count ?? 0) / PAGE_SIZE);

const SORT_OPTIONS: { value: SortOption; label: string }[] = [
  { value: 'rating_desc', label: 'Top Rated' },
  { value: 'rating_asc',  label: 'Lowest Rated' },
  { value: 'title_asc',   label: 'A → Z' },
  { value: 'title_desc',  label: 'Z → A' },
  { value: 'year_desc',   label: 'Newest First' },
  { value: 'year_asc',    label: 'Oldest First' },
  { value: 'pages_asc',   label: 'Shortest' },
  { value: 'pages_desc',  label: 'Longest' },
];

const DARKNESS_CANDLES = ['', '🕯️', '🕯️🕯️', '🕯️🕯️🕯️', '🕯️🕯️🕯️🕯️', '🕯️🕯️🕯️🕯️🕯️'];

function getPageNumbers(current: number, total: number): (number | 'ellipsis')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages: (number | 'ellipsis')[] = [1];
  if (current > 3) pages.push('ellipsis');
  for (let p = Math.max(2, current - 1); p <= Math.min(total - 1, current + 1); p++) {
    pages.push(p);
  }
  if (current < total - 2) pages.push('ellipsis');
  pages.push(total);
  return pages;
}

const pageNumbers = getPageNumbers(page, totalPages);

function pageUrl(p: number) {
  return `/books/all/?page=${p}&sort=${sort}`;
}
---

<Layout title="All Books | Fantasy Obscura" description="Browse the complete Fantasy Obscura book collection.">

  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">All Books</h1>
      <p class="text-zinc-500 text-sm mt-1">{count} books total</p>
    </div>
    <form method="get" action="/books/all/">
      <input type="hidden" name="page" value="1" />
      <label for="sort-select" class="text-sm text-zinc-600 mr-2">Sort:</label>
      <select
        id="sort-select"
        name="sort"
        onchange="this.form.submit()"
        class="text-sm border border-zinc-300 rounded-lg px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-purple-500"
      >
        {SORT_OPTIONS.map(opt => (
          <option value={opt.value} selected={opt.value === sort}>{opt.label}</option>
        ))}
      </select>
    </form>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {books.map(book => {
      const dl = (book.darkness_level != null && book.darkness_level >= 1) ? book.darkness_level : null;
      const href = book.slug ? `/books/${book.slug}/` : null;
      return (
        <div class="rounded-2xl border bg-white overflow-hidden hover:shadow-lg transition-shadow flex flex-col">
          {href ? (
            <a href={href} class="block relative h-48 overflow-hidden bg-linear-to-br from-purple-200 to-blue-200">
              {book.cover_url
                ? <img src={book.cover_url} alt={book.title} class="w-full h-full object-cover" loading="lazy" />
                : <span class="absolute inset-0 flex items-center justify-center text-4xl">📖</span>
              }
              {dl != null && (
                <span class="absolute top-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">
                  {DARKNESS_CANDLES[dl]}
                </span>
              )}
              {book.audiobook_available && (
                <span class="absolute top-2 left-2 bg-black/60 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">
                  🎧
                </span>
              )}
            </a>
          ) : (
            <div class="relative h-48 bg-linear-to-br from-purple-200 to-blue-200 flex items-center justify-center">
              <span class="text-4xl">📖</span>
              {dl != null && (
                <span class="absolute top-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded-full">
                  {DARKNESS_CANDLES[dl]}
                </span>
              )}
            </div>
          )}

          <div class="p-4 flex flex-col flex-1">
            <h3 class="font-semibold text-base line-clamp-2 mb-1">
              {href
                ? <a href={href} class="hover:text-purple-700 transition-colors">{book.title}</a>
                : book.title
              }
            </h3>
            <p class="text-sm text-zinc-500 mb-1">{book.authors?.join(', ') || 'Unknown author'}</p>
            {book.series && (
              <p class="text-xs text-indigo-600 font-medium mb-2">
                {book.series}{book.series_number != null ? ` #${book.series_number}` : ''}
              </p>
            )}
            <div class="flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-zinc-400 mt-auto pt-2 border-t">
              {book.publication_year && <span>{book.publication_year}</span>}
              {book.page_count && <span>{book.page_count} pages</span>}
              {book.avg_rating && <span>★ {book.avg_rating.toFixed(1)}</span>}
            </div>
            {book.subgenres && book.subgenres.length > 0 && (
              <div class="flex flex-wrap gap-1 mt-2">
                {book.subgenres.slice(0, 2).map(s => (
                  <span class="text-[10px] bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded">{s}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      );
    })}
  </div>

  {totalPages > 1 && (
    <div class="flex items-center justify-center gap-1.5 mt-10 flex-wrap">
      {page > 1 && (
        <a href={pageUrl(page - 1)} class="px-4 py-2 rounded-lg border border-zinc-300 text-sm font-medium hover:bg-zinc-50 transition-colors">
          ← Prev
        </a>
      )}
      {pageNumbers.map(p =>
        p === 'ellipsis' ? (
          <span class="px-2 text-zinc-400 text-sm">…</span>
        ) : (
          <a
            href={pageUrl(p as number)}
            class={`w-10 h-10 flex items-center justify-center rounded-lg text-sm font-medium transition-colors ${
              p === page ? 'bg-purple-600 text-white' : 'border border-zinc-300 hover:bg-zinc-50'
            }`}
          >
            {p}
          </a>
        )
      )}
      {page < totalPages && (
        <a href={pageUrl(page + 1)} class="px-4 py-2 rounded-lg border border-zinc-300 text-sm font-medium hover:bg-zinc-50 transition-colors">
          Next →
        </a>
      )}
    </div>
  )}

  <p class="text-center text-xs text-zinc-400 mt-4">
    Page {page} of {totalPages} · {count} books total
  </p>

</Layout>
