---
import Layout from '../../../components/Layout.astro';
import BookDisplay from '../../../components/BookDisplay';
const user = Astro.locals.user;
---

<Layout title="All Books | Fantasy Obscura" description="Browse the complete Fantasy Obscura book collection.">

  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">All Books</h1>
      <p class="text-zinc-500 text-sm mt-1">The complete collection</p>
    </div>
    <a href="/books/" class="text-xs text-zinc-400 hover:text-zinc-600 transition-colors whitespace-nowrap">
      ← Back to categories
    </a>
  </div>

  <BookDisplay client:load userId={user?.id ?? null} />

</Layout>
