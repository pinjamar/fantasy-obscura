---
import Layout from '../../components/Layout.astro';
import { getBookBySlug } from '../../lib/db/books';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/books');
}

const book = await getBookBySlug(slug);

if (!book) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const DARKNESS = [
  null,
  { label: 'Lighthearted', candles: '🕯️',             desc: 'Cozy, low stakes, no real darkness',               color: 'text-green-700',  bg: 'bg-green-50',  border: 'border-green-200' },
  { label: 'Mild',         candles: '🕯️🕯️',          desc: 'Some conflict and tension but ultimately safe',    color: 'text-yellow-700', bg: 'bg-yellow-50', border: 'border-yellow-200' },
  { label: 'Moderate',     candles: '🕯️🕯️🕯️',       desc: 'Death, moral complexity, some disturbing content', color: 'text-orange-700', bg: 'bg-orange-50', border: 'border-orange-200' },
  { label: 'Dark',         candles: '🕯️🕯️🕯️🕯️',    desc: 'Violence, trauma, morally grey characters',        color: 'text-red-700',    bg: 'bg-red-50',    border: 'border-red-200' },
  { label: 'Brutal',       candles: '🕯️🕯️🕯️🕯️🕯️', desc: 'Grimdark, no redemption guaranteed',               color: 'text-red-900',    bg: 'bg-red-100',   border: 'border-red-300' },
];

const darkness = book.darkness_level != null ? DARKNESS[book.darkness_level] ?? null : null;

const amazonUrl = `https://www.amazon.com/s?k=${encodeURIComponent((book.title ?? '') + ' ' + (book.authors?.[0] ?? ''))}`;
const goodreadsUrl = `https://www.goodreads.com/search?q=${encodeURIComponent(book.title ?? '')}`;
const bookshopUrl = `https://bookshop.org/search?keywords=${encodeURIComponent(book.title ?? '')}`;

const metaDescription = book.synopsis
  ? book.synopsis.slice(0, 160)
  : `Read about ${book.title} by ${book.authors?.join(', ')} on Fantasy Obscura.`;
---

<Layout title={`${book.title} | Fantasy Obscura`} description={metaDescription}>
  <!-- Breadcrumb -->
  <nav class="text-sm text-zinc-500 mb-6">
    <a href="/books/" class="hover:underline">Books</a>
    <span class="mx-2">›</span>
    <span class="text-zinc-700">{book.title}</span>
  </nav>

  <div class="grid gap-10 lg:grid-cols-[280px_1fr]">
    <!-- Left: Cover + Buy links -->
    <div class="space-y-4">
      {book.cover_url ? (
        <img
          src={book.cover_url}
          alt={`Cover of ${book.title}`}
          class="w-full max-w-xs mx-auto lg:mx-0 rounded-xl shadow-lg object-cover"
        />
      ) : (
        <div class="w-full max-w-xs mx-auto lg:mx-0 aspect-[2/3] rounded-xl bg-linear-to-br from-purple-200 to-blue-200 flex items-center justify-center text-5xl shadow-lg">
          📖
        </div>
      )}

      <!-- Affiliate / Buy links -->
      <div class="space-y-2">
        <p class="text-xs font-semibold text-zinc-500 uppercase tracking-wide">Find this book</p>
        <a
          href={amazonUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 w-full px-4 py-2.5 rounded-lg bg-amber-400 hover:bg-amber-500 text-zinc-900 text-sm font-semibold transition-colors"
        >
          <span>🛒</span> Buy on Amazon
        </a>
        <a
          href={bookshopUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 w-full px-4 py-2.5 rounded-lg bg-emerald-100 hover:bg-emerald-200 text-emerald-900 text-sm font-semibold transition-colors"
        >
          <span>🏪</span> Bookshop.org
        </a>
        <a
          href={goodreadsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 w-full px-4 py-2.5 rounded-lg bg-zinc-100 hover:bg-zinc-200 text-zinc-800 text-sm font-semibold transition-colors"
        >
          <span>📚</span> View on Goodreads
        </a>
      </div>

      <!-- Quick stats -->
      <div class="border rounded-xl p-4 space-y-2 text-sm">
        {book.page_count && (
          <div class="flex justify-between">
            <span class="text-zinc-500">Pages</span>
            <span class="font-medium">{book.page_count}</span>
          </div>
        )}
        {book.publication_year && (
          <div class="flex justify-between">
            <span class="text-zinc-500">Published</span>
            <span class="font-medium">{book.publication_year}</span>
          </div>
        )}
        {book.avg_rating && (
          <div class="flex justify-between">
            <span class="text-zinc-500">Rating</span>
            <span class="font-medium">★ {book.avg_rating.toFixed(2)}</span>
          </div>
        )}
        {book.audience && (
          <div class="flex justify-between">
            <span class="text-zinc-500">Audience</span>
            <span class="font-medium">{book.audience}</span>
          </div>
        )}
        {book.pacing && (
          <div class="flex justify-between">
            <span class="text-zinc-500">Pacing</span>
            <span class="font-medium">{book.pacing}</span>
          </div>
        )}
        {book.magic_system && (
          <div class="flex justify-between">
            <span class="text-zinc-500">Magic</span>
            <span class="font-medium">{book.magic_system}</span>
          </div>
        )}
        {book.heat_level && (
          <div class="flex justify-between">
            <span class="text-zinc-500">Romance</span>
            <span class="font-medium">{book.heat_level}</span>
          </div>
        )}
      </div>
    </div>

    <!-- Right: Main content -->
    <div class="space-y-6">
      <!-- Title block -->
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">{book.title}</h1>
        {book.authors?.length && (
          <p class="mt-1 text-lg text-zinc-600">{book.authors.join(', ')}</p>
        )}
        {book.series && (
          <p class="mt-1 text-sm text-indigo-600 font-medium">
            {book.series}{book.series_number != null ? ` — Book ${book.series_number}` : ''}
          </p>
        )}
      </div>

      <!-- Darkness rating — signature feature -->
      {darkness && (
        <div class={`rounded-xl border-2 ${darkness.border} ${darkness.bg} p-4`}>
          <div class="flex items-center gap-3">
            <div>
              <div class="text-xl leading-none">{darkness.candles}</div>
            </div>
            <div>
              <div class={`font-semibold ${darkness.color}`}>
                Darkness Level {book.darkness_level} — {darkness.label}
              </div>
              <div class="text-sm text-zinc-600 mt-0.5">{darkness.desc}</div>
            </div>
          </div>
        </div>
      )}

      <!-- Synopsis -->
      {book.synopsis && (
        <div>
          <h2 class="text-lg font-semibold text-zinc-900 mb-2">Synopsis</h2>
          <p class="text-zinc-700 leading-relaxed">{book.synopsis}</p>
        </div>
      )}

      <!-- Subgenres -->
      {book.subgenres?.length && (
        <div>
          <h2 class="text-sm font-semibold text-zinc-500 uppercase tracking-wide mb-2">Genres</h2>
          <div class="flex flex-wrap gap-2">
            {book.subgenres.map((s) => (
              <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-medium">{s}</span>
            ))}
          </div>
        </div>
      )}

      <!-- Tropes -->
      {book.tropes?.length && (
        <div>
          <h2 class="text-sm font-semibold text-zinc-500 uppercase tracking-wide mb-2">Tropes</h2>
          <div class="flex flex-wrap gap-2">
            {book.tropes.map((t) => (
              <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full text-sm">{t}</span>
            ))}
          </div>
        </div>
      )}

      <!-- Tone -->
      {book.tone?.length && (
        <div>
          <h2 class="text-sm font-semibold text-zinc-500 uppercase tracking-wide mb-2">Tone</h2>
          <div class="flex flex-wrap gap-2">
            {book.tone.map((t) => (
              <span class="px-3 py-1 bg-zinc-100 text-zinc-700 rounded-full text-sm">{t}</span>
            ))}
          </div>
        </div>
      )}

      <!-- Diversity rep -->
      {book.diversity_rep?.length && (
        <div>
          <h2 class="text-sm font-semibold text-zinc-500 uppercase tracking-wide mb-2">Representation</h2>
          <div class="flex flex-wrap gap-2">
            {book.diversity_rep.map((d) => (
              <span class="px-3 py-1 bg-teal-50 text-teal-700 border border-teal-200 rounded-full text-sm">{d}</span>
            ))}
          </div>
        </div>
      )}

      <!-- Find your next read CTA -->
      <div class="border-t pt-6">
        <a
          href="/craft/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-linear-to-r from-amber-500 to-orange-500 text-white text-sm font-semibold shadow hover:shadow-md hover:scale-105 transition-all"
        >
          🔮 Find books like this
        </a>
      </div>
    </div>
  </div>
</Layout>
