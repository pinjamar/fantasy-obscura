---
import Layout from '../../components/Layout.astro';
import { getBookBySlug, authorToSlug, getAllSeries } from '../../lib/db/books';
import { getApprovedTags } from '../../lib/db/tags';
import { supabaseClient } from '../../lib/supabaseClient';
import AddToShelf from '../../components/AddToShelf';
import FavouriteButton from '../../components/FavouriteButton';
import CommunityTags from '../../components/CommunityTags';
import BookFAQ from '../../components/BookFAQ.astro';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/books');

const book = await getBookBySlug(slug);
if (!book) return new Response(null, { status: 404, statusText: 'Not Found' });

const [approvedTags, allSeries] = await Promise.all([
  getApprovedTags(book.id),
  book.series ? getAllSeries() : Promise.resolve([]),
]);
const seriesSlug = book.series
  ? (allSeries.find((s) => s.name === book.series)?.slug ?? null)
  : null;
const userEmail = Astro.locals.user?.email ?? null;

const DARKNESS = [
  null,
  { label: 'Lighthearted', candles: '🕯️',             desc: 'Cozy, low stakes and emotionally safe',             color: 'text-emerald-700', bg: 'bg-emerald-50', border: 'border-emerald-200' },
  { label: 'Mild',         candles: '🕯️🕯️',          desc: 'Some danger and tension, but generally safe in tone', color: 'text-green-700',   bg: 'bg-green-50',   border: 'border-green-200' },
  { label: 'Serious',      candles: '🕯️🕯️🕯️',       desc: 'Death, violence and emotional weight are present',  color: 'text-yellow-700',  bg: 'bg-yellow-50',  border: 'border-yellow-200' },
  { label: 'Dark',         candles: '🕯️🕯️🕯️🕯️',    desc: 'Violence, trauma and morally harsh outcomes',       color: 'text-orange-700',  bg: 'bg-orange-50',  border: 'border-orange-200' },
  { label: 'Brutal',       candles: '🕯️🕯️🕯️🕯️🕯️', desc: 'Extreme violence and suffering, no mercy',     color: 'text-red-700',     bg: 'bg-red-50',     border: 'border-red-200' },
];

const darkness = book.darkness_level != null && book.darkness_level >= 1
  ? DARKNESS[book.darkness_level] ?? null
  : null;

const HEAT: Record<string, { flames: string; label: string; desc: string }> = {
  'Sweet Romance':     { flames: '🔥',         label: 'Sweet / Clean',      desc: 'Kisses only; focus on emotional connection' },
  'Closed Door':       { flames: '🔥🔥',       label: 'Fade to Black',      desc: 'Tension is there, but we leave before the clothes do' },
  'Open Door':         { flames: '🔥🔥🔥',     label: 'Open Door',          desc: 'Explicit scenes, but they don\'t dominate' },
  'Explicit':          { flames: '🔥🔥🔥🔥',   label: 'Explicit / Spicy',   desc: 'Graphic detail and high frequency' },
  'Fiery':             { flames: '🔥🔥🔥🔥🔥', label: 'Fiery / Primal',     desc: 'Extreme heat, often including kink' },
};

const isRomanceBook = book.subgenres?.some((s) =>
  ['Romantasy', 'Romance Fantasy'].includes(s)
) ?? false;

const heat = (isRomanceBook && book.heat_level) ? (HEAT[book.heat_level] ?? null) : null;

const q      = encodeURIComponent((book.title ?? '') + ' ' + (book.authors?.[0] ?? ''));
const qTitle = encodeURIComponent(book.title ?? '');

const amazonUrl      = `https://www.amazon.com/s?k=${q}`;
const bookshopUrl    = `https://bookshop.org/search?keywords=${qTitle}`;
const appleBooksUrl   = `https://books.apple.com/search?term=${q}`;
const koboUrl         = `https://www.kobo.com/us/en/search?query=${q}`;
const thriftBooksUrl  = `https://www.thriftbooks.com/browse/?b.search=${q}`;
const waterstonesUrl  = `https://www.waterstones.com/books/search/term/${q}`;
const worderyUrl      = `https://wordery.com/search?term=${qTitle}`;

// ~250 words/page ÷ 250 wpm = 1 min/page → pages ÷ 60 = hours
const readHours = book.page_count ? Math.round(book.page_count / 60) : null;


// Similar books — score by subgenre overlap (×2) + trope overlap, tiebreak by rating
type SimilarBookRow = {
  id: string; title: string; slug: string | null; authors: string[] | null;
  cover_url: string | null; avg_rating: number | null;
  subgenres: string[] | null; tropes: string[] | null;
  series: string | null; series_number: number | null;
};
const bookSubgenres = new Set(book.subgenres ?? []);
const bookTropes = new Set(book.tropes ?? []);

const { data: candidateBooks } = await supabaseClient
  .from('books')
  .select('id, title, slug, authors, cover_url, avg_rating, subgenres, tropes, series, series_number')
  .not('subgenres', 'is', null)
  .neq('id', book.id)
  .limit(1000) as { data: SimilarBookRow[] | null };

const similarBooks = (candidateBooks ?? [])
  .map((b) => {
    const subgenreOverlap = (b.subgenres ?? []).filter((s) => bookSubgenres.has(s)).length;
    const tropeOverlap    = (b.tropes ?? []).filter((t) => bookTropes.has(t)).length;
    return { ...b, score: subgenreOverlap * 2 + tropeOverlap };
  })
  .filter((b) => b.score > 0)
  .sort((a, b) => b.score - a.score || (b.avg_rating ?? 0) - (a.avg_rating ?? 0))
  .slice(0, 20);

const metaDescription = book.synopsis
  ? book.synopsis.slice(0, 160)
  : `${book.title} by ${book.authors?.join(', ')} — explore on Fantasy Obscura.`;

function upgradeCoverUrl(url: string | null | undefined): string {
  if (!url) return '';
  // Google Books gbs_api thumbnail → high-res publisher content URL
  if (url.includes('books.google.com/books/content')) {
    const m = url.match(/[?&]id=([^&]+)/);
    if (m) return `https://books.google.com/books/publisher/content/images/frontcover/${m[1]}?fife=w400-h600`;
  }
  // OpenLibrary: upgrade -M to -L
  return url.replace(/-M\.jpg/, '-L.jpg');
}
---

<Layout title={`${book.title} | Fantasy Obscura`} description={metaDescription}>

  <!-- Breadcrumb -->
  <nav class="text-sm text-zinc-400 mb-8 flex items-center flex-wrap gap-1.5">
    <a href="/books/" class="hover:text-zinc-700 transition-colors">Books</a>
    <span>›</span>
    {book.authors?.[0] && (
      <>
        <a href={`/authors/${authorToSlug(book.authors[0])}/`} class="hover:text-zinc-700 transition-colors">
          {book.authors[0]}
        </a>
        <span>›</span>
      </>
    )}
    <span class="text-zinc-700 font-medium">{book.title}</span>
  </nav>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <div class="grid gap-10 lg:grid-cols-[260px_1fr] mb-14">

    <!-- Cover + buy links -->
    <div class="flex flex-col gap-4">
      <div class="relative w-full max-w-[260px] mx-auto lg:mx-0 aspect-[2/3] rounded-2xl shadow-2xl overflow-hidden bg-linear-to-br from-purple-200 to-blue-200">
        <img
          src={upgradeCoverUrl(book.cover_url) || (book.isbn ? `https://covers.openlibrary.org/b/isbn/${book.isbn}-L.jpg?default=false` : '/placeholder-cover.svg')}
          alt={`Cover of ${book.title}`}
          class="absolute inset-0 w-full h-full object-cover"
          data-isbn={book.isbn ?? ''}
          onerror="if(!this.dataset.tried&&this.dataset.isbn){this.dataset.tried='1';this.src='https://covers.openlibrary.org/b/isbn/'+this.dataset.isbn+'-L.jpg?default=false';}else{this.onerror=null;this.src='/placeholder-cover.svg';}"
        />
        <FavouriteButton client:load bookId={book.id} userId={Astro.locals.user?.id ?? null} />
      </div>

      <div class="flex flex-col gap-2 max-w-[260px] mx-auto lg:mx-0">
        <p class="text-[11px] font-semibold text-zinc-400 uppercase tracking-widest">Find this book</p>
        <a href={amazonUrl} target="_blank" rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-500 text-zinc-900 text-sm font-semibold transition-colors">
          🛒 Buy on Amazon
        </a>
        <!-- More stores dropdown -->
        <div class="relative" id="stores-wrap">
          <button id="stores-toggle" class="group relative flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 hover:border-emerald-300 text-emerald-700 text-sm font-semibold transition-all">
            <span>🏪 More stores</span>
            <svg id="stores-chevron" class="absolute right-3 w-3.5 h-3.5 opacity-60 group-hover:opacity-100" style="transition:transform 0.2s" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div id="stores-menu" class="hidden absolute left-0 right-0 mt-1.5 rounded-xl border border-emerald-200 bg-emerald-50 shadow-2xl z-20 overflow-hidden">
            <div class="divide-y divide-emerald-200">
              <a href={bookshopUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-3 py-2.5 hover:bg-emerald-100 hover:text-emerald-800 text-sm text-emerald-700 font-medium transition-colors">
                <span class="text-base leading-none">🏪</span> Bookshop.org
              </a>
              <a href={thriftBooksUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-3 py-2.5 hover:bg-emerald-100 hover:text-emerald-800 text-sm text-emerald-700 font-medium transition-colors">
                <span class="text-base leading-none">💰</span> ThriftBooks
              </a>
              <a href={appleBooksUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-3 py-2.5 hover:bg-emerald-100 hover:text-emerald-800 text-sm text-emerald-700 font-medium transition-colors">
                <span class="text-base leading-none">🍎</span> Apple Books
              </a>
              <a href={koboUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-3 py-2.5 hover:bg-emerald-100 hover:text-emerald-800 text-sm text-emerald-700 font-medium transition-colors">
                <span class="text-base leading-none">📱</span> Kobo
              </a>
              <a href={waterstonesUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-3 py-2.5 hover:bg-emerald-100 hover:text-emerald-800 text-sm text-emerald-700 font-medium transition-colors">
                <span class="text-base leading-none">🏰</span> Waterstones
              </a>
              <a href={worderyUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-3 py-2.5 hover:bg-emerald-100 hover:text-emerald-800 text-sm text-emerald-700 font-medium transition-colors">
                <span class="text-base leading-none">🌍</span> Wordery
              </a>
            </div>
          </div>
        </div>
        <AddToShelf client:load bookId={book.id} userId={Astro.locals.user?.id ?? null} block />
      </div>
    </div>

    <!-- Meta -->
    <div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 leading-tight">{book.title}</h1>

      {book.series && (
        <div class="mt-1.5">
          {seriesSlug ? (
            <a
              href={`/reading-orders/${seriesSlug}/`}
              class="text-lg sm:text-xl text-zinc-400 font-light italic hover:text-zinc-600 hover:underline transition-colors"
            >
              {book.series}{book.series_number != null ? ` · #${book.series_number}` : ''} ›
            </a>
          ) : (
            <span class="text-base sm:text-lg text-zinc-400 font-light italic">
              {book.series}{book.series_number != null ? ` · #${book.series_number}` : ''}
            </span>
          )}
        </div>
      )}

      {book.authors && book.authors.length > 0 && (
        <p class="mt-3 text-base sm:text-xl text-zinc-500">
          by{' '}
          {book.authors.map((a, i) => (
            <span>
              <a href={`/authors/${authorToSlug(a)}/`} class="text-purple-700 hover:underline font-medium">{a}</a>
              {i < book.authors!.length - 1 ? ', ' : ''}
            </span>
          ))}
        </p>
      )}

      <!-- Genre pills -->
      {book.subgenres && book.subgenres.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {book.subgenres.map((s) => (
            <span class="px-3 py-1 bg-zinc-100 text-zinc-600 border border-zinc-200 rounded-full text-sm font-medium">{s}</span>
          ))}
        </div>
      )}

      <!-- Stats -->
      <div class="mt-6 flex flex-wrap gap-x-4 sm:gap-x-6 gap-y-3 text-sm">
        {book.publication_year && (
          <span class="text-center">
            <span class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wide block">Published</span>
            <span class="font-semibold text-zinc-800">{book.publication_year}</span>
          </span>
        )}
        {book.page_count && (
          <span class="text-center">
            <span class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wide block">Pages</span>
            <span class="font-semibold text-zinc-800">{book.page_count}</span>
            {readHours && <span class="text-zinc-400 text-xs ml-1.5">~{readHours}h</span>}
          </span>
        )}
        {book.avg_rating && (
          <span class="text-center">
            <span class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wide block">Rating</span>
            <span class="font-semibold text-zinc-800 inline-flex items-center gap-1.5">
              <span class="relative inline-block" style={`letter-spacing:0.05em;line-height:1`}>
                <span style="color:#d4d4d8">★★★★★</span>
                <span class="absolute inset-0 overflow-hidden whitespace-nowrap" style={`width:${(book.avg_rating/5*100).toFixed(2)}%;color:#f59e0b`}>★★★★★</span>
              </span>
              {book.avg_rating.toFixed(2)}
            </span>
          </span>
        )}
        {book.audience && (
          <span class="text-center">
            <span class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wide block">Audience</span>
            <span class="font-semibold text-zinc-800">{book.audience}</span>
          </span>
        )}
        {book.heat_level && (
          <span class="text-center">
            <span class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wide block">Heat</span>
            <span class="font-semibold text-zinc-800">{HEAT[book.heat_level]?.flames ?? '🔥'}</span>
          </span>
        )}
        {book.pacing && (
          <span class="text-center">
            <span class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wide block">Pacing</span>
            <span class="font-semibold text-zinc-800">{book.pacing}</span>
          </span>
        )}
        {book.magic_system && (
          <span class="text-center">
            <span class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wide block">Magic</span>
            <span class="font-semibold text-zinc-800">{book.magic_system.split(' ')[0]}</span>
          </span>
        )}
      </div>

      <!-- Darkness badge -->
      {darkness && (
        <div class="mt-6">
          <div class={`inline-flex items-center gap-2 sm:gap-4 rounded-2xl border-2 ${darkness.border} ${darkness.bg} px-3 sm:px-5 py-2.5 sm:py-3.5`}>
            <span class="text-2xl leading-none">{darkness.candles}</span>
            <div>
              <div class={`font-bold ${darkness.color}`}>
                Darkness Level {book.darkness_level} — {darkness.label}
              </div>
              <div class="text-xs text-zinc-500 mt-0.5">{darkness.desc}</div>
            </div>
          </div>
        </div>
      )}

      <!-- Heat badge -->
      {heat && (
        <div class="mt-4 inline-flex items-center gap-2 sm:gap-4 rounded-2xl border-2 border-pink-200 bg-pink-50 px-3 sm:px-5 py-2.5 sm:py-3.5">
          <span class="text-2xl leading-none">{heat.flames}</span>
          <div>
            <div class="font-bold text-pink-700">Heat — {heat.label}</div>
            <div class="text-xs text-zinc-500 mt-0.5">{heat.desc}</div>
          </div>
        </div>
      )}

      <!-- ── Audiobook ─────────────────────────────────────────── -->
      {book.audiobook_available && (
        <div class="mt-6 rounded-2xl border border-zinc-200 bg-zinc-50 px-5 py-4 flex flex-wrap items-center gap-4">
          <span class="text-2xl">🎧</span>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-zinc-900 text-sm">Audiobook available</p>
            <p class="text-xs text-zinc-500 mt-0.5">
              {book.audiobook_narrator && <span>Narrated by <span class="font-medium text-zinc-700">{book.audiobook_narrator}</span></span>}
              {book.audiobook_hours && <span class="ml-2">· {book.audiobook_hours}h</span>}
            </p>
          </div>
          {book.audiobook_narrator_rating && (() => {
            const ratingMap = {
              excellent: { label: 'Excellent narrator', color: 'bg-green-100 text-green-800 border-green-200' },
              good:      { label: 'Good narrator',      color: 'bg-blue-100 text-blue-800 border-blue-200' },
              mixed:     { label: 'Mixed reviews',      color: 'bg-yellow-100 text-yellow-800 border-yellow-200' },
              avoid:     { label: 'Poor narrator',      color: 'bg-red-100 text-red-800 border-red-200' },
            };
            const r = ratingMap[book.audiobook_narrator_rating as keyof typeof ratingMap];
            return r ? (
              <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${r.color}`}>{r.label}</span>
            ) : null;
          })()}
          {book.audiobook_audible_url && (
            <a
              href={book.audiobook_audible_url}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-orange-400 hover:bg-orange-500 text-white text-xs font-semibold transition-colors"
            >
              🎧 Listen on Audible
            </a>
          )}
        </div>
      )}

      <!-- ── Synopsis ──────────────────────────────────────────── -->
      {book.synopsis && (
        <div class="mt-6">
          <h2 class="text-lg font-semibold text-zinc-900 mb-3">Synopsis</h2>
          {book.synopsis.length > 350 ? (
            <div id="synopsis-wrap">
              <p class="text-zinc-700 leading-relaxed text-[15px]">
                <span id="syn-short">{book.synopsis.slice(0, 350)}…</span>
                <span id="syn-full" class="hidden">{book.synopsis}</span>
              </p>
              <button id="syn-toggle" class="mt-2 text-sm text-purple-700 hover:text-purple-900 font-medium">Read more</button>
            </div>
          ) : (
            <p class="text-zinc-700 leading-relaxed text-[15px]">{book.synopsis}</p>
          )}
        </div>
      )}

    </div>
  </div>

  <!-- ── Tropes / Tone / Content Warnings ───────────────────── -->
  {(book.tropes?.length || book.tone?.length || book.content_warnings?.length) && (
    <div class="mb-12 flex flex-col sm:flex-row gap-6 sm:gap-8 items-start">
      {book.tropes && book.tropes.length > 0 && (
        <div class="w-full sm:w-1/2 min-w-0">
          <h3 class="text-[11px] font-semibold text-zinc-400 uppercase tracking-widest mb-2">Tropes</h3>
          <div class="flex flex-wrap gap-1.5">
            {book.tropes.map((t) => (
              <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full text-sm">{t}</span>
            ))}
          </div>
        </div>
      )}
      {(book.tone?.length || book.content_warnings?.length) && (
        <div class="w-full sm:w-1/2 min-w-0 flex flex-col gap-4">
          {book.tone && book.tone.length > 0 && (
            <div>
              <h3 class="text-[11px] font-semibold text-zinc-400 uppercase tracking-widest mb-2">Tone</h3>
              <div class="flex flex-wrap gap-1.5">
                {book.tone.map((t) => (
                  <span class="px-3 py-1 bg-zinc-100 text-zinc-700 rounded-full text-sm">{t}</span>
                ))}
              </div>
            </div>
          )}
          {book.content_warnings && book.content_warnings.length > 0 && (
            <div>
              <h3 class="text-[11px] font-semibold text-zinc-400 uppercase tracking-widest mb-2">Content Warnings</h3>
              <div class="relative inline-flex flex-wrap gap-1.5">
                <div id="cw-pills" class="flex flex-wrap gap-1.5 blur-sm select-none transition-[filter] duration-300 pointer-events-none">
                  {book.content_warnings.map((w) => (
                    <span class="px-3 py-1 bg-red-50 text-red-700 border border-red-200 rounded-full text-sm">{w}</span>
                  ))}
                </div>
                <button id="cw-reveal" class="absolute inset-0 flex items-center justify-center text-xs font-semibold text-zinc-500 hover:text-zinc-800 transition-colors">
                  Click to reveal
                </button>
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  )}

  <!-- ── Readers Also Enjoyed ─────────────────────────────────── -->
  {similarBooks.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-xl font-semibold">Readers Also Enjoyed</h2>
        <div class="flex items-center gap-3">
          <span id="rec-label" class="text-sm text-zinc-400"></span>
          <div class="flex gap-2">
            <button id="rec-prev" aria-label="Previous" class="w-8 h-8 rounded-full border border-zinc-200 bg-white flex items-center justify-center text-zinc-500 hover:bg-zinc-100 disabled:opacity-30 disabled:cursor-not-allowed transition-all">←</button>
            <button id="rec-next" aria-label="Next" class="w-8 h-8 rounded-full border border-zinc-200 bg-white flex items-center justify-center text-zinc-500 hover:bg-zinc-100 disabled:opacity-30 disabled:cursor-not-allowed transition-all">→</button>
          </div>
        </div>
      </div>

      <div id="rec-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {similarBooks.map((b, i) => {
          const href = b.slug ? `/books/${b.slug}/` : null;
          const topGenres = (b.subgenres ?? []).slice(0, 2);
          const ratingNum = b.avg_rating;
          const card = (
            <div class="flex items-start gap-3 rounded-xl border border-zinc-200 bg-white p-3 hover:border-purple-300 hover:bg-purple-50/30 hover:shadow-sm transition-all group h-full">
              <div class="shrink-0 w-14 h-20 rounded-lg overflow-hidden bg-zinc-100 border border-zinc-200 shadow-sm group-hover:shadow-md group-hover:scale-[1.03] transition-all">
                {b.cover_url ? (
                  <img src={b.cover_url} alt={b.title} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-zinc-300 text-lg">📖</div>
                )}
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-sm text-zinc-900 group-hover:text-purple-700 transition-colors leading-snug line-clamp-2">{b.title}</p>
                {b.authors?.[0] && <p class="text-xs text-zinc-400 mt-0.5 truncate">{b.authors[0]}</p>}
                {ratingNum != null && (
                  <div class="flex items-center gap-1 mt-1">
                    <span class="relative inline-block text-xs" style="letter-spacing:0.05em;line-height:1">
                      <span style="color:#d4d4d8">★★★★★</span>
                      <span class="absolute inset-0 overflow-hidden whitespace-nowrap" style={`width:${(ratingNum/5*100).toFixed(1)}%;color:#f59e0b`}>★★★★★</span>
                    </span>
                    <span class="text-xs text-zinc-500">{ratingNum.toFixed(2)}</span>
                  </div>
                )}
                {topGenres.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-1.5">
                    {topGenres.map((g) => <span class="text-[10px] bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded">{g}</span>)}
                  </div>
                )}
              </div>
            </div>
          );
          return href
            ? <a href={href} class="block rec-item" data-rec-index={i}>{card}</a>
            : <div class="rec-item" data-rec-index={i}>{card}</div>;
        })}
      </div>
    </section>
  )}

  <!-- ── Editorial sections ───────────────────────────────────── -->
  {(book.unique_angle || book.ideal_reader || book.reading_experience) && (
    <div class="flex flex-col gap-5 mb-12">

      {(book.reading_experience || book.tone?.length || book.pacing) && (
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-lg">📖</span>
            <h3 class="text-xs font-semibold text-amber-600 uppercase tracking-widest">Tone &amp; reading experience</h3>
          </div>
          {book.reading_experience && (
            <p class="text-sm text-zinc-700 leading-relaxed mb-2">{book.reading_experience}</p>
          )}
          {(book.tone?.length || book.pacing) && (
            <div class="flex flex-wrap gap-1.5 mt-1">
              {book.pacing && (
                <span class="text-xs bg-amber-100 text-amber-800 border border-amber-200 px-2.5 py-1 rounded-full">{book.pacing}</span>
              )}
              {book.tone?.map((t) => (
                <span class="text-xs bg-white text-zinc-600 border border-amber-200 px-2.5 py-1 rounded-full">{t}</span>
              ))}
            </div>
          )}
        </div>
      )}

      {book.unique_angle && (
        <div class="rounded-2xl border border-violet-200 bg-violet-50 px-5 py-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-lg">✨</span>
            <h3 class="text-xs font-semibold text-violet-500 uppercase tracking-widest">What makes this different</h3>
          </div>
          <p class="text-sm text-zinc-700 leading-relaxed">{book.unique_angle}</p>
        </div>
      )}

      {book.ideal_reader && (
        <div class="rounded-2xl border border-sky-200 bg-sky-50 px-5 py-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-lg">🎯</span>
            <h3 class="text-xs font-semibold text-sky-500 uppercase tracking-widest">Who is this for</h3>
          </div>
          <p class="text-sm text-zinc-700 leading-relaxed">{book.ideal_reader}</p>
        </div>
      )}

    </div>
  )}

  <!-- ── FAQ ──────────────────────────────────────────────────── -->
  {book.faqs && book.faqs.length > 0 && (
    <BookFAQ faqs={book.faqs} bookTitle={book.title} />
  )}

  <!-- ── Community Tags (hidden) ──────────────────────────────── -->
  {false && <CommunityTags client:load bookId={book.id} bookSlug={slug} initialTags={approvedTags} userEmail={userEmail} />}


</Layout>

<script>
  const PER_PAGE = 4;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.rec-item'));
  const prev  = document.getElementById('rec-prev')  as HTMLButtonElement | null;
  const next  = document.getElementById('rec-next')  as HTMLButtonElement | null;
  const label = document.getElementById('rec-label');
  if (items.length && prev && next) {
    let page = 0;
    const totalPages = Math.ceil(items.length / PER_PAGE);
    const grid = document.getElementById('rec-grid') as HTMLElement;
    if (grid) grid.style.transition = 'opacity 0.18s ease';

    const render = (animate = false) => {
      const apply = () => {
        items.forEach((el, i) => {
          el.style.display = (i >= page * PER_PAGE && i < (page + 1) * PER_PAGE) ? '' : 'none';
        });
        prev.disabled = page === 0;
        next.disabled = page >= totalPages - 1;
        if (label) label.textContent = totalPages > 1 ? `${page + 1} / ${totalPages}` : '';
        if (grid && animate) { grid.style.opacity = '0'; requestAnimationFrame(() => requestAnimationFrame(() => { grid.style.opacity = '1'; })); }
      };
      if (grid && animate) {
        grid.style.opacity = '0';
        setTimeout(apply, 180);
      } else {
        apply();
      }
    };
    prev.addEventListener('click', () => { page--; render(true); });
    next.addEventListener('click', () => { page++; render(true); });
    render(false);
  }

  // More stores dropdown
  const storesToggle  = document.getElementById('stores-toggle');
  const storesMenu    = document.getElementById('stores-menu');
  const storesChevron = document.getElementById('stores-chevron');
  if (storesToggle && storesMenu) {
    storesToggle.addEventListener('click', () => {
      const open = !storesMenu.classList.contains('hidden');
      storesMenu.classList.toggle('hidden', open);
      if (storesChevron) storesChevron.style.transform = open ? '' : 'rotate(180deg)';
    });
    document.addEventListener('click', (e) => {
      if (!storesToggle.contains(e.target as Node) && !storesMenu.contains(e.target as Node)) {
        storesMenu.classList.add('hidden');
        if (storesChevron) storesChevron.style.transform = '';
      }
    });
  }

  // Content warnings blur reveal
  const cwReveal = document.getElementById('cw-reveal');
  const cwPills  = document.getElementById('cw-pills');
  if (cwReveal && cwPills) {
    cwReveal.addEventListener('click', () => {
      cwPills.classList.remove('blur-sm', 'select-none', 'pointer-events-none');
      cwReveal.remove();
    });
  }

  // Main book synopsis read more / read less toggle
  const synToggle = document.getElementById('syn-toggle') as HTMLButtonElement | null;
  const synShort  = document.getElementById('syn-short')  as HTMLElement | null;
  const synFull   = document.getElementById('syn-full')   as HTMLElement | null;
  if (synToggle && synShort && synFull) {
    synToggle.addEventListener('click', () => {
      const isExpanded = !synFull.classList.contains('hidden');
      synShort.classList.toggle('hidden', !isExpanded);
      synFull.classList.toggle('hidden', isExpanded);
      synToggle.textContent = isExpanded ? 'Read more' : 'Read less';
    });
  }
</script>
