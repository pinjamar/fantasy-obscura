---
import Layout from '../../components/Layout.astro';
import BookHub from '../../components/BookHub';
---

<Layout title="Book Database | Fantasy Obscura" description="Search and store books from multiple APIs.">
  <h1 class="text-3xl font-semibold tracking-tight">Book database</h1>
  <p class="mt-2 max-w-2xl text-zinc-700">
    Pull titles from Open Library, Google Books, Harvard GraphQL, or Bigbook — then save or add manual entries.
  </p>

  <div class="mt-8">
    <BookHub client:load />
  </div>
</Layout>
