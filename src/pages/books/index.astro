---
import Layout from '../../components/Layout.astro';
import BookDisplay from '../../components/BookDisplay';
---

<Layout title="All Fantasy Books | The Grimoire" description="Browse our fantasy book database — filter by darkness level, tropes, subgenre, magic system, pacing, and more. Find your next read with confidence.">

  <!-- Banner -->
  <div class="relative rounded-2xl overflow-hidden mb-8 border border-zinc-200">
    <picture>
      <source type="image/avif" srcset="/images/banners/all-books-400.avif 400w, /images/banners/all-books-800.avif 800w" sizes="(min-width: 1024px) 800px, 100vw" />
      <source type="image/webp" srcset="/images/banners/all-books-400.webp 400w, /images/banners/all-books-800.webp 800w" sizes="(min-width: 1024px) 800px, 100vw" />
      <img src="/images/banners/all-books-800.webp" alt="" width="800" height="400" loading="eager" decoding="async" class="w-full aspect-2/1 sm:aspect-3/1 object-cover" />
    </picture>
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/50 to-black/10" />
    <div class="absolute inset-0 px-6 py-6 flex flex-col justify-end">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-semibold tracking-tight text-white">All Fantasy Books</h1>
          <p class="hidden sm:block mt-2 max-w-2xl text-white/80 text-sm leading-relaxed">
            Browse our hand-curated database of fantasy books - from <strong class="text-white">epic high fantasy</strong> and <strong class="text-white">grimdark</strong> to <strong class="text-white">romantasy</strong> and <strong class="text-white">cozy reads</strong>. Every entry includes a darkness rating, heat level, tropes and content warnings so you know exactly what you're picking up. You can also filter by Adult/YA or by M/F protagonist.
          </p>
        </div>
        <select
          onchange="if(this.value) window.location.href=this.value"
          class="text-sm rounded-lg px-3 py-1.5 bg-white/10 backdrop-blur-sm border border-white/30 text-white placeholder-white/60 hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/50 cursor-pointer transition"
        >
          <option value="" class="text-zinc-800 bg-white">Browse by category…</option>
          <option value="/fantasy/epic/" class="text-zinc-800 bg-white">Epic & High Fantasy</option>
          <option value="/fantasy/romantasy/" class="text-zinc-800 bg-white">Romantasy</option>
          <option value="/fantasy/litrpg/" class="text-zinc-800 bg-white">LitRPG / Progression Fantasy</option>
          <option value="/fantasy/dark/" class="text-zinc-800 bg-white">Dark Fantasy</option>
          <option value="/fantasy/urban/" class="text-zinc-800 bg-white">Urban / Contemporary Fantasy</option>
          <option value="/fantasy/grimdark/" class="text-zinc-800 bg-white">Grimdark</option>
          <option value="/fantasy/historical/" class="text-zinc-800 bg-white">Historical Fantasy</option>
          <option value="/fantasy/academia/" class="text-zinc-800 bg-white">Academia Fantasy</option>
          <option value="/fantasy/mythology/" class="text-zinc-800 bg-white">Mythic & Folklore Fantasy</option>
          <option value="/fantasy/swords/" class="text-zinc-800 bg-white">Sword & Sorcery</option>
          <option value="/fantasy/cozy/" class="text-zinc-800 bg-white">Cozy Fantasy</option>
          <option value="/fantasy/science-fantasy/" class="text-zinc-800 bg-white">Science Fantasy</option>
        </select>
      </div>
    </div>
  </div>

  <BookDisplay
    client:load
    featuredTropes={[
      'Chosen One', 'Found Family', 'Enemies to Lovers', 'Slow Burn',
      'Anti-Hero', 'Political Intrigue', 'Quest', 'Fated Mates',
      'Morally Grey Hero', 'Revenge Story', 'Coming of Age', 'Prophecy',
      'Betrayal', 'Forbidden Romance', 'Ancient Evil Awakens',
    ]}
  />

</Layout>
