---
import Layout from '../../components/Layout.astro';
import CategoryGrid from '../../components/CategoryGrid';
import BookSearch from '../../components/BookSearch';
---

<Layout title="Start Here | Fantasy Obscura" description="Fantasy & sci-fi reading orders, lists, and guides.">
  <h1 class="text-3xl font-semibold tracking-tight">
    Fantasy & Sci-Fi guides that get to the point.
  </h1>

  <p class="mt-4 max-w-2xl text-zinc-700">
    Select a genre to filter new releases, trending reads, on-sale picks, and upcoming titles — or search any book and browse our full collection.
  </p>

  <BookSearch client:load />

  <CategoryGrid client:load />
</Layout>
