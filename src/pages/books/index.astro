---
import Layout from '../../components/Layout.astro';
import BookDisplay from '../../components/BookDisplay';
import { getBooks } from '../../lib/db/books';

const user = Astro.locals.user;

const BATCH = 1000;
let allBooks: unknown[] = [];
let page = 1;
let totalCount = 0;
while (true) {
  const result = await getBooks({}, { page, pageSize: BATCH, sort: 'rating_desc' });
  if (page === 1) totalCount = result.count;
  allBooks = allBooks.concat(result.data);
  if (allBooks.length >= totalCount || result.data.length < BATCH) break;
  page++;
}
---

<Layout title="All Books | Fantasy Obscura" description="Browse the complete Fantasy Obscura book collection.">

  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">All Books</h1>
      <p class="text-zinc-500 text-sm mt-1">The complete collection</p>
    </div>
    <select
      onchange="if(this.value) window.location.href=this.value"
      class="text-sm border border-zinc-200 rounded-lg px-3 py-1.5 bg-white text-zinc-600 hover:border-zinc-300 focus:outline-none focus:ring-2 focus:ring-purple-500 cursor-pointer"
    >
      <option value="">Browse by category…</option>
      <option value="/categories/epic/">Epic & High Fantasy</option>
      <option value="/categories/romantasy/">Romantasy</option>
      <option value="/categories/litrpg/">LitRPG / Progression Fantasy</option>
      <option value="/categories/dark/">Dark Fantasy</option>
      <option value="/categories/urban/">Urban / Contemporary Fantasy</option>
      <option value="/categories/grimdark/">Grimdark</option>
      <option value="/categories/historical/">Historical Fantasy</option>
      <option value="/categories/academy/">Academy Fantasy</option>
      <option value="/categories/mythology/">Mythic & Folklore Fantasy</option>
      <option value="/categories/swords/">Sword & Sorcery</option>
      <option value="/categories/cozy/">Cozy Fantasy</option>
      <option value="/categories/science-fantasy/">Science Fantasy</option>
    </select>
  </div>

  <BookDisplay client:load initialBooks={allBooks as any} />

</Layout>
