---
import Layout from '../../components/Layout.astro';
---

<Layout
	title="Beginner Lists | Fantasy Obscura"
	description="Simple starter lists for new fantasy and sci‑fi readers."
>
	<h1 class="text-3xl font-semibold tracking-tight">Beginner Lists</h1>
	<p class="mt-4 max-w-2xl text-zinc-700">
		A quick set of mock lists to help you start reading.
	</p>

	<section class="mt-8">
		<h2 class="text-xl font-semibold">Fantasy Starters</h2>
		<ul class="mt-4 list-disc pl-5 space-y-2 text-zinc-700">
			<li>Mistborn — Brandon Sanderson</li>
			<li>The Hobbit — J.R.R. Tolkien</li>
			<li>A Wizard of Earthsea — Ursula K. Le Guin</li>
		</ul>
	</section>

	<section class="mt-8">
		<h2 class="text-xl font-semibold">Sci‑Fi Starters</h2>
		<ul class="mt-4 list-disc pl-5 space-y-2 text-zinc-700">
			<li>The Martian — Andy Weir</li>
			<li>All Systems Red — Martha Wells</li>
			<li>Ender’s Game — Orson Scott Card</li>
		</ul>
	</section>
</Layout>
