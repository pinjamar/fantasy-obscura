---
import Layout from '../../components/Layout.astro';
---

<Layout
  title="Magic Systems | Fantasy Obscura"
  description="A quick overview of magic system types."
>
  <h1 class="text-3xl font-semibold tracking-tight">Magic Systems</h1>
  <p class="mt-4 max-w-2xl text-zinc-700">
    Mockup content for now. Add real articles later.
  </p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border p-4">
      <div class="font-medium">Hard Magic</div>
      <p class="text-sm text-zinc-600 mt-2">Clear rules, strict limits.</p>
    </div>
    <div class="rounded-xl border p-4">
      <div class="font-medium">Soft Magic</div>
      <p class="text-sm text-zinc-600 mt-2">Mysterious and flexible.</p>
    </div>
  </div>
</Layout>
