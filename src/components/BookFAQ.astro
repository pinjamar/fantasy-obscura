---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  bookTitle: string;
}

const { faqs, bookTitle } = Astro.props;
---

<section class="mb-12">
  <div class="flex items-center gap-1.5 mb-2">
    <span class="text-base">❓</span>
    <h2 class="text-xs font-semibold text-emerald-600 uppercase tracking-widest">FAQ</h2>
  </div>
  <div class="rounded-xl border border-emerald-200 bg-emerald-50 divide-y divide-emerald-100 overflow-hidden">
    {faqs.map((faq) => (
      <details class="group px-4">
        <summary class="flex items-center justify-between gap-3 py-2.5 cursor-pointer list-none text-xs font-medium text-zinc-800 hover:text-zinc-900 transition-colors">
          <span>{faq.question}</span>
          <span class="shrink-0 text-emerald-400 font-light group-open:hidden">+</span>
          <span class="shrink-0 text-emerald-400 font-light hidden group-open:block">−</span>
        </summary>
        <p class="pb-3 text-xs text-zinc-600 leading-relaxed">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
})} />
