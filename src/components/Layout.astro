---
import '../styles.css';
const {
  title = "Fantasy Obscura",
  description = "Curated fantasy book guides with darkness ratings, trope tags, and honest reading context.",
  image,
  ogType = "website",
} = Astro.props;
const user = Astro.locals.user;
const userProfile = Astro.locals.userProfile;
const displayName = userProfile?.display_name || '';
const avatarInitials = (displayName || user?.email || '').slice(0, 2).toUpperCase();

const SITE = 'https://fantasy-obscura.pages.dev';
const canonicalUrl = new URL(Astro.url.pathname, SITE).toString();
const ogImage = image || `${SITE}/og-default.png`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Fantasy Obscura" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="min-h-screen bg-white text-zinc-900">
    <header class="border-b">
      <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between gap-6">
        <a href="/" class="font-semibold tracking-tight shrink-0 hover:text-purple-700 transition-colors">Fantasy Obscura</a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex flex-1 gap-4 text-sm text-zinc-700">
          <a class="hover:underline" href="/books/">📖 Start Here</a>
          <a class="hover:underline" href="/craft/">🔮 Find My Next Book</a>
          <a class="hover:underline" href="/tropes/">🌀 Tropes</a>
          <a class="hover:underline" href="/books-like/">📚 Books like...</a>
          <a class="hover:underline" href="/reading-orders/">🧭 Reading Orders</a>
          <a class="hover:underline" href="/authors/">✍️ Authors</a>
        </nav>

        <div class="flex items-center gap-3 shrink-0 text-sm">
          <!-- Auth -->
          {user ? (
            <div class="flex items-center gap-3">
              <a href="/my-list/" class="flex items-center gap-2 group" title={displayName || user?.email}>
                {userProfile?.avatar_url ? (
                  <img src={userProfile.avatar_url} alt={displayName} class="w-7 h-7 rounded-full object-cover ring-2 ring-white shadow-sm" />
                ) : (
                  <div class="w-7 h-7 rounded-full bg-purple-600 flex items-center justify-center text-white text-[10px] font-bold shadow-sm">
                    {avatarInitials}
                  </div>
                )}
                {displayName && (
                  <span class="text-xs text-zinc-600 group-hover:text-zinc-900 transition-colors hidden sm:block">{displayName}</span>
                )}
              </a>
              <form method="POST" action="/api/auth/logout">
                <button type="submit" class="text-zinc-400 hover:text-zinc-900 transition-colors text-xs hidden sm:block">Log out</button>
              </form>
            </div>
          ) : (
            <div class="flex items-center gap-2">
              <a href="/auth/login" class="px-3 py-1.5 rounded-full border border-zinc-300 text-zinc-700 text-xs font-semibold hover:bg-zinc-50 transition-colors">Log in</a>
              <a href="/auth/register" class="hidden sm:block px-3 py-1.5 rounded-full bg-purple-600 text-white text-xs font-semibold hover:bg-purple-700 transition-colors">Sign up</a>
            </div>
          )}

          <!-- Burger button (mobile only) -->
          <button id="burger" class="md:hidden flex flex-col justify-center gap-1.5 w-8 h-8 items-center" aria-label="Menu">
            <span class="block w-5 h-0.5 bg-zinc-700 transition-all"></span>
            <span class="block w-5 h-0.5 bg-zinc-700 transition-all"></span>
            <span class="block w-5 h-0.5 bg-zinc-700 transition-all"></span>
          </button>
        </div>
      </div>

      <!-- Mobile nav drawer -->
      <div id="mobile-nav" class="hidden md:hidden border-t bg-white">
        <nav class="mx-auto max-w-5xl px-4 py-3 flex flex-col gap-0.5 text-sm text-zinc-700">
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/books/">📖 Start Here</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/craft/">🔮 Find My Next Book</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/tropes/">🌀 Tropes</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/books-like/">📚 Books like...</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/reading-orders/">🧭 Reading Orders</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/authors/">✍️ Authors</a>
          {user ? (
            <div class="mt-2 pt-2 border-t border-zinc-100 flex items-center justify-between px-3 py-2">
              <span class="text-xs text-zinc-500">{displayName || user?.email}</span>
              <form method="POST" action="/api/auth/logout">
                <button type="submit" class="text-xs text-red-500 hover:text-red-700">Log out</button>
              </form>
            </div>
          ) : (
            <div class="mt-2 pt-2 border-t border-zinc-100 flex gap-2 px-3 py-2">
              <a href="/auth/login" class="flex-1 text-center px-3 py-2 rounded-lg border border-zinc-300 text-zinc-700 text-xs font-semibold hover:bg-zinc-50 transition-colors">Log in</a>
              <a href="/auth/register" class="flex-1 text-center px-3 py-2 rounded-lg bg-purple-600 text-white text-xs font-semibold hover:bg-purple-700 transition-colors">Sign up</a>
            </div>
          )}
        </nav>
      </div>
    </header>

    <script>
      const burger = document.getElementById('burger');
      const mobileNav = document.getElementById('mobile-nav');
      burger?.addEventListener('click', () => {
        mobileNav?.classList.toggle('hidden');
      });
    </script>

    <main class="mx-auto max-w-5xl px-4 py-8 sm:py-10">
      <slot />
    </main>

    <footer class="border-t bg-zinc-50">
      <div class="mx-auto max-w-5xl px-4 py-10">
        <div class="grid gap-8 sm:grid-cols-3 text-sm">

          <div>
            <p class="font-semibold text-zinc-900 mb-2">Fantasy Obscura</p>
            <p class="text-zinc-500 text-xs leading-relaxed">
              Curated fantasy & sci-fi guides built for readers who care about what they're getting into. Every book comes with a darkness rating, trope tags, and honest context — so you can pick your next read with confidence.
            </p>
          </div>

          <div>
            <p class="font-semibold text-zinc-700 mb-2 text-xs uppercase tracking-widest">Reading Orders</p>
            <ul class="space-y-1.5 text-zinc-500">
              <li><a href="/reading-orders/cosmere/" class="hover:text-zinc-900 transition-colors">Sanderson's Cosmere</a></li>
              <li><a href="/reading-orders/first-law/" class="hover:text-zinc-900 transition-colors">The First Law</a></li>
              <li><a href="/reading-orders/acotar/" class="hover:text-zinc-900 transition-colors">A Court of Thorns & Roses</a></li>
              <li><a href="/reading-orders/" class="text-purple-600 hover:text-purple-800 transition-colors">All reading orders →</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-zinc-700 mb-2 text-xs uppercase tracking-widest">Discover</p>
            <ul class="space-y-1.5 text-zinc-500">
              <li><a href="/craft/" class="hover:text-zinc-900 transition-colors">🔮 Find My Next Book</a></li>
              <li><a href="/books-like/" class="hover:text-zinc-900 transition-colors">📚 Books Like…</a></li>
              <li><a href="/tropes/" class="hover:text-zinc-900 transition-colors">🌀 Browse by Trope</a></li>
              <li><a href="/books/" class="text-purple-600 hover:text-purple-800 transition-colors">All Books →</a></li>
            </ul>
          </div>

        </div>
        <div class="mt-8 pt-6 border-t text-xs text-zinc-400">
          © {new Date().getFullYear()} Fantasy Obscura
        </div>
      </div>
    </footer>
  </body>
</html>
