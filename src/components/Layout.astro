---
import '../styles.css';
import BookmarkCount from './BookmarkCount';
const { title = "Fantasy Obscura", description = "Fantasy & sci-fi book guides." } = Astro.props;
const user = Astro.locals.user;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-white text-zinc-900">
    <header class="border-b">
      <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between gap-6">
        <span class="font-semibold tracking-tight shrink-0">Fantasy Obscura</span>
        <nav class="flex gap-4 text-sm text-zinc-700 flex-wrap">
          <a class="hover:underline" href="/books/">📖 Start Here</a>
          <a class="hover:underline" href="/craft/">🔮 Find My Next Book</a>
          <a class="hover:underline" href="/books-like/">📚 Books like...</a>
          <a class="hover:underline" href="/reading-orders/">🧭 Reading orders</a>
          <a class="hover:underline" href="/authors/">✍️ Authors</a>
          <a class="hover:underline inline-flex items-center gap-1" href="/my-list/">🔖 My Bookshelf<BookmarkCount client:load /></a>
        </nav>
        <div class="shrink-0 text-sm">
          {user ? (
            <div class="flex items-center gap-3">
              <span class="text-lg" title={user.email}>👤</span>
              <form method="POST" action="/api/auth/logout">
                <button type="submit" class="text-zinc-500 hover:text-zinc-900 transition-colors text-xs">Sign out</button>
              </form>
            </div>
          ) : (
            <div class="flex items-center gap-2">
              <a href="/auth/login" class="px-3 py-1.5 rounded-full border border-zinc-300 text-zinc-700 text-xs font-semibold hover:bg-zinc-50 transition-colors">
                Sign in
              </a>
              <a href="/auth/register" class="px-3 py-1.5 rounded-full bg-purple-600 text-white text-xs font-semibold hover:bg-purple-700 transition-colors">
                Sign up
              </a>
            </div>
          )}
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>

    <footer class="border-t">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-zinc-600">
        © {new Date().getFullYear()} Fantasy Obscura
      </div>
    </footer>
  </body>
</html>
