---
import '../styles.css';
const {
  title = "The Grimoire",
  description = "Curated fantasy book guides with darkness ratings, trope tags, and honest reading context.",
  image,
  ogType = "website",
  noindex = false,
} = Astro.props;
const user = Astro.locals.user;
const userProfile = Astro.locals.userProfile;
const displayName = userProfile?.display_name || '';
const avatarInitials = (displayName || user?.email || '').slice(0, 2).toUpperCase();

const SITE = 'https://thegrimoire.co';
const canonicalUrl = new URL(Astro.url.pathname, SITE).toString();
const ogImage = image || `${SITE}/og-default.png`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="1024x1024" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="The Grimoire" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LJJ4D2V54L" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LJJ4D2V54L');
    </script>
    <slot name="head" />
    <script is:inline type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "The Grimoire",
      "url": "https://thegrimoire.co",
      "description": "Fantasy book guides with darkness ratings, trope tags, and reading orders.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "https://thegrimoire.co/craft/?q={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    })}</script>
  </head>

  <body class="min-h-screen bg-white text-zinc-900">
    <header class="border-b sticky top-0 z-50 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-3 flex items-center gap-4">
        <a href="/" class="flex items-center gap-2 shrink-0 group">
          <img
            src="/nav-logo.png"
            alt="The Grimoire"
            width="115"
            height="80"
            class="h-7 w-auto"
            loading="eager"
          />
          <span class="font-semibold tracking-tight text-zinc-900 group-hover:text-purple-700 transition-colors">The Grimoire</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex flex-1 justify-center gap-3 text-sm text-zinc-700">
          <a class="hover:underline whitespace-nowrap" href="/books/">📖 Start Here</a>
          <a class="hover:underline whitespace-nowrap" href="/book-finder/">🔮 My Next Read</a>
          <a class="hover:underline whitespace-nowrap" href="/tropes/">🌀 Tropes</a>
          <a class="hover:underline whitespace-nowrap" href="/books-like/">📚 Books like...</a>
          <a class="hover:underline whitespace-nowrap" href="/reading-orders/">🧭 Reading Orders</a>
          <a class="hover:underline whitespace-nowrap" href="/authors/">✍️ Authors</a>
        </nav>

        <div class="flex items-center gap-3 shrink-0 text-sm ml-auto">
          <!-- Burger button (mobile only) -->
          <button id="burger" class="md:hidden p-1" aria-label="Menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3f3f46" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>

          <!-- Auth -->
          {user ? (
            <div class="flex items-center gap-3">
              <a href="/my-list/" class="flex items-center gap-2 group" title={displayName || user?.email}>
                {userProfile?.avatar_url ? (
                  <img src={userProfile.avatar_url} alt={displayName} class="w-7 h-7 rounded-full object-cover ring-2 ring-white shadow-sm" />
                ) : (
                  <div class="w-7 h-7 rounded-full bg-purple-600 flex items-center justify-center text-white text-[10px] font-bold shadow-sm">
                    {avatarInitials}
                  </div>
                )}
                {displayName && (
                  <span class="text-xs text-zinc-600 group-hover:text-zinc-900 transition-colors hidden sm:block">{displayName}</span>
                )}
              </a>
              <form method="POST" action="/api/auth/logout">
                <button type="submit" class="text-zinc-400 hover:text-zinc-900 transition-colors text-xs hidden sm:block">Log out</button>
              </form>
            </div>
          ) : (
            <div class="flex items-center gap-2">
              <a href="/auth/login" class="px-3 py-1.5 rounded-full border border-zinc-300 text-zinc-700 text-xs font-semibold hover:bg-zinc-50 transition-colors">Log in</a>
              <a href="/auth/register" class="hidden sm:block px-3 py-1.5 rounded-full bg-purple-600 text-white text-xs font-semibold hover:bg-purple-700 transition-colors">Sign up</a>
            </div>
          )}
        </div>
      </div>

      <!-- Mobile nav drawer -->
      <div id="mobile-nav" class="hidden md:hidden border-t bg-white">
        <nav class="mx-auto max-w-5xl px-4 py-3 flex flex-col gap-0.5 text-sm text-zinc-700">
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/books/" aria-label="Start Here — All Fantasy Books">📖 Start Here</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/book-finder/" aria-label="Find My Next Fantasy Book">🔮 Find My Next Book</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/tropes/" aria-label="Browse Fantasy Tropes">🌀 Tropes</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/books-like/" aria-label="Books Like... Fantasy Recommendations">📚 Books like...</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/reading-orders/" aria-label="Fantasy Series Reading Orders">🧭 Reading Orders</a>
          <a class="px-3 py-2.5 rounded-lg hover:bg-zinc-100 transition-colors" href="/authors/" aria-label="Browse Fantasy Authors">✍️ Authors</a>
          {user ? (
            <div class="mt-2 pt-2 border-t border-zinc-100 flex items-center justify-between px-3 py-2">
              <span class="text-xs text-zinc-500">{displayName || user?.email}</span>
              <form method="POST" action="/api/auth/logout">
                <button type="submit" class="text-xs text-red-500 hover:text-red-700">Log out</button>
              </form>
            </div>
          ) : (
            <div class="mt-2 pt-2 border-t border-zinc-100 flex gap-2 px-3 py-2">
              <a href="/auth/login" class="flex-1 text-center px-3 py-2 rounded-lg border border-zinc-300 text-zinc-700 text-xs font-semibold hover:bg-zinc-50 transition-colors">Log in</a>
              <a href="/auth/register" class="flex-1 text-center px-3 py-2 rounded-lg bg-purple-600 text-white text-xs font-semibold hover:bg-purple-700 transition-colors">Sign up</a>
            </div>
          )}
        </nav>
      </div>
    </header>

    <script>
      const burger = document.getElementById('burger');
      const mobileNav = document.getElementById('mobile-nav');
      burger?.addEventListener('click', () => {
        mobileNav?.classList.toggle('hidden');
      });
    </script>

    <main class="mx-auto max-w-5xl px-4 py-8 sm:py-10">
      <slot />
    </main>

    <footer class="border-t bg-zinc-50">
      <div class="mx-auto max-w-5xl px-4 py-10">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 text-sm">

          <div class="col-span-2 sm:col-span-1">
            <a href="/" class="flex items-center gap-2 mb-3 group w-fit">
              <img src="/nav-logo.png" alt="The Grimoire" width="115" height="80" class="h-6 w-auto" loading="lazy" />
              <span class="font-semibold text-zinc-900 group-hover:text-purple-700 transition-colors">The Grimoire</span>
            </a>
            <p class="text-zinc-500 text-xs leading-relaxed">
              Curated fantasy guides built for readers who care about what they're getting into. Every book comes with a darkness rating, trope tags and honest context - so you can pick your next read with confidence.
            </p>
          </div>

          <div>
            <p class="font-semibold text-zinc-700 mb-2 text-xs uppercase tracking-widest">Reading Orders</p>
            <ul class="space-y-1.5 text-zinc-500">
              <li><a href="/reading-orders/cosmere/" class="hover:text-zinc-900 transition-colors">Sanderson's Cosmere</a></li>
              <li><a href="/reading-orders/first-law/" class="hover:text-zinc-900 transition-colors">The First Law</a></li>
              <li><a href="/reading-orders/acotar/" class="hover:text-zinc-900 transition-colors">A Court of Thorns & Roses</a></li>
              <li><a href="/reading-orders/" class="text-purple-600 hover:text-purple-800 transition-colors">All reading orders →</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-zinc-700 mb-2 text-xs uppercase tracking-widest">Discover</p>
            <ul class="space-y-1.5 text-zinc-500">
              <li><a href="/book-finder/" class="hover:text-zinc-900 transition-colors">Fantasy Book Finder</a></li>
              <li><a href="/books-like/" class="hover:text-zinc-900 transition-colors">Similar Book Recommendations</a></li>
              <li><a href="/tropes/" class="hover:text-zinc-900 transition-colors">Fantasy Tropes Index</a></li>
              <li><a href="/books/" class="text-purple-600 hover:text-purple-800 transition-colors">All Fantasy Books →</a></li>
            </ul>
          </div>

        </div>
        <div class="mt-8 pt-6 border-t text-xs text-zinc-400 flex items-start gap-4">
          <p>The Grimoire is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com.</p>
          <span class="shrink-0 ml-auto">© {new Date().getFullYear()} The Grimoire</span>
        </div>
      </div>
    </footer>
  </body>
</html>
